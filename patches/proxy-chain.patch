+                    .unwrap(),
+                serde_json::to_value(&original).unwrap()
+            );
+
+            entry.password = "synthetic-rotated".into();
+            let rotated = crate::space::proxy::upsert_for_binding(
+                Door("proxy_save"),
+                &tk,
+                entry,
+                Some(&separate.id),
+            )
+            .await
+            .unwrap();
+            assert_eq!(
+                rotated.id, separate.id,
