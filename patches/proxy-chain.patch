+    assert_eq!(
+        &*endpoint.requests.lock().unwrap(),
+        &["AUTHENTICATION_MISMATCH"]
+    );
+    assert!(
+        first.requests.lock().unwrap().is_empty(),
+        "an explicit single proxy must never try the global first hop"
+    );
