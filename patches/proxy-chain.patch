+//! Synthetic loopback services only. None of these tests reads settings,
+//! credentials, the system proxy configuration or the user's profiles.
+
+use super::connector::{self, ProxyHop, ProxyKind, Target};
+use super::tunnel::Tunnel;
+use std::future::Future;
+use std::net::SocketAddr;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::{TcpListener, TcpStream};
+use tokio::task::{JoinHandle, JoinSet};
+
+const SHORT: Duration = Duration::from_secs(3);
+
+async fn within<T>(future: impl Future<Output = T>) -> T {
+    tokio::time::timeout(SHORT, future)
+        .await
+        .expect("loopback test deadline")
+}
+
+fn hop(addr: SocketAddr, kind: ProxyKind) -> ProxyHop {
+    ProxyHop {
+        kind,
+        host: addr.ip().to_string(),
+        port: addr.port(),
+        username: String::new(),
+        password: String::new(),
+    }
+}
+
+fn target() -> Target {
+    Target::new("remote-proxy.invalid", 1080).unwrap()
+}
+
+#[cfg(windows)]
+#[tokio::test]
+async fn windows_tcp_listener_accepted_and_outbound_sockets_are_not_inheritable() {
+    use std::os::windows::io::AsRawSocket;
+    use windows_sys::Win32::Foundation::{GetHandleInformation, HANDLE_FLAG_INHERIT};
+
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let (accepted, outbound) = within(async {
+        tokio::join!(
+            listener.accept(),
+            TcpStream::connect(listener.local_addr().unwrap())
+        )
+    })
+    .await;
+    let (accepted, _) = accepted.unwrap();
+    let outbound = outbound.unwrap();
+    for (kind, socket) in [
+        ("listener", listener.as_raw_socket()),
+        ("accepted", accepted.as_raw_socket()),
+        ("outbound", outbound.as_raw_socket()),
+    ] {
+        let mut flags = 0;
+        assert_ne!(
+            unsafe { GetHandleInformation(socket as _, &mut flags) },
+            0,
+            "read {kind} socket handle flags: {}",
+            std::io::Error::last_os_error()
+        );
+        assert_eq!(
+            flags & HANDLE_FLAG_INHERIT,
+            0,
+            "the Engine must not inherit the {kind} socket; keep Mio's Windows socket fix"
+        );
+    }
+}
+
+/// Query the kernel table, not the tunnel's own completion bookkeeping.
+/// The original address and PID exclude unrelated listeners in parallel tests.
+#[cfg(windows)]
+fn windows_listener_owned(addr: SocketAddr, pid: u32) -> bool {
+    #[link(name = "iphlpapi")]
+    extern "system" {
+        fn GetExtendedTcpTable(
+            table: *mut std::ffi::c_void,
+            size: *mut u32,
+            order: i32,
+            family: u32,
+            class: i32,
+            reserved: u32,
+        ) -> u32;
+    }
+    let mut size = 0;
+    let mut table = Vec::<u32>::new();
+    // AF_INET, TCP_TABLE_OWNER_PID_LISTENER. A parallel listener can grow the
+    // table between size/read; retry only this bounded local table read.
+    for _ in 0..3 {
+        let result = unsafe {
+            GetExtendedTcpTable(
+                if table.is_empty() {
+                    std::ptr::null_mut()
+                } else {
+                    table.as_mut_ptr().cast()
+                },
+                &mut size,
+                0,
+                2,
+                3,
+                0,
+            )
+        };
+        if result == 122 {
+            table.resize((size as usize + 3) / 4, 0);
+            continue;
+        }
+        assert_eq!(result, 0, "read the Windows listener table");
+        assert!(!table.is_empty() && table[0] as usize <= (table.len() - 1) / 6);
+        return table[1..]
+            .chunks_exact(6)
+            .take(table[0] as usize)
+            .any(|row| {
+                row[0] == 2
+                    && std::net::IpAddr::V4(std::net::Ipv4Addr::from(row[1].to_ne_bytes()))
+                        == addr.ip()
+                    && u16::from_be(row[2] as u16) == addr.port()
+                    && row[5] == pid
+            });
+    }
+    panic!("Windows listener table kept changing during the bounded read");
+}
