+            Box::pin(async move {
+                assert!(self.live.lock().unwrap().replace(id.into()).is_none());
+                self.event("start", id).await
+            })
+        }
+
+        fn navigate<'a>(&'a self, id: &'a str) -> BoxFuture<'a, Result<()>> {
+            Box::pin(self.event("navigate", id))
+        }
