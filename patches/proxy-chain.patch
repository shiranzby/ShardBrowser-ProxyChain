+                rows.iter().find(|p| p["id"] == original.id).unwrap()["proxy_chain_policy"],
+                "enabled"
+            );
+            assert_eq!(
+                rows.iter().find(|p| p["id"] == rotated.id).unwrap()["proxy_chain_policy"],
+                "disabled"
+            );
+            assert!(!listed.to_string().contains("synthetic-"));
+            let mut adaptive = original.clone();
