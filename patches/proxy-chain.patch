diff --git a/src/features/manage-proxies/ui/TnbExtractForm.tsx b/src/features/manage-proxies/ui/TnbExtractForm.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c2622c2b3d1bf44cf682aa4e6a73d05eda115b8a
--- /dev/null
+++ b/src/features/manage-proxies/ui/TnbExtractForm.tsx
@@ -0,0 +1,92 @@
+import { Checkbox, Input, Select } from "@proxyshard/shardx-ui-kit";
+import { useT } from "../../../shared/i18n";
+import type { TnbExtractRequest } from "../../../entities/proxy";
+import { TnbGeoFields, type TnbGeo } from "./TnbGeoFields";
+
+export type TnbDraft = Omit<TnbExtractRequest, "count" | "ttl" | "geo"> & TnbGeo & {
+  count: string;
+  ttl: string;
+};
+
+export const newTnbDraft = (): TnbDraft => ({
+  server: "http://usdata.adv.tnbproxy.com:9090", plan_name: "advanced_traffic", kind: "http",
+  count: "1", ttl: "0", pre: false, route: "direct", country: null, region: null, city: null,
+  pool: "", isp: "", asn: "", ip: "", sid: "",
+});
+
+/** UI validation keeps a bad request editable; the backend validates it again. */
+export function tnbRequest(draft: TnbDraft): TnbExtractRequest | null {
+  const count = Number(draft.count), ttl = Number(draft.ttl);
+  if (!/^\d+$/.test(draft.count) || !Number.isInteger(count) || count < 1 || count > 1000) return null;
+  if (!/^\d+$/.test(draft.ttl) || !Number.isInteger(ttl) || ttl < 0 || ttl > 180) return null;
+  let server: URL;
+  try { server = new URL(draft.server.trim()); } catch { return null; }
+  if (!["http:", "https:"].includes(server.protocol) || server.username || server.password || server.search || server.hash || !["/", "/gen"].includes(server.pathname)) return null;
+  if (!/^[A-Za-z0-9_-]{1,64}$/.test(draft.plan_name.trim())) return null;
+  const optional = [draft.country?.code, draft.region?.code, draft.city?.code, draft.pool, draft.isp, draft.asn, draft.ip, draft.sid];
+  if (optional.some((s) => s !== undefined && (s.length > 256 || /\p{Cc}/u.test(s)))) return null;
+  const country = draft.country?.code, region = draft.region?.code, city = draft.city?.code;
+  if ((region && !country) || (city && !region)) return null;
+  if ([country, region, city].filter(Boolean).join("_").length > 256) return null;
+  return {
+    server: draft.server.trim(), plan_name: draft.plan_name.trim(), kind: draft.kind,
+    count, ttl, pre: draft.pre, route: draft.route,
+    // TNB's public export formatter keeps selected levels and normalizes hyphens.
+    geo: [country, region, city].filter((code): code is string => !!code).map((code) => code.replace(/-/g, "_")).join("_"),
+    ...Object.fromEntries((["pool", "isp", "asn", "ip", "sid"] as const).map((key) => [key, draft[key]?.trim() || undefined])),
+  };
+}
+
+export function tnbErrorText(t: (key: string) => string, error: unknown): string {
+  switch (String(error instanceof Error ? error.message : error)) {
+    case "tnb_invalid_request": return t("tnb.errorInvalid");
+    case "tnb_timeout": return t("tnb.errorTimeout");
+    case "tnb_route_failed": return t("tnb.errorRoute");
+    case "tnb_http_status": return t("tnb.errorHttp");
+    case "tnb_response_too_large": return t("tnb.errorLarge");
+    case "tnb_invalid_response": return t("tnb.errorResponse");
+    case "tnb_no_proxies": return t("tnb.errorEmpty");
+    case "tnb_busy": return t("tnb.errorBusy");
+    default: return t("tnb.errorRequest");
+  }
+}
+
+export function TnbExtractForm({ value, onChange, disabled, error }: {
+  value: TnbDraft;
+  onChange: (next: TnbDraft) => void;
+  disabled: boolean;
+  error: string | null;
+}) {
+  const t = useT();
+  const set = <K extends keyof TnbDraft>(key: K, next: TnbDraft[K]) => onChange({ ...value, [key]: next });
+  return (
+    <div className="flex flex-col gap-3" data-tnb-form>
+      <div className="grid grid-cols-2 gap-3">
+        <Input label={t("tnb.server")} inputSize="xsmall" value={value.server} disabled={disabled} onChange={(e) => onChange({ ...value, server: e.target.value, country: null, region: null, city: null })} />
+        <Input label={t("tnb.plan")} inputSize="xsmall" value={value.plan_name} disabled={disabled} onChange={(e) => set("plan_name", e.target.value)} />
+        <Select label={t("tnb.protocol")} size="xsmall" value={value.kind} disabled={disabled} onChange={(v) => set("kind", v as TnbDraft["kind"])} options={[{ value: "http", label: "HTTP" }, { value: "socks5", label: "SOCKS5" }]} />
+        <Input label={t("tnb.count")} inputSize="xsmall" type="number" min={1} max={1000} step={1} value={value.count} disabled={disabled} onChange={(e) => set("count", e.target.value)} />
+      </div>
+      <TnbGeoFields server={value.server} route={value.route} value={value} disabled={disabled} onChange={(geo) => onChange({ ...value, ...geo })} />
+      <p className="m-0 text-secondary text-text-soft-400">{t("tnbGeo.hint")}</p>
+      <div className="grid grid-cols-2 gap-3">
+        <Input label={t("tnb.ttl")} hint={t("tnb.ttlHint")} inputSize="xsmall" type="number" min={0} max={180} step={1} value={value.ttl} disabled={disabled} onChange={(e) => set("ttl", e.target.value)} />
+        <Select label={t("tnb.route")} size="xsmall" value={value.route} disabled={disabled} onChange={(v) => set("route", v as TnbDraft["route"])} options={[{ value: "direct", label: t("tnb.direct") }, { value: "first_hop", label: t("tnb.firstHop") }]} />
+      </div>
+      <p className="m-0 text-secondary text-text-sub-600">{value.route === "first_hop" ? t("tnb.firstHopHint") : t("tnb.directHint")}</p>
+      <p className="m-0 text-secondary text-text-sub-600">{t("tnb.whitelist")}</p>
+      <details>
+        <summary className="cursor-pointer text-ui text-text-sub-600">{t("tnb.advanced")}</summary>
+        <div className="mt-3 grid grid-cols-2 gap-3">
+          <Input label={t("tnb.pool")} inputSize="xsmall" value={value.pool ?? ""} disabled={disabled} onChange={(e) => set("pool", e.target.value)} />
+          <Input label={t("tnb.isp")} inputSize="xsmall" value={value.isp ?? ""} disabled={disabled} onChange={(e) => set("isp", e.target.value)} />
+          <Input label={t("tnb.asn")} inputSize="xsmall" value={value.asn ?? ""} disabled={disabled} onChange={(e) => set("asn", e.target.value)} />
+          <Input label={t("tnb.ip")} inputSize="xsmall" value={value.ip ?? ""} disabled={disabled} onChange={(e) => set("ip", e.target.value)} />
+          <Input label={t("tnb.sid")} inputSize="xsmall" value={value.sid ?? ""} disabled={disabled} onChange={(e) => set("sid", e.target.value)} />
+          <Checkbox label={t("tnb.pre")} checked={value.pre} disabled={disabled} onCheckedChange={(checked) => set("pre", checked)} />
+        </div>
+      </details>
+      {error && <p role="alert" className="m-0 text-secondary text-error-text">{error}</p>}
+    </div>
+  );
+}
diff --git a/src/features/manage-proxies/ui/TnbGeoFields.tsx b/src/features/manage-proxies/ui/TnbGeoFields.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..fc3fdff9625564a946e46f01d0b8a97e6cbaaebd
--- /dev/null
+++ b/src/features/manage-proxies/ui/TnbGeoFields.tsx
@@ -0,0 +1,35 @@
+import { useCallback } from "react";
+import { tnbProxyLocations, type TnbLocation, type TnbLocationsRequest } from "../../../entities/proxy";
+import { TnbLocationPicker, type TnbLocationState } from "./TnbLocationPicker";
+import { useTnbLocations } from "./useTnbLocations";
+
+export type TnbGeo = { country: TnbLocation | null; region: TnbLocation | null; city: TnbLocation | null };
+
+function useLocations(request: TnbLocationsRequest) {
+  const { server, route, level, country, state } = request;
+  const key = JSON.stringify([server.trim(), route, level, country ?? "", state ?? ""]);
+  const fetch = useCallback(async (): Promise<TnbLocationState> => {
+    const result = await tnbProxyLocations({ server: server.trim(), route, level, country, state });
+    return { status: result.supported ? "ready" : "unavailable", items: result.items.filter((entry) => entry.code && entry.code !== "0") };
+  }, [server, route, level, country, state]);
+  return { ...useTnbLocations(key, fetch), key };
+}
+
+export function TnbGeoFields({ server, route, value, disabled, onChange }: {
+  server: string;
+  route: TnbLocationsRequest["route"];
+  value: TnbGeo;
+  disabled: boolean;
+  onChange: (geo: TnbGeo) => void;
+}) {
+  const country = useLocations({ server, route, level: "country" });
+  const region = useLocations({ server, route, level: "state", country: value.country?.code });
+  const city = useLocations({ server, route, level: "city", country: value.country?.code, state: value.region?.code });
+  return (
+    <div className="grid grid-cols-3 gap-3" data-tnb-geo>
+      <TnbLocationPicker key={country.key} level="country" value={value.country} state={country.state} disabled={disabled} onLoad={country.load} onChange={(next) => onChange({ country: next, region: null, city: null })} />
+      <TnbLocationPicker key={region.key} level="region" value={value.region} state={region.state} disabled={disabled || !value.country} onLoad={region.load} onChange={(next) => onChange({ ...value, region: next, city: null })} />
+      <TnbLocationPicker key={city.key} level="city" value={value.city} state={city.state} disabled={disabled || !value.region} onLoad={city.load} onChange={(next) => onChange({ ...value, city: next })} />
+    </div>
+  );
+}
diff --git a/src/features/manage-proxies/ui/TnbLocationPicker.tsx b/src/features/manage-proxies/ui/TnbLocationPicker.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..fabe76a714ab11bb3d00d04089564dd3c54dccb1
--- /dev/null
+++ b/src/features/manage-proxies/ui/TnbLocationPicker.tsx
@@ -0,0 +1,95 @@
+import { useMemo, useRef, useState } from "react";
+import { Button, Combobox, Popover, type ComboboxOption } from "@proxyshard/shardx-ui-kit";
+import { ChevronDownIcon } from "../../../shared/icons";
+import { useLang, useT } from "../../../shared/i18n";
+import type { TnbLocation } from "../../../entities/proxy";
+
+/** Values come from TNB metadata. Labels are display-only; code is sent unchanged. */
+export type TnbLocationState = {
+  status: "idle" | "loading" | "ready" | "error" | "unavailable";
+  items: TnbLocation[];
+  errorCode?: string;
+};
+export type TnbLocationLevel = "country" | "region" | "city";
+
+const countryNames = {
+  en: new Intl.DisplayNames(["en"], { type: "region", fallback: "none" }),
+  zh: new Intl.DisplayNames(["zh"], { type: "region", fallback: "none" }),
+  ru: new Intl.DisplayNames(["ru"], { type: "region", fallback: "none" }),
+};
+
+function names(item: TnbLocation, level: TnbLocationLevel) {
+  const code = item.code.toUpperCase();
+  if (level !== "country" || !/^[A-Z]{2}$/.test(code)) return {};
+  return { en: countryNames.en.of(code), zh: countryNames.zh.of(code), ru: countryNames.ru.of(code) };
+}
+
+export function TnbLocationPicker({ level, value, state, disabled, onLoad, onChange }: {
+  level: TnbLocationLevel;
+  value: TnbLocation | null;
+  state: TnbLocationState;
+  disabled: boolean;
+  onLoad: () => void;
+  onChange: (value: TnbLocation | null) => void;
+}) {
+  const t = useT();
+  const lang = useLang((s) => s.lang);
+  const [open, setOpen] = useState(false);
+  const anchor = useRef<HTMLButtonElement>(null);
+  const label = level === "country" ? t("tnbGeo.country") : level === "region" ? t("tnbGeo.region") : t("tnbGeo.city");
+  const any = level === "country" ? t("tnbGeo.anyCountry") : level === "region" ? t("tnbGeo.anyRegion") : t("tnbGeo.anyCity");
+  const searchLabel = level === "country" ? t("tnbGeo.searchCountry") : level === "region" ? t("tnbGeo.searchRegion") : t("tnbGeo.searchCity");
+  const display = (item: TnbLocation) => {
+    const translated = names(item, level);
+    return translated[lang] || item.label;
+  };
+  const options = useMemo<ComboboxOption[]>(() => [
+    { value: "0", label: any, keywords: ["0", "all", "any", "不限", "global"] },
+    ...state.items.filter((item) => item.code !== "0").map((item) => {
+      const translated = names(item, level);
+      const label = translated[lang] || item.label;
+      return { value: item.code, label, hint: item.code === label ? undefined : item.code, keywords: [item.code, item.label, ...Object.values(translated)].filter((s): s is string => !!s) };
+    }),
+  ], [state.items, level, lang, any]);
+  const loading = state.status === "loading";
+  const failure = state.errorCode === "tnb_locations_invalid_request" ? t("tnbGeo.invalid")
+    : state.errorCode === "tnb_locations_timeout" ? t("tnbGeo.timeout")
+      : state.errorCode === "tnb_locations_route_failed" ? t("tnbGeo.routeFailed")
+        : state.errorCode === "tnb_locations_auth_required" || state.errorCode === "tnb_locations_http_status" ? t("tnbGeo.refused")
+          : state.errorCode === "tnb_locations_too_large" || state.errorCode === "tnb_locations_invalid_response" ? t("tnbGeo.invalidResponse")
+            : state.errorCode === "tnb_locations_busy" ? t("tnbGeo.busy") : t("tnbGeo.failed");
+  const notice = state.status !== "ready" || state.items.length === 0;
+  return (
+    <div className="flex min-w-0 flex-col gap-[6px]" data-tnb-location={level}>
+      <span className="text-secondary text-text-sub-600">{label}</span>
+      <Button ref={anchor} variant="neutral" mode="stroke" size="xsmall" className="w-full" contentAlign="start" rightIcon={<ChevronDownIcon className="size-3.5" />} aria-label={label} aria-haspopup="dialog" aria-expanded={open} disabled={disabled} onClick={() => {
+        if (!open && (state.status === "idle" || state.status === "error")) onLoad();
+        setOpen(!open);
+      }}>
+        {value ? display(value) : any}
+      </Button>
+      <Popover open={open && !disabled} onOpenChange={setOpen} anchorRef={anchor} align="start" aria-label={label} className="w-[300px] p-0">
+        <Combobox
+          aria-label={searchLabel}
+          placeholder={searchLabel}
+          options={options}
+          value={value?.code ?? "0"}
+          maxListHeight={220}
+          emptyText={t("tnbGeo.noMatch")}
+          onChange={(code) => {
+            const item = state.items.find((entry) => entry.code === code);
+            if (code !== "0" && (!item || state.status !== "ready")) return;
+            onChange(code === "0" ? null : item!);
+            setOpen(false);
+          }}
+        />
+        {notice && <div className="px-3 py-2" role={state.status === "error" ? "alert" : "status"}>
+          {loading && <p className="m-0 text-secondary text-text-soft-400">{t("tnbGeo.loading")}</p>}
+          {state.status === "error" && <div className="flex flex-col gap-2"><p className="m-0 text-secondary text-error-text">{failure}</p><Button size="xsmall" variant="neutral" mode="stroke" disabled={loading} onClick={onLoad}>{t("tnbGeo.retry")}</Button></div>}
+          {state.status === "ready" && state.items.length === 0 && <p className="m-0 text-secondary text-text-soft-400">{t("tnbGeo.noLocations")}</p>}
+          {state.status === "unavailable" && <p className="m-0 text-secondary text-text-soft-400">{t("tnbGeo.unavailable")}</p>}
+        </div>}
+      </Popover>
+    </div>
+  );
+}
diff --git a/src/features/manage-proxies/ui/useTnbLocations.ts b/src/features/manage-proxies/ui/useTnbLocations.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4d20d081228e6fa9cbaa652b6db1dc0033c23798
--- /dev/null
+++ b/src/features/manage-proxies/ui/useTnbLocations.ts
@@ -0,0 +1,23 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import type { TnbLocationState } from "./TnbLocationPicker";
+
+const EMPTY: TnbLocationState = { status: "idle", items: [] };
+
+/** A result belongs to one provider and one parent. A late answer never changes another list. */
+export function useTnbLocations(key: string, fetchLocations: () => Promise<TnbLocationState>) {
+  const [current, setCurrent] = useState<{ key: string; state: TnbLocationState }>({ key, state: EMPTY });
+  const sequence = useRef(0);
+  const pending = useRef<{ key: string; sequence: number } | null>(null);
+  useEffect(() => () => { sequence.current++; pending.current = null; }, [key]);
+  const load = useCallback(() => {
+    if (pending.current?.key === key) return;
+    const asked = ++sequence.current;
+    pending.current = { key, sequence: asked };
+    setCurrent({ key, state: { status: "loading", items: [] } });
+    void fetchLocations().then(
+      (state) => { if (sequence.current === asked) setCurrent({ key, state }); },
+      (error: unknown) => { if (sequence.current === asked) setCurrent({ key, state: { status: "error", items: [], errorCode: String(error instanceof Error ? error.message : error) } }); },
+    ).finally(() => { if (pending.current?.sequence === asked) pending.current = null; });
+  }, [key, fetchLocations]);
+  return { state: current.key === key ? current.state : EMPTY, load };
+}
