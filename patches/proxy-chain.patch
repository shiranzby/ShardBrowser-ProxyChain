+#[derive(Serialize)]
+struct Report {
+    kind: &'static str,
+    evidence_scope: &'static str,
+    state: &'static str,
+    stage: &'static str,
+    error_code: Option<&'static str>,
+    modes: Vec<ModeReport>,
+    original_synthetic_files_unchanged: bool,
+    isolated_store_removed: bool,
+}
+
+fn check(condition: bool, code: &'static str) -> Result<()> {
+    if condition {
+        Ok(())
+    } else {
+        Err(code)
+    }
+}
