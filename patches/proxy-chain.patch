+            )?;
+            check(
+                hash_file(&proxy_path)? == proxy_hash,
+                "preferred_live_proxy_changed",
+            )?;
+            check(
+                crate::space::profile::load_raw(id)
+                    .map_err(|_| "preferred_live_store_failed")?
