+export function folderPath(name: string, parents: FolderParents): string {
+  const path: string[] = [];
+  const seen = new Set<string>();
+  while (name && !seen.has(name)) { path.unshift(name); seen.add(name); name = own(parents, name); }
+  return path.join(" / ");
+}
