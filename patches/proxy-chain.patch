+import test from "node:test";
+import assert from "node:assert/strict";
+import { routeExitProxyId, routeProxyIds, routeUsesRealIp, profileRouteLabel } from "./profileRoute.ts";
+
+test("explicit routes keep an inactive binding without claiming it is the exit", () => {
+  const proxy_id = "hk";
+  for (const mode of ["direct", "system"] as const) {
+    const p = { proxy_id, proxy_route: { mode } };
+    assert.equal(routeExitProxyId(p), null);
+    assert.deepEqual(routeProxyIds(p), []);
+    assert.equal(routeUsesRealIp(p), mode === "direct");
+  }
+  const chain = { proxy_id, proxy_route: { mode: "chain", first: { mode: "proxy", proxy_id: "jp" }, second: { mode: "direct" } } } as const;
+  assert.equal(routeExitProxyId(chain), "jp");
+  assert.deepEqual(routeProxyIds(chain), ["jp"]);
+  assert.equal(routeUsesRealIp(chain), false);
+});
+
+test("a two-proxy route requires both entries and exposes the second as its final exit", () => {
+  const p = { proxy_id: "hk", proxy_route: { mode: "chain", first: { mode: "proxy", proxy_id: "jp" }, second: { mode: "proxy" } } } as const;
+  assert.equal(routeExitProxyId(p), "hk");
+  assert.deepEqual(routeProxyIds(p), ["jp", "hk"]);
+  assert.equal(routeUsesRealIp(p), false);
+  assert.equal(routeUsesRealIp({ proxy_id: null, protected: true }), false);
+  assert.equal(routeUsesRealIp({ proxy_id: null }), true);
+  assert.equal(routeUsesRealIp({ proxy_id: "missing" }), false);
+});
+
+test("route summaries never call a system route or a selected first-hop direct", () => {
+  const proxies = [{ id: "hk", name: "HK", host: "hk.example", port: 1080 }, { id: "jp", name: "JP", host: "jp.example", port: 1080 }];
+  const t = (key: string, vars?: Record<string, string | number>) => vars ? `${vars.first} / ${vars.second}` : key;
+  assert.equal(profileRouteLabel({ proxy_id: "hk", proxy_route: { mode: "system" } }, proxies, t), "profileRoute.summarySystem");
+  assert.equal(profileRouteLabel({ proxy_id: "hk", proxy_route: { mode: "chain", first: { mode: "proxy", proxy_id: "jp" }, second: { mode: "direct" } } }, proxies, t), "JP");
+  assert.equal(profileRouteLabel({ proxy_id: "hk", proxy_route: { mode: "chain", first: { mode: "system" }, second: { mode: "proxy" } } }, proxies, t), "profileRoute.summaryFirstSystem / HK");
+});
diff --git a/src/shared/lib/profileRoute.ts b/src/shared/lib/profileRoute.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7d39b5fd3c813ebab380d3308fa722b0289bb057
--- /dev/null
+++ b/src/shared/lib/profileRoute.ts
@@ -0,0 +1,55 @@
+import type { ProfileProxyRoute } from "../model/proxyChain";
+
+type RoutedProfile = { proxy_id: string | null; proxy_route?: ProfileProxyRoute | null; protected?: boolean };
+type T = (key: string, vars?: Record<string, string | number>) => string;
+type NamedProxy = { id: string; name: string; host: string; port: number };
+
+/** The selected proxy that actually provides the final exit, not a retained inactive binding. */
+export function routeExitProxyId(p: RoutedProfile): string | null {
+  const route = p.proxy_route;
+  if (!route || route.mode === "proxy") return p.proxy_id;
+  if (route.mode !== "chain") return null;
+  return route.second.mode === "proxy" ? p.proxy_id
+    : route.first.mode === "proxy" ? route.first.proxy_id : null;
+}
+
+/** Every selected library proxy this explicit route needs to start. */
+export function routeProxyIds(p: RoutedProfile): string[] {
+  const route = p.proxy_route;
+  if (!route || route.mode === "proxy") return p.proxy_id ? [p.proxy_id] : [];
+  if (route.mode !== "chain") return [];
+  return [...new Set([
+    ...(route.first.mode === "proxy" ? [route.first.proxy_id] : []),
+    ...(route.second.mode === "proxy" && p.proxy_id ? [p.proxy_id] : []),
+  ])];
+}
+
+/** A missing selected proxy is a failure, never an intended real-IP route. */
+export function routeUsesRealIp(p: RoutedProfile): boolean {
+  if (p.protected) return false;
+  const route = p.proxy_route;
+  if (!route) return !p.proxy_id;
+  return route.mode === "direct" || (route.mode === "chain" && route.first.mode === "direct" && route.second.mode === "direct");
+}
+
+/** System/PAC routes have a proxy even though no library proxy id names it. */
+export function routeUsesProxy(p: RoutedProfile): boolean {
+  return !routeUsesRealIp(p) && !p.protected;
+}
+
+export function profileRouteLabel(p: RoutedProfile, proxies: readonly NamedProxy[], t: T): string | null {
+  const route = p.proxy_route;
+  if (!route) return null;
+  const name = (id: string | null) => {
+    const proxy = proxies.find(x => x.id === id);
+    return proxy ? proxy.name || `${proxy.host}:${proxy.port}` : t("profileRow.proxyMissing");
+  };
+  if (route.mode === "direct") return t("profileRoute.summaryDirect");
+  if (route.mode === "system") return t("profileRoute.summarySystem");
+  if (route.mode === "proxy") return name(p.proxy_id);
+  if (route.mode !== "chain") return t("profileRoute.invalid");
+  const first = route.first.mode === "system" ? t("profileRoute.summaryFirstSystem")
+    : route.first.mode === "direct" ? t("profileRoute.summaryFirstDirect") : name(route.first.proxy_id);
+  return route.second.mode === "direct" ? first
+    : t("profileRoute.summaryChain", { first, second: name(p.proxy_id) });
+}
