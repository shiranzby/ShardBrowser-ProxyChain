+#[derive(Clone, Copy, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum LocationLevel {
+    Country,
+    State,
+    City,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct LocationsRequest {
+    pub server: String,
+    pub route: Route,
+    pub level: LocationLevel,
+    pub country: Option<String>,
+    pub state: Option<String>,
+}
+
+#[derive(Debug, Serialize, PartialEq, Eq)]
+pub struct LocationItem {
+    pub code: String,
+    pub label: String,
+}
+
+#[derive(Debug, Serialize)]
+pub struct Locations {
+    pub items: Vec<LocationItem>,
+    pub supported: bool,
+    pub source: &'static str,
+}
+
+fn locations_error(code: &'static str) -> &'static str {
+    match code {
+        "tnb_invalid_request" => "tnb_locations_invalid_request",
+        "tnb_timeout" => "tnb_locations_timeout",
+        "tnb_route_failed" => "tnb_locations_route_failed",
+        "tnb_http_status" => "tnb_locations_http_status",
+        "tnb_auth_required" => "tnb_locations_auth_required",
+        "tnb_response_too_large" => "tnb_locations_too_large",
+        _ => "tnb_locations_request_failed",
+    }
+}
+
+fn locations_body(request: &LocationsRequest) -> Result<serde_json::Value> {
+    let country = request.country.as_deref().unwrap_or("");
+    let state = request.state.as_deref().unwrap_or("");
+    if (!country.is_empty()
+        && (country.len() != 2 || !country.bytes().all(|c| c.is_ascii_uppercase())))
+        || state.len() > 128
+        || state.chars().any(char::is_control)
+        || state != state.trim()
+    {
+        return Err("tnb_locations_invalid_request");
+    }
+    match request.level {
+        LocationLevel::Country if country.is_empty() && state.is_empty() => {
+            Ok(serde_json::json!({}))
+        }
+        LocationLevel::State if !country.is_empty() && state.is_empty() => {
+            Ok(serde_json::json!({"region":country}))
+        }
+        LocationLevel::City if !country.is_empty() && !state.is_empty() => {
+            Ok(serde_json::json!({"region":country,"state":state}))
+        }
+        _ => Err("tnb_locations_invalid_request"),
+    }
+}
+
+fn parse_locations(bytes: &[u8], request: &LocationsRequest) -> Result<Vec<LocationItem>> {
+    let response: serde_json::Value =
+        serde_json::from_slice(bytes).map_err(|_| "tnb_locations_invalid_response")?;
+    if matches!(
+        response.get("code").and_then(serde_json::Value::as_i64),
+        Some(401 | 403)
+    ) {
+        return Err("tnb_locations_auth_required");
+    }
+    if response.get("code").and_then(serde_json::Value::as_i64) != Some(0) {
+        return Err("tnb_locations_invalid_response");
+    }
+    let rows = response
+        .get("data")
+        .and_then(serde_json::Value::as_array)
+        .ok_or("tnb_locations_invalid_response")?;
+    if rows.len() > 10_000 {
+        return Err("tnb_locations_too_large");
+    }
+    let mut items = Vec::new();
+    let mut seen = std::collections::HashSet::new();
+    for row in rows {
+        let region = row
+            .get("region")
+            .and_then(serde_json::Value::as_str)
+            .ok_or("tnb_locations_invalid_response")?;
+        let state = row
+            .get("state")
+            .and_then(serde_json::Value::as_str)
+            .ok_or("tnb_locations_invalid_response")?;
+        let city = row
+            .get("city")
+            .and_then(serde_json::Value::as_str)
+            .ok_or("tnb_locations_invalid_response")?;
+        if (!region.is_empty()
+            && (region.len() != 2 || !region.bytes().all(|c| c.is_ascii_uppercase())))
+            || [state, city].iter().any(|value| {
+                value.len() > 128 || value.chars().any(char::is_control) || *value != value.trim()
+            })
+        {
+            return Err("tnb_locations_invalid_response");
+        }
+        if !matches!(request.level, LocationLevel::Country)
+            && Some(region) != request.country.as_deref()
+        {
+            return Err("tnb_locations_invalid_response");
+        }
+        if matches!(request.level, LocationLevel::City) && Some(state) != request.state.as_deref() {
+            return Err("tnb_locations_invalid_response");
+        }
+        let code = match request.level {
+            LocationLevel::Country => region,
+            LocationLevel::State => state,
+            LocationLevel::City => city,
+        };
+        // The provider includes a blank choice for "any" at each level. The
+        // UI owns its translated "any" row; aliases/case otherwise stay exact.
+        if !code.is_empty() && seen.insert(code.to_owned()) {
+            items.push(LocationItem {
+                code: code.to_owned(),
+                label: code.to_owned(),
+            });
+        }
+    }
+    Ok(items)
+}
+
+/// Public metadata only, with no account token, cookies, device id or /gen.
+pub async fn locations(request: LocationsRequest) -> Result<Locations> {
+    let endpoint = Url::parse(LOCATIONS_SOURCE).map_err(|_| "tnb_locations_request_failed")?;
+    locations_using(request, endpoint, Duration::from_secs(20)).await
+}
+
+async fn locations_using(
+    request: LocationsRequest,
+    endpoint: Url,
+    timeout: Duration,
+) -> Result<Locations> {
+    let server = server_url(&request.server).map_err(locations_error)?;
+    let body = locations_body(&request)?;
+    let host = server.host_str().ok_or("tnb_locations_invalid_request")?;
+    if host != "tnbproxy.com" && !host.ends_with(".tnbproxy.com") {
+        return Ok(Locations {
+            items: Vec::new(),
+            supported: false,
+            source: "",
+        });
+    }
+    let _slot = LOCATION_REQUESTS
+        .try_acquire()
+        .map_err(|_| "tnb_locations_busy")?;
+    let bytes = fetch_on_route(endpoint, request.route, Some(body), timeout, None)
+        .await
+        .map_err(locations_error)?;
+    Ok(Locations {
+        items: parse_locations(&bytes, &request)?,
+        supported: true,
+        source: LOCATIONS_SOURCE,
+    })
+}
