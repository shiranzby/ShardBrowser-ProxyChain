+            .args(["-NoLogo", "-NoProfile", "-NonInteractive", "-Command", READ_LINK_PS])
+            .env("SHARD_LINK", &link).creation_flags(0x08000000).output().unwrap();
+        assert!(output.status.success(), "read link with native Windows COM");
+        let read: serde_json::Value = serde_json::from_slice(&output.stdout).unwrap();
+        assert_eq!(read["target"].as_str().unwrap(), executable.to_str().unwrap());
+        assert_eq!(read["arguments"], format!("--profile-id {id}"));
