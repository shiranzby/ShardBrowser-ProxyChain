+        "webrtc",
+        "canvas",
+        "fonts",
+        "navigator",
+        "timezone",
+        "screen",
+    ];
+    let path = path_for(id)?;
+    let body = fs::read_to_string(&path)
+        .with_context(|| format!("read fingerprint {}", path.display()))?;
