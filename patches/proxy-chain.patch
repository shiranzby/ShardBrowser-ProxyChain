+    async fn read_head(stream: &mut TcpStream) -> String {
+        let mut head = Vec::new();
+        while !head.ends_with(b"\r\n\r\n") {
+            let byte = stream.read_u8().await.unwrap();
+            head.push(byte);
+            assert!(head.len() < 16 * 1024);
+        }
+        String::from_utf8(head).unwrap()
+    }
