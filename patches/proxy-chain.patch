index 0000000..fe3707a
--- /dev/null
+++ b/src/entities/profile/lib/folderTree.test.ts
@@ -0,0 +1,40 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { folderPath, folderTree, forgetFolderParent, insideFolder, renameFolderParents } from "./folderTree.ts";
+
+test("a folder filter includes descendants but never similarly named siblings", () => {
+  const parents = { Child: "Root", Leaf: "Child" };
+  assert.equal(insideFolder("Root", "Root", parents), true);
+  assert.equal(insideFolder("Leaf", "Root", parents), true);
+  assert.equal(insideFolder("Root/old", "Root", parents), false);
+  assert.equal(insideFolder("Other", "Root", parents), false);
+  assert.equal(insideFolder("", "Root", parents), false);
+  assert.equal(insideFolder("", "", parents), true);
+  assert.equal(insideFolder("Root", "", parents), false);
+});
+
+test("tree order keeps a parent before its children and uses the saved sibling order", () => {
+  const result = folderTree(["Leaf", "Child B", "Other", "Root", "Child A"], { "Child A": "Root", "Child B": "Root", Leaf: "Child B" });
+  assert.deepEqual(result.map(({ name, depth }) => [name, depth]), [["Other", 0], ["Root", 0], ["Child B", 1], ["Leaf", 2], ["Child A", 1]]);
+  assert.equal(folderPath("Leaf", { Leaf: "Child B", "Child B": "Root" }), "Root / Child B / Leaf");
+});
+
+test("rename keeps descendants; delete promotes direct children and retains deeper edges", () => {
+  const original = { Child: "Root", Leaf: "Child", Deep: "Leaf" };
+  const renamed = renameFolderParents(original, "Child", "New");
+  assert.deepEqual(renamed, { New: "Root", Leaf: "New", Deep: "Leaf" });
+  assert.deepEqual(forgetFolderParent(renamed, "New"), { Leaf: "Root", Deep: "Leaf" });
+  assert.deepEqual(forgetFolderParent(original, "Root"), { Leaf: "Child", Deep: "Leaf" });
+  assert.deepEqual(original, { Child: "Root", Leaf: "Child", Deep: "Leaf" });
+});
+
+test("corrupt cycles, missing parents and object-property names never hide a folder or loop", () => {
+  const parents = { A: "B", B: "A", Orphan: "Missing" };
+  assert.equal(insideFolder("A", "Other", parents), false);
+  const names = ["A", "B", "Orphan", "constructor", "__proto__"];
+  const got = folderTree(names, parents);
+  assert.deepEqual([...new Set(got.map((n) => n.name))].sort(), [...names].sort());
+  assert.equal(folderPath("constructor", parents), "constructor");
+  assert.equal(folderPath("__proto__", parents), "__proto__");
+  assert.deepEqual(forgetFolderParent({ Child: "constructor" }, "constructor"), {});
+});
diff --git a/src/entities/profile/lib/folderTree.ts b/src/entities/profile/lib/folderTree.ts
new file mode 100644
index 0000000..3fce987
--- /dev/null
+++ b/src/entities/profile/lib/folderTree.ts
@@ -0,0 +1,58 @@
+/** Folder names remain stable keys. Hierarchy is explicit, never parsed from names. */
+export type FolderParents = Readonly<Record<string, string>>;
+export const NO_FOLDER_PARENTS: FolderParents = Object.freeze({});
+const own = (parents: FolderParents, name: string): string => Object.prototype.hasOwnProperty.call(parents, name) ? parents[name] : "";
+
+/** Includes the folder itself. Malformed imported loops always terminate. */
+export function insideFolder(name: string, ancestor: string, parents: FolderParents = NO_FOLDER_PARENTS): boolean {
+  if (name === ancestor) return true;
+  const seen = new Set<string>();
+  while (name && !seen.has(name)) {
+    if (name === ancestor) return true;
+    seen.add(name);
+    name = own(parents, name);
+  }
+  return false;
+}
+
+/** Parent first, siblings in the caller's chosen order. Orphans stay visible. */
+export function folderTree(names: readonly string[], parents: FolderParents): { name: string; depth: number; parent: string; children: boolean }[] {
+  const known = new Set(names);
+  const children = new Map<string, string[]>();
+  for (const name of names) {
+    const p = own(parents, name);
+    const parent = p !== name && known.has(p) ? p : "";
+    children.set(parent, [...(children.get(parent) ?? []), name]);
+  }
+  const seen = new Set<string>();
+  const result: ReturnType<typeof folderTree> = [];
+  const add = (name: string, depth: number, parent: string) => {
+    if (seen.has(name)) return;
+    seen.add(name);
+    result.push({ name, depth, parent, children: (children.get(name)?.length ?? 0) > 0 });
+    for (const child of children.get(name) ?? []) add(child, depth + 1, name);
+  };
+  for (const name of children.get("") ?? []) add(name, 0, "");
+  // Corrupt cycles must not hide folders or the profiles they contain.
+  for (const name of names) if (!seen.has(name)) add(name, 0, "");
+  return result;
+}
+
+export function folderPath(name: string, parents: FolderParents): string {
+  const path: string[] = [];
+  const seen = new Set<string>();
+  while (name && !seen.has(name)) { path.unshift(name); seen.add(name); name = own(parents, name); }
+  return path.join(" / ");
+}
+
+export function renameFolderParents(parents: FolderParents, from: string, to: string): Record<string, string> {
+  return Object.fromEntries(Object.entries(parents).map(([name, parent]) => [name === from ? to : name, parent === from ? to : parent]));
+}
+
+/** Removing only the container promotes its children, preserving their contents. */
+export function forgetFolderParent(parents: FolderParents, name: string): Record<string, string> {
+  const parent = own(parents, name);
+  return Object.fromEntries(Object.entries(parents)
+    .filter(([child, p]) => child !== name && (p !== name || parent))
+    .map(([child, p]) => [child, p === name ? parent : p]));
+}
