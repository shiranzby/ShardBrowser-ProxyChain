+        assert_eq!(url.query(), Some("format=txt%2Fplain"));
+        for raw in [
+            "http://feed.example/proxies",
+            "https://user:password@feed.example/proxies",
+            "https://feed.example/proxies#fragment",
+        ] {
+            assert!(custom_extract_url(raw).is_err());
+        }
+    }
+}
