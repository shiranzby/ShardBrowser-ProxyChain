+#[derive(Deserialize)]
+struct LiveInput {
+    #[serde(default = "default_kind")]
+    kind: String,
+    host: String,
+    port: u16,
+    username: String,
+    password: String,
+    system_host: String,
+    system_port: u16,
+}
+fn default_kind() -> String { "socks5".into() }
