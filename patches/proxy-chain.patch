+#[cfg(windows)]
+#[tokio::test]
+#[ignore = "requires SHARDX_TEST_BROWSER and an isolated test process"]
+async fn windows_engine_releases_a_live_sync_lease_for_the_next_device() -> anyhow::Result<()> {
+    use crate::{process::Tracker, settings};
+    use windows_sys::Win32::Foundation::{BOOL, HWND, LPARAM};
+    use windows_sys::Win32::UI::WindowsAndMessaging::{
+        EnumWindows, GetClassNameW, GetWindow, GetWindowThreadProcessId, GW_OWNER,
+    };
+    let engine = PathBuf::from(std::env::var("SHARDX_TEST_BROWSER")?);
+    let two = Two::new().await;
+    let id = two.profile("Windows lease fixture");
+    cycle::run_once().await;
+    two.join_b().await;
+    cycle::run_once().await;
+    assert_eq!(two.row(&id).name, "Windows lease fixture");
+    let device_b = TeamClient::for_sync()?;
+
+    fn has_browser_window(pid: u32) -> bool {
+        struct Search {
+            pid: u32,
+            found: bool,
+        }
+        unsafe extern "system" fn check(window: HWND, state: LPARAM) -> BOOL {
+            // SAFETY: EnumWindows calls synchronously with the live search below.
+            let search = unsafe { &mut *(state as *mut Search) };
+            let mut pid = 0;
+            let mut class = [0u16; 32];
+            // SAFETY: Windows supplies the handle; both out buffers live for the call.
+            let len = unsafe {
+                GetWindowThreadProcessId(window, &mut pid);
+                if pid != search.pid || !GetWindow(window, GW_OWNER).is_null() {
+                    return 1;
+                }
+                GetClassNameW(window, class.as_mut_ptr(), class.len() as i32)
+            };
+            search.found = len > 0
+                && class[..len as usize]
+                    .iter()
+                    .copied()
+                    .eq("Chrome_WidgetWin_1".encode_utf16());
+            i32::from(!search.found)
+        }
+        let mut search = Search { pid, found: false };
+        // SAFETY: `search` remains live until the synchronous enumeration returns.
+        unsafe { EnumWindows(Some(check), &mut search as *mut Search as LPARAM) };
+        search.found
+    }
+
+    async fn open(engine: &std::path::Path, id: &str) -> anyhow::Result<()> {
+        let mut settings = settings::load()?;
+        settings.extra_args = "--start-minimized --disable-gpu --disable-background-networking".into();
+        settings::save(&settings)?;
+        let launched = crate::launch::launch_with(engine.to_path_buf(), id, false).await?;
+        tokio::time::timeout(Duration::from_secs(20), async {
+            while !has_browser_window(launched.pid) {
+                tokio::time::sleep(Duration::from_millis(50)).await;
+            }
+        })
+        .await
+        .map_err(|_| anyhow::anyhow!("fixture browser {} did not create a window", launched.pid))?;
+        Ok(())
+    }
+
+    async fn close(id: &str) -> anyhow::Result<()> {
+        let tracker = Tracker::shared();
+        tracker.request_graceful_close(id).await;
+        tokio::time::timeout(Duration::from_secs(30), async {
+            while !tracker.is_idle() {
+                tokio::time::sleep(Duration::from_millis(25)).await;
+            }
+        })
+        .await
+        .map_err(|_| anyhow::anyhow!("fixture browser did not close and settle its session"))?;
+        Ok(())
+    }
+
+    two.be(&two.a);
+    open(&engine, &id).await?;
+    let refused = device_b
+        .call(Method::POST, &format!("/me/profiles/{id}/lease"), None)
+        .await;
+    close(&id).await?;
+    let refusal = refused.expect_err("B must not acquire A's active lease");
+    assert_eq!(refusal.code(), Some(&super::super::client::Code::Leased));
+    assert!(two.on_server("profiles").await[0]["open_on"].is_null());
+
+    two.be(&two.b);
+    open(&engine, &id).await?;
+    let open_on_b = two.on_server("profiles").await[0]["open_on"]["device_name"].clone();
+    close(&id).await?;
+    assert_eq!(open_on_b, two.b.name);
+    assert!(two.on_server("profiles").await[0]["open_on"].is_null());
+    Ok(())
+}
