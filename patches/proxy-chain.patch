+async fn http_head(stream: &mut TcpStream) -> Vec<u8> {
+    let mut bytes = Vec::new();
+    while !bytes.ends_with(b"\r\n\r\n") {
+        bytes.push(stream.read_u8().await.unwrap());
+        assert!(bytes.len() <= 20_000);
+    }
+    bytes
+}
