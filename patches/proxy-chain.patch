+        assert_eq!(s.parents["Deep"], "Leaf");
+        assert_eq!(s.registry, ["Root", "Leaf", "Deep"]);
+        s.forget("Root");
+        assert!(!s.parents.contains_key("Leaf"));
+        assert_eq!(s.parents["Deep"], "Leaf");
+    }
+
+    #[test]
+    fn assigning_a_parent_keeps_profile_only_folders_and_imports_refuse_cycles() {
