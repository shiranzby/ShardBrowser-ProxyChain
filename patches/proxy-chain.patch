+use super::{config::ProxyChainSettings, error::ChainError};
+use serde::{Deserialize, Deserializer, Serialize};
+
+/// Missing fields inherit. Unrecognised data is retained as a refusal, never
+/// silently converted to an unchained route by a legacy/defaulting reader.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ChainPolicy {
+    #[default]
+    Inherit,
+    Enabled,
+    /// Explicitly permit connecting the assigned proxy without the first hop
+    /// after a first-hop route failure. It never permits a website direct route.
+    PreferFirstHop,
+    Disabled,
+    Invalid,
+}
+
+impl<'de> Deserialize<'de> for ChainPolicy {
+    fn deserialize<D: Deserializer<'de>>(d: D) -> Result<Self, D::Error> {
+        let value = serde_json::Value::deserialize(d)?;
+        Ok(match value.as_str() {
+            Some("inherit") => Self::Inherit,
+            Some("enabled") => Self::Enabled,
+            Some("prefer_first_hop") => Self::PreferFirstHop,
+            Some("disabled") => Self::Disabled,
+            _ => Self::Invalid,
+        })
+    }
+}
+
+impl ChainPolicy {
+    pub fn is_inherit(&self) -> bool {
+        *self == Self::Inherit
+    }
+
+    pub fn validate(self) -> Result<(), ChainError> {
+        if self == Self::Invalid {
+            return Err(ChainError::new("proxy_chain_policy_invalid", "configuration", "The proxy-chain choice is invalid. Choose inherit, enabled, prefer_first_hop or disabled before saving or starting."));
+        }
+        Ok(())
+    }
+}
+
+/// Profile > assigned proxy > this computer's default. Disabling only skips
+/// the first hop; it never removes the original assigned/inline proxy.
+pub fn effective(
+    config: &ProxyChainSettings,
+    profile: ChainPolicy,
+    proxy: ChainPolicy,
+) -> Result<ProxyChainSettings, ChainError> {
+    profile.validate()?;
+    proxy.validate()?;
+    // A damaged enabled protection setting must be repaired explicitly, not
+    // hidden by a per-object override.
+    if config.invalid || config.enabled {
+        config.validate()?;
+    }
+    let mut resolved = config.clone();
+    let choice = if profile.is_inherit() { proxy } else { profile };
+    resolved.allow_assigned_fallback = choice == ChainPolicy::PreferFirstHop;
+    resolved.enabled = match choice {
+        ChainPolicy::Inherit => config.enabled,
+        ChainPolicy::Enabled | ChainPolicy::PreferFirstHop => true,
+        ChainPolicy::Disabled => false,
+        ChainPolicy::Invalid => unreachable!("validated above"),
+    };
+    if resolved.enabled {
+        resolved.validate()?;
+    }
+    Ok(resolved)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn precedence_covers_every_profile_proxy_global_combination() {
+        use ChainPolicy::*;
+        for global in [false, true] {
+            let config = ProxyChainSettings {
+                enabled: global,
+                ..Default::default()
+            };
+            for profile in [Inherit, Enabled, PreferFirstHop, Disabled] {
+                for proxy in [Inherit, Enabled, PreferFirstHop, Disabled] {
+                    let expected = match (profile, proxy) {
+                        (Enabled | PreferFirstHop, _) | (Inherit, Enabled | PreferFirstHop) => true,
+                        (Disabled, _) | (Inherit, Disabled) => false,
+                        _ => global,
+                    };
+                    assert_eq!(
+                        effective(&config, profile, proxy).unwrap().enabled,
+                        expected
+                    );
+                    assert_eq!(
+                        effective(&config, profile, proxy)
+                            .unwrap()
+                            .allow_assigned_fallback,
+                        profile == PreferFirstHop
+                            || (profile == Inherit && proxy == PreferFirstHop)
+                    );
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn malformed_choices_and_enabled_settings_fail_closed() {
+        for raw in ["null", "true", "12", "{}", "\"future\""] {
+            let policy: ChainPolicy = serde_json::from_str(raw).unwrap();
+            assert!(policy.validate().is_err());
+            assert!(effective(&Default::default(), ChainPolicy::Disabled, policy).is_err());
+        }
+        let broken = ProxyChainSettings {
+            enabled: true,
+            invalid: true,
+            ..Default::default()
+        };
+        assert!(effective(&broken, ChainPolicy::Disabled, ChainPolicy::Inherit).is_err());
+        let disabled = ProxyChainSettings {
+            mode: "unknown".into(),
+            ..Default::default()
+        };
+        assert!(effective(&disabled, ChainPolicy::Enabled, ChainPolicy::Inherit).is_err());
+    }
+}
diff --git a/src-tauri/src/proxy_chain/readiness.rs b/src-tauri/src/proxy_chain/readiness.rs
new file mode 100644
index 0000000..3fb357b
--- /dev/null
+++ b/src-tauri/src/proxy_chain/readiness.rs
@@ -0,0 +1,212 @@
+//! A bounded HTTPS response on the prepared proxy is independent of Geo.
+//! Every socket uses that proxy; target names are never resolved directly.
+use super::{
+    connector::{self, ProxyHop, Target},
+    error::ChainError,
+    tls,
+    tunnel::Tunnel,
+};
+use crate::space::proxy::{ProxyEntry, ProxyKind};
+use http_body_util::{BodyExt, Empty};
+use hyper::{body::Bytes, Request, StatusCode};
+use hyper_util::rt::TokioIo;
+use std::{
+    sync::Arc,
+    time::{Duration, Instant},
+};
+
+const TOTAL_BUDGET: Duration = Duration::from_secs(6);
+const TARGET_BUDGET: Duration = Duration::from_secs(3);
+const MAX_BODY: usize = 64 * 1024;
+const TARGETS: [&str; 2] = ["https://example.com/", "https://example.org/"];
+
+fn unavailable() -> ChainError {
+    ChainError::new("proxy_chain_profile_geo_failed","exit","The exit lookup failed and this same proxy route did not return a verified HTTPS response.")
+}
+
+struct ConnectionTask(tokio::task::JoinHandle<()>);
+impl Drop for ConnectionTask {
+    fn drop(&mut self) {
+        self.0.abort();
+    }
+}
+
+pub(crate) async fn verify(entry: &ProxyEntry, tunnel: &Tunnel) -> Result<u128, ChainError> {
+    verify_with_content(entry, tunnel)
+        .await
+        .map(|(elapsed, _)| elapsed)
+}
+
+pub(crate) async fn verify_with_content(
+    entry: &ProxyEntry,
+    tunnel: &Tunnel,
+) -> Result<(u128, u64), ChainError> {
+    let start = Instant::now();
+    let (targets, config) = configuration()?;
+    let hop = ProxyHop {
+        kind: match entry.kind {
+            ProxyKind::Http => connector::ProxyKind::Http,
+            ProxyKind::Https => connector::ProxyKind::Https,
+            ProxyKind::Socks5 => connector::ProxyKind::Socks5,
+        },
+        host: entry.host.clone(),
+        port: entry.port,
+        username: entry.username.clone(),
+        password: entry.password.clone(),
+    };
+    tokio::time::timeout(TOTAL_BUDGET, async {
+        for url in targets {
+            match tokio::time::timeout(TARGET_BUDGET, one(&hop, &url, config.clone())).await {
+                Ok(Ok(bytes)) => return Ok((start.elapsed().as_millis(), bytes)),
+                Ok(Err(error))
+                    if matches!(
+                        error.code,
+                        "proxy_chain_profile_auth_failed" | "system_proxy_auth_failed"
+                    ) =>
+                {
+                    return Err(error)
+                }
+                _ => {
+                    // A system relay may give its local client a generic
+                    // failure after publishing the actual first-hop refusal.
+                    // Never hide or retry that authentication failure.
+                    if let Some(error) = authentication_failure(tunnel) {
+                        return Err(error);
+                    }
+                    tunnel.finish_probe_flows().await?;
+                }
+            }
+        }
+        Err(unavailable())
+    })
+    .await
+    .map_err(|_| authentication_failure(tunnel).unwrap_or_else(unavailable))?
+}
+
+fn authentication_failure(tunnel: &Tunnel) -> Option<ChainError> {
+    tunnel.last_error().filter(|error| {
+        matches!(
+            error.code,
+            "proxy_chain_profile_auth_failed" | "system_proxy_auth_failed"
+        )
+    })
+}
+
+async fn one(
+    hop: &ProxyHop,
+    url: &str,
+    config: Arc<rustls::ClientConfig>,
+) -> Result<u64, ChainError> {
+    let url = url::Url::parse(url).map_err(|_| unavailable())?;
+    if url.scheme() != "https" || !url.username().is_empty() || url.password().is_some() {
+        return Err(unavailable());
+    }
+    let host = url.host_str().ok_or_else(unavailable)?;
+    let target = Target::new(host, url.port_or_known_default().ok_or_else(unavailable)?)?;
+    let stream = connector::connect_with_timeout(hop, &target, TARGET_BUDGET)
+        .await
+        .map_err(|mut error| {
+            // This hop is the prepared local endpoint, whose authentication is the
+            // original assigned proxy's. A parsed refusal remains authoritative.
+            if error.code == "system_proxy_auth_failed" {
+                error.code = "proxy_chain_profile_auth_failed";
+                error.layer = "profile";
+            }
+            error
+        })?;
+    let name =
+        rustls::pki_types::ServerName::try_from(host.to_owned()).map_err(|_| unavailable())?;
+    let secure = tokio_rustls::TlsConnector::from(config)
+        .connect(name, stream)
+        .await
+        .map_err(|_| unavailable())?;
+    let (mut sender, connection) = hyper::client::conn::http1::Builder::new()
+        .max_buf_size(16 * 1024)
+        .handshake::<_, Empty<Bytes>>(TokioIo::new(secure))
+        .await
+        .map_err(|_| unavailable())?;
+    let _connection = ConnectionTask(tokio::spawn(async move {
+        let _ = connection.await;
+    }));
+    let mut path = url.path().to_owned();
+    if path.is_empty() {
+        path.push('/');
+    }
+    if let Some(query) = url.query() {
+        path.push('?');
+        path.push_str(query);
+    }
+    let authority = if let Some(port) = url.port() {
+        format!("{host}:{port}")
+    } else {
+        host.to_owned()
+    };
+    let request = Request::builder()
+        .method("GET")
+        .uri(path)
+        .header("Host", authority)
+        .header("Connection", "close")
+        .body(Empty::<Bytes>::new())
+        .map_err(|_| unavailable())?;
+    let response = sender
+        .send_request(request)
+        .await
+        .map_err(|_| unavailable())?;
+    if response.status() != StatusCode::OK {
+        return Err(unavailable());
+    }
+    if response
+        .headers()
+        .get(hyper::header::CONTENT_LENGTH)
+        .and_then(|value| value.to_str().ok())
+        .and_then(|value| value.parse::<u64>().ok())
+        .is_some_and(|size| size > MAX_BODY as u64)
+    {
+        return Err(unavailable());
+    }
+    let mut body = response.into_body();
+    let mut bytes = 0usize;
+    while let Some(frame) = body.frame().await {
+        let frame = frame.map_err(|_| unavailable())?;
+        if let Some(data) = frame.data_ref() {
+            bytes = bytes.checked_add(data.len()).ok_or_else(unavailable)?;
+            if bytes > MAX_BODY {
+                return Err(unavailable());
+            }
+        }
+    }
+    if bytes == 0 {
+        return Err(unavailable());
+    }
+    Ok(bytes as u64)
+}
+
+fn configuration() -> Result<(Vec<String>, Arc<rustls::ClientConfig>), ChainError> {
+    #[cfg(test)]
+    if let Some(value) = TEST_CONFIGURATION.with(|value| value.borrow().clone()) {
+        return Ok(value);
+    }
+    Ok((
+        TARGETS.iter().map(|target| (*target).to_owned()).collect(),
+        tls::client()?,
+    ))
+}
+
+#[cfg(test)]
+thread_local! {static TEST_CONFIGURATION:std::cell::RefCell<Option<(Vec<String>,Arc<rustls::ClientConfig>)>>=const{std::cell::RefCell::new(None)};}
+
+#[cfg(test)]
+pub(super) struct TestConfiguration(Option<(Vec<String>, Arc<rustls::ClientConfig>)>);
+#[cfg(test)]
+impl Drop for TestConfiguration {
+    fn drop(&mut self) {
+        TEST_CONFIGURATION.with(|value| *value.borrow_mut() = self.0.take());
+    }
+}
+#[cfg(test)]
+pub(super) fn test_configuration(
+    targets: Vec<String>,
+    config: Arc<rustls::ClientConfig>,
+) -> TestConfiguration {
+    TestConfiguration(TEST_CONFIGURATION.with(|value| value.replace(Some((targets, config)))))
+}
diff --git a/src-tauri/src/proxy_chain/readiness_tests.rs b/src-tauri/src/proxy_chain/readiness_tests.rs
new file mode 100644
index 0000000..710504b
--- /dev/null
+++ b/src-tauri/src/proxy_chain/readiness_tests.rs
@@ -0,0 +1,558 @@
+//! Owned loopback proxies and trusted local TLS pages; no public traffic.
+use super::{
+    connector::{ProxyHop, ProxyKind as HopKind, Target},
+    readiness, PreparedProxy, Route,
+};
+use crate::space::proxy::ProxyEntry;
+use base64::{engine::general_purpose::STANDARD, Engine as _};
+use serde_json::json;
+use std::{
+    net::SocketAddr,
+    sync::{
+        atomic::{AtomicUsize, Ordering},
+        Arc,
+    },
+    time::Duration,
+};
+use tokio::{
+    io::{AsyncRead, AsyncReadExt, AsyncWriteExt},
+    net::{TcpListener, TcpStream},
+    task::{JoinHandle, JoinSet},
+};
+
+const HOST: &str = "readiness.synthetic.test";
+const USER: &str = "readiness-synthetic";
+const PASSWORD: &str = "readiness synthetic password";
+const BODY: &str =
+    "<!doctype html><title>Ready</title><main>Actual same-route HTTPS content</main>";
+
+#[derive(Default)]
+struct Counts {
+    geo: AtomicUsize,
+    content: AtomicUsize,
+    pages: AtomicUsize,
+    auth_challenges: AtomicUsize,
+    accepted: AtomicUsize,
+    active: AtomicUsize,
+}
+struct Active(Arc<Counts>);
+impl Drop for Active {
+    fn drop(&mut self) {
+        self.0.active.fetch_sub(1, Ordering::SeqCst);
+    }
+}
+struct Service {
+    addr: SocketAddr,
+    counts: Arc<Counts>,
+    task: JoinHandle<()>,
+}
+impl Drop for Service {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+
+#[derive(Clone)]
+struct Options {
+    tls: Arc<rustls::ServerConfig>,
+    geo_refuses_auth: bool,
+    probe_refuses: bool,
+    content_status: u16,
+    content_body: &'static str,
+    chain_refusal: Option<SocketAddr>,
+}
+
+async fn head(stream: &mut (impl AsyncRead + Unpin)) -> std::io::Result<String> {
+    let mut bytes = Vec::new();
+    while !bytes.ends_with(b"\r\n\r\n") && bytes.len() < 16384 {
+        bytes.push(stream.read_u8().await?);
+    }
+    Ok(String::from_utf8_lossy(&bytes).into_owned())
+}
+
+async fn response(stream: &mut TcpStream, status: u16) -> std::io::Result<()> {
+    stream
+        .write_all(
+            format!("HTTP/1.1 {status} Fixture\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
+                .as_bytes(),
+        )
+        .await
+}
+
+fn tls_config(cert_host: &str) -> (Arc<rustls::ServerConfig>, Arc<rustls::ClientConfig>) {
+    let generated = rcgen::generate_simple_self_signed(vec![cert_host.into()]).unwrap();
+    let cert = generated.cert.der().clone();
+    let provider = Arc::new(rustls::crypto::ring::default_provider());
+    let server = rustls::ServerConfig::builder_with_provider(provider.clone())
+        .with_safe_default_protocol_versions()
+        .unwrap()
+        .with_no_client_auth()
+        .with_single_cert(
+            vec![cert.clone()],
+            rustls::pki_types::PrivatePkcs8KeyDer::from(generated.key_pair.serialize_der()).into(),
+        )
+        .unwrap();
+    let mut roots = rustls::RootCertStore::empty();
+    roots.add(cert).unwrap();
+    let client = rustls::ClientConfig::builder_with_provider(provider)
+        .with_safe_default_protocol_versions()
+        .unwrap()
+        .with_root_certificates(roots)
+        .with_no_client_auth();
+    (Arc::new(server), Arc::new(client))
+}
+
+fn options(tls: Arc<rustls::ServerConfig>) -> Options {
+    Options {
+        tls,
+        geo_refuses_auth: false,
+        probe_refuses: false,
+        content_status: 200,
+        content_body: BODY,
+        chain_refusal: None,
+    }
+}
+
+async fn service(options: Options) -> Service {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    let counts = Arc::new(Counts::default());
+    let record = counts.clone();
+    let task = tokio::spawn(async move {
+        let mut clients = JoinSet::new();
+        loop {
+            tokio::select! {
+                _=clients.join_next(),if !clients.is_empty()=>{},
+                accepted=listener.accept()=>{
+                    let Ok((mut stream,_))=accepted else {break;};
+                    record.accepted.fetch_add(1,Ordering::SeqCst);record.active.fetch_add(1,Ordering::SeqCst);
+                    let counts=record.clone();let options=options.clone();
+                    clients.spawn(async move {
+                        let _active=Active(counts.clone());
+                        let Ok(request)=head(&mut stream).await else {return;};
+                        let authorization=format!("Basic {}",STANDARD.encode(format!("{USER}:{PASSWORD}")));
+                        if !request.lines().any(|line|line.split_once(':').is_some_and(|(name,value)|name.eq_ignore_ascii_case("Proxy-Authorization")&&value.trim()==authorization)) {
+                            counts.auth_challenges.fetch_add(1,Ordering::SeqCst);
+                            let _=stream.write_all(b"HTTP/1.1 407 Proxy Authentication Required\r\nProxy-Authenticate: Basic realm=\"Readiness fixture\"\r\nContent-Length: 0\r\nConnection: close\r\n\r\n").await;
+                            return;
+                        }
+                        if options.chain_refusal.is_some_and(|target|request.starts_with(&format!("CONNECT {target} "))) {
+                            let _=response(&mut stream,502).await;return;
+                        }
+                        if request.starts_with(&format!("GET http://{HOST}/page ")) {
+                            counts.pages.fetch_add(1,Ordering::SeqCst);
+                            let _=stream.write_all(format!("HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nContent-Length: {}\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n{BODY}", BODY.len()).as_bytes()).await;
+                            return;
+                        }
+                        if request.starts_with("CONNECT example.com:443 ") {
+                            let _=response(&mut stream,if options.probe_refuses{502}else{200}).await;return;
+                        }
+                        if request.starts_with(&format!("CONNECT {HOST}:443 ")) {
+                            counts.content.fetch_add(1,Ordering::SeqCst);
+                            if stream.write_all(b"HTTP/1.1 200 Connection established\r\n\r\n").await.is_err(){return;}
+                            let Ok(mut secure)=tokio_rustls::TlsAcceptor::from(options.tls).accept(&mut stream).await else {return;};
+                            let Ok(request)=head(&mut secure).await else {return;};
+                            assert!(request.starts_with("GET /health HTTP/1.1\r\n"));
+                            let location=if options.content_status==302{"Location: https://redirect.synthetic.test/\r\n"}else{""};
+                            let _=secure.write_all(format!("HTTP/1.1 {} Fixture\r\nContent-Type: text/html\r\nContent-Length: {}\r\n{location}Connection: close\r\n\r\n{}",options.content_status,options.content_body.len(),options.content_body).as_bytes()).await;
+                            let _=secure.shutdown().await;return;
+                        }
+                        if request.starts_with("CONNECT ip-api.com:80 ") {
+                            counts.geo.fetch_add(1,Ordering::SeqCst);
+                            if options.geo_refuses_auth {let _=response(&mut stream,407).await;return;}
+                            if stream.write_all(b"HTTP/1.1 200 Connection established\r\n\r\n").await.is_err(){return;}
+                            let Ok(request)=head(&mut stream).await else {return;};
+                            assert!(request.starts_with("GET /json/?fields="));
+                        } else {
+                            if request.starts_with("CONNECT ") {let _=response(&mut stream,502).await;return;}
+                            counts.geo.fetch_add(1,Ordering::SeqCst);
+                            if options.geo_refuses_auth {let _=response(&mut stream,407).await;return;}
+                        }
+                        let body=r#"{"status":"fail","message":"synthetic Geo service unavailable"}"#;
+                        let _=stream.write_all(format!("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}",body.len()).as_bytes()).await;
+                    });
+                }
+            }
+        }
+    });
+    Service { addr, counts, task }
+}
+
+fn entry(service: &Service) -> ProxyEntry {
+    serde_json::from_value(json!({"id":"readiness-assigned","name":"Synthetic readiness proxy","kind":"http","host":service.addr.ip().to_string(),"port":service.addr.port(),"username":USER,"password":PASSWORD})).unwrap()
+}
+
+async fn prepared(entry: &ProxyEntry) -> PreparedProxy {
+    let tunnel = super::Tunnel::bind_assigned(Target::new(&entry.host, entry.port).unwrap(), None)
+        .await
+        .unwrap();
+    PreparedProxy {
+        effective: super::effective_entry(entry, &tunnel),
+        tunnel,
+        route: Route::ExplicitProxy,
+        first_hop_error: None,
+        verified_geo: None,
+        verified_https: false,
+        verified_content_bytes: None,
+        geo_failure: None,
+        verified_tcp_ms: None,
+    }
+}
+
+fn configure(client: Arc<rustls::ClientConfig>) -> readiness::TestConfiguration {
+    crate::settings::save(&crate::settings::Settings {
+        geo_checker: Some("ip-api.com".into()),
+        ..Default::default()
+    })
+    .unwrap();
+    readiness::test_configuration(vec![format!("https://{HOST}/health")], client)
+}
+
+async fn cleanup(prepared: PreparedProxy, service: &Service) {
+    let addr = prepared.tunnel.addr();
+    prepared.tunnel.shutdown().await;
+    assert!(TcpStream::connect(addr).await.is_err());
+    tokio::time::timeout(Duration::from_secs(2), async {
+        while service.counts.active.load(Ordering::SeqCst) != 0 {
+            tokio::time::sleep(Duration::from_millis(5)).await;
+        }
+    })
+    .await
+    .unwrap();
+}
+
+#[cfg(feature = "automation")]
+#[tokio::test]
+#[ignore = "requires SHARDX_TEST_BROWSER and an isolated test process"]
+async fn sequential_real_engine_reads_body_through_two_hops_and_releases_listener(
+) -> anyhow::Result<()> {
+    use crate::{process::Tracker, sequential, space};
+    let browser = std::env::var("SHARDX_TEST_BROWSER")?;
+    let _root = crate::store::test_root("sequential-chain");
+    let (server, client) = tls_config(HOST);
+    let _config = configure(client);
+    let mut settings = crate::settings::load()?;
+    settings.browser_path = Some(browser);
+    settings.extra_args = "--start-minimized --disable-gpu".into();
+    crate::settings::save(&settings)?;
+
+    let second = service(options(server)).await;
+    let first = TcpListener::bind("127.0.0.1:0").await?;
+    let first_addr = first.local_addr()?;
+    let second_addr = second.addr;
+    let relay = tokio::spawn(async move {
+        let mut flows = JoinSet::new();
+        loop {
+            tokio::select! {
+                _ = flows.join_next(), if !flows.is_empty() => {}
+                accepted = first.accept() => {
+                    let Ok((mut incoming, _)) = accepted else { break; };
+                    flows.spawn(async move {
+                        let Ok(header) = head(&mut incoming).await else { return; };
+                        if !header.starts_with(&format!("CONNECT {second_addr} ")) {
+                            let _ = response(&mut incoming, 502).await;
+                            return;
+                        }
+                        let Ok(mut outgoing) = TcpStream::connect(second_addr).await else { return; };
+                        if incoming.write_all(b"HTTP/1.1 200 Connection established\r\n\r\n").await.is_ok() {
+                            let _ = tokio::io::copy_bidirectional(&mut incoming, &mut outgoing).await;
+                        }
+                    });
+                }
+            }
+        }
+    });
+    let result = async {
+        let ticket = space::ticket(None)?;
+        let second_proxy = space::proxy::upsert(space::Door("proxy_save"), &ticket, entry(&second)).await?;
+        let mut first_proxy = second_proxy.clone();
+        first_proxy.id = "sequential-first".into();
+        first_proxy.port = first_addr.port();
+        first_proxy.username.clear();
+        first_proxy.password.clear();
+        let first_proxy = space::proxy::upsert(space::Door("proxy_save"), &ticket, first_proxy).await?;
+        let mut profile = space::profile::StoredProfile::default();
+        profile.meta.id = uuid::Uuid::new_v4().to_string();
+        profile.meta.proxy_id = Some(second_proxy.id);
+        profile.meta.proxy_route = Some(serde_json::from_value(json!({
+            "mode": "chain", "first": {"mode": "proxy", "proxy_id": first_proxy.id}, "second": {"mode": "proxy"}
+        }))?);
+        profile.config.insert("name".into(), json!("001"));
+        space::profile::save_raw(&mut profile)?;
+        sequential::sequential_start(sequential::Config {
+            start: 1,
+            end: 1,
+            url: format!("http://{HOST}/page"),
+            wait_seconds: 5,
+        }).await.map_err(anyhow::Error::msg)?;
+        tokio::time::timeout(Duration::from_secs(100), async {
+            while sequential::active() && !sequential::status().phase.starts_with("waiting") {
+                tokio::time::sleep(Duration::from_millis(25)).await;
+            }
+        }).await?;
+        let tracker = Tracker::shared();
+        let addr = tracker.chain_address(&profile.meta.id)
+            .ok_or_else(|| anyhow::anyhow!(
+                "no active protected tunnel (origin pages: {}, TLS attempts: {}, connections: {}, auth challenges: {}): {:?}",
+                second.counts.pages.load(Ordering::SeqCst),
+                second.counts.content.load(Ordering::SeqCst),
+                second.counts.accepted.load(Ordering::SeqCst),
+                second.counts.auth_challenges.load(Ordering::SeqCst),
+                sequential::status()
+            ))?;
+        assert!(tracker.cdp(&profile.meta.id).is_none());
+        anyhow::ensure!(second.counts.pages.load(Ordering::SeqCst) > 0, "browser page did not use the second hop");
+        assert!(second.counts.content.load(Ordering::SeqCst) > 0);
+        tokio::time::timeout(Duration::from_secs(30), async {
+            while sequential::active() {
+                tokio::time::sleep(Duration::from_millis(25)).await;
+            }
+        }).await?;
+        let outcome = sequential::status();
+        anyhow::ensure!(outcome.completed == 1 && outcome.failed == 0, "sequence failed: {outcome:?}");
+        assert!(tracker.is_idle());
+        assert!(TcpStream::connect(addr).await.is_err());
+        Ok(())
+    }.await;
+    let stopped = sequential::stop_and_wait().await;
+    relay.abort();
+    result.and(stopped)
+}
