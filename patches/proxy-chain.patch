@@ -0,0 +1,43 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { proxyReadyWithUnknownGeo, proxyStatus } from "./status.ts";
+import type { ProxyTestSnapshot } from "../model/types.ts";
+
+const snapshot = (extra: Partial<ProxyTestSnapshot>): ProxyTestSnapshot => ({
+  first_seen: "@1", last_seen: "@1", ip: "", country_code: "", country: "", region: "", city: "", isp: "",
+  timezone: "", latitude: 0, longitude: 0, tcp_ms: null, udp_ms: null, udp_error: null, geo_error: null, provider: "", content: { status: "passed", http_status: 200, bytes: 128 }, ...extra,
+});
+const syntheticError = "safe failure";
+
+test("chain readiness requires both a real probe and live exit without a layer error", () => {
+  assert.equal(proxyStatus(snapshot({ transport: "proxy_chain", tcp_ms: 1, ip: "203.0.113.1" })), "ok");
+  assert.equal(proxyStatus(snapshot({ transport: "proxy_chain", tcp_ms: 1, geo_error: "safe failure" })), "failed");
+  assert.equal(proxyStatus(snapshot({ transport: "proxy_chain", ip: "203.0.113.1", chain_error: { code: "proxy_chain_profile_connect_failed", layer: "profile", message: syntheticError } })), "failed");
+  assert.equal(proxyStatus(snapshot({ transport: "proxy_chain", ip: "203.0.113.1" })), "failed");
+});
+
+test("non-chain current snapshots require a verified response body", () => {
+  assert.equal(proxyStatus(snapshot({ content: undefined, tcp_ms: 1 })), "failed");
+  assert.equal(proxyStatus(snapshot({ content: undefined, ip: "203.0.113.1" })), "failed");
+  assert.equal(proxyStatus(snapshot({ content: { status: "unknown" }, tcp_ms: 1 })), "failed");
+  assert.equal(proxyStatus(snapshot({ content: undefined })), "failed");
+  assert.equal(proxyStatus(undefined), "untested");
+});
+
+test("unknown Geo stays usable only with an explicit current route proof", () => {
+  const ready = snapshot({ transport: "proxy_chain", tcp_ms: 17, geo_error: syntheticError,
+    chain_error: { code: "proxy_chain_profile_geo_failed", layer: "exit", message: syntheticError, route_ready: true }, content: { status: "passed", http_status: 200, bytes: 128 } });
+  assert.equal(proxyStatus(ready), "ok");
+  assert.equal(proxyReadyWithUnknownGeo(ready), true);
+  for (const extra of [
+    { chain_error: { ...ready.chain_error!, route_ready: undefined } },
+    { chain_error: { ...ready.chain_error!, route_ready: false } },
+    { chain_error: { ...ready.chain_error!, code: "proxy_chain_profile_auth_failed" } },
+    { chain_error: { ...ready.chain_error!, layer: "profile" } },
+    { tcp_ms: null }, { tcp_ms: -1 }, { tcp_ms: Number.NaN },
+  ]) {
+    const invalid = { ...ready, ...extra };
+    assert.equal(proxyReadyWithUnknownGeo(invalid), false);
+    assert.equal(proxyStatus(invalid), "failed");
+  }
+});
diff --git a/src/entities/proxy/lib/status.ts b/src/entities/proxy/lib/status.ts
index 8a35492..d37a0d8 100644
--- a/src/entities/proxy/lib/status.ts
+++ b/src/entities/proxy/lib/status.ts
@@ -9,9 +9,22 @@ import type { ProxyTestSnapshot } from "../model/types";
 /// does — the old test called a proxy reached as soon as it had greeted us,
 /// so a gateway with a dead upstream, no traffic left or a banned address
 /// read as working.
+export function proxyReadyWithUnknownGeo(snap: ProxyTestSnapshot | undefined): boolean {
+  return snap?.transport === "proxy_chain" && snap.chain_error?.route_ready === true
+    && snap.chain_error.code === "proxy_chain_profile_geo_failed" && snap.chain_error.layer === "exit"
+    && snap.tcp_ms != null && Number.isFinite(snap.tcp_ms) && snap.tcp_ms >= 0 && !snap.ip;
+}
+
 export function proxyStatus(snap: ProxyTestSnapshot | undefined): "ok" | "failed" | "untested" {
   if (!snap) return "untested";
-  return snap.tcp_ms != null || snap.ip !== "" ? "ok" : "failed";
+  // Only an explicit current readiness proof can keep unknown Geo usable.
+  // Older partial results must not be inferred ready from their TCP time.
+  if (proxyReadyWithUnknownGeo(snap) && snap.content?.status === "passed") return "ok";
+  // A transport or Geo response alone is insufficient. Green means the same
+  // route also returned a readable target body; old history stays unverified.
+  if (snap.content?.status !== "passed") return "failed";
+  if (snap.transport === "proxy_chain" && (snap.chain_error || snap.geo_error || snap.tcp_ms == null || !snap.ip)) return "failed";
+  return "ok";
