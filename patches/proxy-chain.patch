+        let before = serde_json::to_value(proxy).unwrap();
+        let prepared = super::prepare_with_hop(
+            proxy,
+            ProxyHop {
+                kind: ProxyKind::Http,
+                host: a.addr.ip().to_string(),
+                port: a.addr.port(),
+                username: String::new(),
+                password: String::new(),
