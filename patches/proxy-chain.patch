+type Result<T> = std::result::Result<T, &'static str>;
+
+#[derive(Deserialize)]
+struct LiveInput {
+    #[serde(default = "default_kind")]
+    kind: String,
+    host: String,
+    port: u16,
+    username: String,
+    password: String,
+    system_host: String,
+    system_port: u16,
+}
+fn default_kind() -> String { "socks5".into() }
+
+#[derive(Serialize)]
+struct Exit {
+    exit_ip: String,
+    exit_geo: Geo,
+    exit_ip_matches_geo_ip: bool,
+}
+
+#[derive(Serialize)]
+struct Geo {
+    ip: String,
+    country: String,
+    country_code: String,
+    region: String,
+    city: String,
+    provider: String,
+}
+
+#[derive(Serialize)]
+struct ModeReport {
+    first_hop: &'static str,
+    system_exit: Option<Exit>,
+    profile_exit: Option<Exit>,
+    system_and_profile_ips_differ: bool,
+}
