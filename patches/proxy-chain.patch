+  if (snap.transport === "proxy_chain" && (snap.chain_error || snap.geo_error || snap.tcp_ms == null || !snap.ip)) return "failed";
   return snap.tcp_ms != null || snap.ip !== "" ? "ok" : "failed";
 }
 
