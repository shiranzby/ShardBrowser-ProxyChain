+fn config(addr: SocketAddr, mode: &str) -> ProxyChainSettings {
+    ProxyChainSettings {
+        enabled: true,
+        mode: mode.into(),
+        host: addr.ip().to_string(),
+        port: addr.port(),
+        username: FIRST_USER.into(),
+        password: PasswordUpdate::Replace(FIRST_PASS.into()),
+        ..Default::default()
+    }
+}
