+    fs::copy(&path, &backup)
+        .with_context(|| format!("backup fingerprint {}", path.display()))?;
+    let tmp = path.with_extension("json.tmp");
+    let serialized = serde_json::to_string_pretty(&current)?;
+    if let Err(error) = fs::write(&tmp, serialized) {
