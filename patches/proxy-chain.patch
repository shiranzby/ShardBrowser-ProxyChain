+#[tokio::test]
+async fn same_exit_chain_keeps_serving_tls_website_content_after_assigned_direct_stops_working() {
+    let _root = crate::store::test_root("same-exit-website-after-direct-failure");
+    preferred_geo();
+    let (server, client) = website_tls();
+    let mut leaf = Leaf::second("198.51.100.104");
+    leaf.website = Some(server);
+    let second = service(leaf.clone(), None, false).await;
+    let first = service(
+        Leaf::first(leaf.ip),
+        Some((second.addr, Chain::Inline(leaf))),
+        false,
+    )
+    .await;
+    let assigned = entry(second.addr);
+    let original = serde_json::to_value(&assigned).unwrap();
+    // A successful direct check must not let a later healthy chain be replaced
+    // with a new assigned-proxy connection that may no longer be reachable.
+    assert_eq!(
+        crate::space::proxy::geo_check_on_route(Some(&assigned), None)
+            .await
+            .unwrap()
+            .ip,
+        "198.51.100.104"
+    );
+    let direct_before = second.counts.accepted.load(Ordering::SeqCst);
+    let prepared = super::prepare_checked_chain(&assigned, hop(&first))
+        .await
+        .unwrap();
+    assert_eq!(prepared.route, Route::FirstHop);
+    assert_eq!(
+        second.counts.accepted.load(Ordering::SeqCst),
+        direct_before,
+        "healthy preparation cannot dial the assigned endpoint directly"
+    );
+    second.reject_direct.store(true, Ordering::SeqCst);
+    assert!(
+        website(&assigned, client.clone()).await.is_err(),
+        "the independent assigned path must now be unavailable"
+    );
+    let direct_after = second.counts.accepted.load(Ordering::SeqCst);
+    let chained_before = first.counts.chained.load(Ordering::SeqCst);
+    for _ in 0..2 {
+        let response = website(&prepared.effective, client.clone()).await.unwrap();
+        assert!(response.starts_with("HTTP/1.1 200 OK\r\n"));
+        assert!(response.ends_with(WEBSITE_BODY));
+    }
+    assert_eq!(
+        first.counts.chained.load(Ordering::SeqCst),
+        chained_before + 2,
+        "each new website flow must retain the first hop"
+    );
+    assert_eq!(first.counts.websites.load(Ordering::SeqCst), 2);
+    assert_eq!(
+        second.counts.accepted.load(Ordering::SeqCst),
+        direct_after,
+        "website traffic must not retry the unavailable direct assigned path"
+    );
+    assert_eq!(serde_json::to_value(&assigned).unwrap(), original);
+    shutdown(prepared).await;
+    wait_no_clients(&first).await;
+    wait_no_clients(&second).await;
+}
