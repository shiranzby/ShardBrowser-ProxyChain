+import test from "node:test";
+import assert from "node:assert/strict";
+import { protocolCapabilities, proxyCheckSummary } from "./capabilities.ts";
+import type { ProxyTestSnapshot } from "../model/types.ts";
+
+test("SOCKS5 is not TLS just because a destination uses HTTPS", () => {
+  assert.equal(protocolCapabilities("socks5").socks5, true);
+  assert.equal(protocolCapabilities("socks5").https, false);
+  assert.equal(protocolCapabilities("socks5").socks5_tls, false);
+  assert.equal(protocolCapabilities("https").https, true);
+  assert.equal(protocolCapabilities("https").connect, true);
+  assert.equal(protocolCapabilities("http").https, false);
+});
+
+test("proxy check summary keeps failure stage and legacy evidence limits", () => {
+  assert.deepEqual(proxyCheckSummary(null), { stage: "untested", state: "unverified" });
+  const snapshot = { tcp_ms: 1, ip: "", geo_error: null } as ProxyTestSnapshot;
+  assert.deepEqual(proxyCheckSummary(snapshot), { stage: "content", state: "unverified" });
+  assert.deepEqual(proxyCheckSummary({ ...snapshot, content: { status: "failed", error: "body" } }), { stage: "content", state: "failed" });
+  assert.deepEqual(proxyCheckSummary({ ...snapshot, ip: "203.0.113.7", content: { status: "passed", http_status: 200, bytes: 128 } }), { stage: "exit", state: "passed" });
+  assert.deepEqual(proxyCheckSummary({ ...snapshot, chain_error: { code: "proxy_chain_profile_auth_failed", layer: "profile", message: "" } }), { stage: "authentication", state: "failed" });
+  assert.deepEqual(proxyCheckSummary({ ...snapshot, chain_error: { code: "proxy_chain_profile_geo_failed", layer: "exit", message: "", route_ready: true } }), { stage: "exit", state: "failed" });
+});
diff --git a/src/entities/proxy/lib/capabilities.ts b/src/entities/proxy/lib/capabilities.ts
new file mode 100644
index 0000000..ad2ef94
--- /dev/null
+++ b/src/entities/proxy/lib/capabilities.ts
@@ -0,0 +1,37 @@
+import type { ProxyCapabilities, ProxyEntry, ProxyTestSnapshot } from "../model/types";
+
+/** A transport promise, never inferred from the destination website's scheme. */
+export function protocolCapabilities(kind: ProxyEntry["kind"]): ProxyCapabilities {
+  return {
+    http: kind === "http",
+    https: kind === "https",
+    socks5: kind === "socks5",
+    socks5_tls: false,
+    connect: kind === "http" || kind === "https",
+  };
+}
+
+export type ProxyCheckStage = "untested" | "configuration" | "tcp" | "tls" | "authentication" | "target" | "content" | "exit";
+export type ProxyCheckSummary = { stage: ProxyCheckStage; state: "unverified" | "failed" | "passed" };
+
+/** Old history is deliberately weaker evidence than a current verified route. */
+export function proxyCheckSummary(snapshot: ProxyTestSnapshot | null | undefined): ProxyCheckSummary {
+  if (!snapshot) return { stage: "untested", state: "unverified" };
+  const error = snapshot.chain_error;
+  if (error) {
+    const code = error.code;
+    if (error.route_ready) return { stage: "exit", state: "failed" };
+    if (/auth|credential/.test(code)) return { stage: "authentication", state: "failed" };
+    if (/tls|certificate/.test(code)) return { stage: "tls", state: "failed" };
+    if (/config|manual_required|windows_required/.test(code)) return { stage: "configuration", state: "failed" };
+    if (/connect|timeout|unavailable/.test(code)) return { stage: "tcp", state: "failed" };
+    return { stage: "target", state: "failed" };
+  }
+  if (snapshot.content?.status === "failed") return { stage: "content", state: "failed" };
+  if (snapshot.content?.status !== "passed") return { stage: "content", state: "unverified" };
+  if (snapshot.geo_error) return { stage: "exit", state: "failed" };
+  if (snapshot.tcp_ms == null) return { stage: "tcp", state: "failed" };
+  // Existing successful observations prove the proxy exchange and Geo response;
+  // they do not prove a browser rendered an arbitrary page or UDP/IPv6 support.
+  return { stage: "exit", state: snapshot.ip ? "passed" : "unverified" };
+}
