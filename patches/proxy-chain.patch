+        resolved
+            .lock()
+            .unwrap()
+            .iter()
+            .map(|t| t.host.clone())
+            .collect::<Vec<_>>(),
+        ["first-destination.invalid", "other-destination.invalid"]
+    );
+    assert!(requests.lock().unwrap()[1].starts_with("CONNECT other-destination.invalid:443 "));
+    let mut udp = TcpStream::connect(tunnel.addr()).await.unwrap();
