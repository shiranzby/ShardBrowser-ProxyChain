+++ b/src-tauri/src/startup_page.rs
@@ -0,0 +1,69 @@
+//! A local, tabs-only bootstrap reuses a restored startup tab without a CDP port.
+use anyhow::{Context, Result};
+use std::path::{Path, PathBuf};
+
+pub const ID: &str = "cdaadhlkdbidpoihgpljlkjkhhpccbih";
+const KEY: &str = "";
+const HTML: &str = r#"<!doctype html><html><head><meta charset="utf-8"><title>ShardBrowser</title></head><body><p id="status">正在检查启动标签… / Checking startup tabs…</p><button id="retry" hidden>重试 / Retry</button><script src="config.js"></script><script type="module" src="start.js"></script></body></html>"#;
+
+pub fn url() -> String { format!("chrome-extension://{ID}/start.html") }
+
+pub fn is_installed(udd: &Path) -> bool { udd.join(".shardbrowser-startup").exists() }
+
+pub fn configured(config: &serde_json::Map<String, serde_json::Value>) -> Option<&str> {
+    config.get("startup_url").and_then(|v| v.as_str()).map(str::trim).filter(|s| !s.is_empty())
+}
+
+pub fn install(udd: &Path, target: Option<&str>) -> Result<Option<PathBuf>> {
+    let dir = udd.join(".shardbrowser-startup");
+    if let Some(target) = target { crate::profile_defaults::validate_startup_url(target)?; }
+    if target.is_none() && !dir.exists() { return Ok(None); }
+    std::fs::create_dir_all(&dir).context("prepare startup tab helper")?;
+    let manifest = serde_json::json!({
+        "manifest_version":3,"name":"ShardBrowser startup tab","version":"1.0.0","key":KEY,
+        "permissions":["tabs"],"content_security_policy":{"extension_pages":"script-src 'self'; object-src 'none'; connect-src 'none'"}
+    });
+    // No target URL enters HTML or executable code: JSON is an external data assignment.
+    let config = format!("globalThis.SHARD_STARTUP_URL = {};\n", serde_json::to_string(&target)?);
+    for (name, content) in [
+        ("manifest.json", serde_json::to_string(&manifest)?), ("config.js", config),
+        ("start.html", HTML.into()), ("start.js", include_str!("startup_page/start.js").into()),
+        ("logic.js", include_str!("startup_page/logic.js").into()),
+    ] { std::fs::write(dir.join(name), content).context("write startup tab helper")?; }
+    // Command-line extensions are not reloaded from Chromium's preferences.
+    // Keep loading an existing helper so a crash-restored entry can retire
+    // itself after the preference is cleared; no new entry URL is appended.
+    Ok(Some(dir))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn startup_helper_is_local_and_url_is_data_not_html_or_arguments() {
+        let root = crate::store::test_root("startup-helper");
+        let value = "https://example.com/?q=</script>&next=\"quoted\"#section";
+        let path = install(&root.path, Some(value)).unwrap().unwrap();
+        let manifest: serde_json::Value = serde_json::from_slice(&std::fs::read(path.join("manifest.json")).unwrap()).unwrap();
+        assert_eq!(manifest["permissions"], serde_json::json!(["tabs"]));
+        assert!(manifest.get("host_permissions").is_none());
+        assert!(manifest.get("background").is_none());
+        assert!(!std::fs::read_to_string(path.join("start.html")).unwrap().contains(value));
+        let data = std::fs::read_to_string(path.join("config.js")).unwrap();
+        let value_back: Option<String> = serde_json::from_str(data.trim().strip_prefix("globalThis.SHARD_STARTUP_URL = ").unwrap().trim_end_matches(';')).unwrap();
+        assert_eq!(value_back.as_deref(), Some(value));
+        assert_eq!(url(), format!("chrome-extension://{ID}/start.html"));
+        // Clearing the preference also retires any restored bootstrap from a crash.
+        assert_eq!(install(&root.path, None).unwrap(), Some(path.clone()));
+        assert!(is_installed(&root.path));
+        assert!(std::fs::read_to_string(path.join("config.js")).unwrap().contains("= null;"));
+    }
+    #[test]
+    fn old_profiles_create_no_helper_and_invalid_targets_write_nothing() {
+        let root = crate::store::test_root("startup-helper-empty");
+        assert!(install(&root.path, None).unwrap().is_none());
+        assert!(!root.path.join(".shardbrowser-startup").exists());
+        assert!(install(&root.path, Some("javascript:alert(1)")).is_err());
+        assert!(!root.path.join(".shardbrowser-startup").exists());
+    }
+}
diff --git a/src-tauri/src/startup_page/logic.js b/src-tauri/src/startup_page/logic.js
new file mode 100644
index 0000000..968c612
--- /dev/null
+++ b/src-tauri/src/startup_page/logic.js
@@ -0,0 +1,46 @@
+export function canonical(value) {
+  try { return new URL(value).href; } catch { return null; }
+}
+
+export function isBootstrapTab(tab, bootstrap) {
+  return Boolean(tab && !tab.incognito && tab.url === bootstrap &&
+    (!tab.pendingUrl || tab.pendingUrl === bootstrap));
+}
+
+export function existingTab(tabs, target, ownId) {
+  const wanted = canonical(target);
+  if (!wanted) return undefined;
+  return tabs.filter(tab => tab.id !== ownId && !tab.incognito &&
+    canonical(tab.pendingUrl || tab.url) === wanted)
+    .sort((a, b) => Number(b.active) - Number(a.active) || a.id - b.id)[0];
+}
+
+export async function reuseOrOpen(api, ownId, target, bootstrap) {
+  const own = await api.get(ownId);
+  // A user may have navigated this temporary tab while restore was settling.
+  if (!isBootstrapTab(own, bootstrap)) return "user_navigated";
+  if (!target) {
+    const beforeClear = await api.get(ownId);
+    if (!isBootstrapTab(beforeClear, bootstrap)) return "user_navigated";
+    await api.update(ownId, { url: "about:blank" });
+    return "cleared";
+  }
+  const tabs = await api.query({});
+  const match = existingTab(tabs, target, ownId);
+  if (match) {
+    // Re-query before mutation: a target closed meanwhile must not lose the entry tab.
+    const current = await api.get(match.id);
+    if (!existingTab([current], target, ownId)) return "retry";
+    const beforeActivate = await api.get(ownId);
+    if (!isBootstrapTab(beforeActivate, bootstrap)) return "user_navigated";
+    if (beforeActivate.active) await api.update(match.id, { active: true });
+    const beforeRemove = await api.get(ownId);
+    if (!isBootstrapTab(beforeRemove, bootstrap)) return "user_navigated";
+    await api.remove(ownId); // Only the bootstrap that runs this script is removed.
+    return "reused";
+  }
+  const beforeOpen = await api.get(ownId);
+  if (!isBootstrapTab(beforeOpen, bootstrap)) return "user_navigated";
+  await api.update(ownId, { url: target });
+  return "opened";
+}
diff --git a/src-tauri/src/startup_page/start.js b/src-tauri/src/startup_page/start.js
new file mode 100644
index 0000000..80814fe
--- /dev/null
+++ b/src-tauri/src/startup_page/start.js
@@ -0,0 +1,42 @@
+import { reuseOrOpen } from "./logic.js";
+
+const bootstrap = chrome.runtime.getURL("start.html");
+const status = document.getElementById("status");
+const retry = document.getElementById("retry");
+const wait = ms => new Promise(resolve => setTimeout(resolve, ms));
+
+async function settleRestore() {
+  let last = "", stable = 0;
+  // Chrome constructs restored tabs before command-line tabs. Also tolerate
+  // late creation without waiting for network loads or lazy tabs to finish.
+  for (let i = 0; i < 12; i++) {
+    const tabs = await chrome.tabs.query({});
+    const signature = JSON.stringify(tabs.map(t => [t.id, t.pendingUrl || t.url]));
+    stable = signature === last ? stable + 1 : 0;
+    if (i >= 3 && stable >= 3) return;
+    last = signature;
+    await wait(200);
+  }
+}
+
+async function run() {
+  retry.hidden = true;
+  try {
+    const own = await chrome.tabs.getCurrent();
+    if (!own?.id || own.incognito) throw new Error("startup_tab_unavailable");
+    await settleRestore();
+    // Crash-restored bootstrap tabs and this launch's entry share one origin.
+    // Serialize their check/update so they cannot both create the target.
+    await navigator.locks.request("shardbrowser-startup-tab", async () => {
+      for (let i = 0; i < 2; i++) {
+        if (await reuseOrOpen(chrome.tabs, own.id, globalThis.SHARD_STARTUP_URL, bootstrap) !== "retry") return;
+      }
+      throw new Error("startup_target_changed");
+    });
+  } catch {
+    status.textContent = "启动标签检查未完成，其他标签保持不变。 / Startup tab check could not finish. Other tabs were kept.";
+    retry.hidden = false;
+  }
+}
+retry.addEventListener("click", () => void run());
+void run();
diff --git a/src-tauri/src/tnbproxy.rs b/src-tauri/src/tnbproxy.rs
new file mode 100644
index 0000000..33b1cff
--- /dev/null
+++ b/src-tauri/src/tnbproxy.rs
@@ -0,0 +1,635 @@
+//! TNB's IP-allowlisted extraction API. Only explicit user actions call /gen;
+//! returned entries remain previews until the existing bulk-save command runs.
+use crate::proxy_chain::{connector::Target, tunnel::Tunnel};
+use crate::space::proxy::{self, ProxyEntry, ProxyKind};
+use serde::{Deserialize, Serialize};
+use std::time::Duration;
+use tokio::sync::Semaphore;
+use url::Url;
+
+const MAX_BODY: usize = 512 * 1024;
+const TIMEOUT: Duration = Duration::from_secs(25);
+static REQUESTS: Semaphore = Semaphore::const_new(2);
+static LOCATION_REQUESTS: Semaphore = Semaphore::const_new(4);
+const LOCATIONS_SOURCE: &str = "https://server.tnbproxy.com/api/regions/list";
+
+#[derive(Clone, Copy, Deserialize, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Route { Direct, FirstHop }
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ExtractRequest {
+    #[serde(default)]
+    pub use_api_credentials: bool,
+    #[serde(default)]
+    pub use_proxy_credentials: bool,
+    pub server: String,
+    pub plan_name: String,
+    pub kind: String,
+    pub count: u16,
+    #[serde(default)]
+    pub geo: String,
+    pub ttl: u16,
+    #[serde(default)]
+    pub pre: bool,
+    pub route: Route,
+    pub pool: Option<String>,
+    pub isp: Option<String>,
+    pub asn: Option<String>,
+    pub ip: Option<String>,
+    pub sid: Option<String>,
+}
+
+#[derive(Serialize)]
+pub struct Extraction {
+    pub entries: Vec<ProxyEntry>,
+    pub route: Route,
+    pub server: String,
+    pub requested_count: u16,
+}
+
+type Result<T> = std::result::Result<T, &'static str>;
+
+fn request_url(request: &ExtractRequest) -> Result<Url> {
+    if !(1..=1000).contains(&request.count) || request.ttl > 180
+        || !matches!(request.kind.as_str(), "http" | "socks5")
+        || request.plan_name.is_empty() || request.plan_name.len() > 64
+        || !request.plan_name.bytes().all(|c| c.is_ascii_alphanumeric() || matches!(c, b'_' | b'-'))
+    { return Err("tnb_invalid_request"); }
+    let mut url = server_url(&request.server)?;
+    url.set_path("/gen");
+    {
+        let mut query = url.query_pairs_mut();
+        query.append_pair("plan_name", &request.plan_name)
+            .append_pair("count", &request.count.to_string())
+            .append_pair("format", "txt").append_pair("split", "rn")
+            .append_pair("ttl", &request.ttl.to_string());
+        for (key, value) in [
+            ("geo", Some(request.geo.as_str())), ("pool", request.pool.as_deref()),
+            ("isp", request.isp.as_deref()), ("asn", request.asn.as_deref()),
+            ("ip", request.ip.as_deref()), ("sid", request.sid.as_deref()),
+        ] {
+            if let Some(value) = value.map(str::trim).filter(|v| !v.is_empty()) {
+                if value.len() > 256 || value.chars().any(char::is_control) { return Err("tnb_invalid_request"); }
+                query.append_pair(key, value);
+            }
+        }
+        if request.pre { query.append_pair("pre", "pre"); }
+    }
+    Ok(url)
+}
+
+fn server_url(raw: &str) -> Result<Url> {
+    if raw.len() > 2048 || raw.chars().any(char::is_control) {
+        return Err("tnb_invalid_request");
+    }
+    let url = Url::parse(raw.trim()).map_err(|_| "tnb_invalid_request")?;
+    if !matches!(url.scheme(), "http" | "https") || url.host_str().is_none()
+        || !url.username().is_empty() || url.password().is_some()
+        || url.query().is_some() || url.fragment().is_some()
+        || !matches!(url.path(), "" | "/" | "/gen") || url.port() == Some(0)
+    { return Err("tnb_invalid_request"); }
+    Ok(url)
+}
+
+fn origin(url: &Url) -> String { url.origin().ascii_serialization() }
+
+fn parse_response(body: &[u8], request: &ExtractRequest, server: &str) -> Result<Vec<ProxyEntry>> {
+    let body = std::str::from_utf8(body).map_err(|_| "tnb_invalid_response")?;
+    // TNB may return HTTP 200 with a JSON business error. Surface the
+    // allowlist/auth failure before treating the JSON as a proxy line.
+    if let Ok(value) = serde_json::from_str::<serde_json::Value>(body.trim_start_matches('\u{feff}').trim()) {
+        if let Some(code) = value.get("code").and_then(serde_json::Value::as_i64) {
+            if code == 401 { return Err("tnb_auth_required"); }
+            if code == 403 {
+                let detail = [value.get("msg"), value.get("message"), value.get("error")]
+                    .into_iter().filter_map(|v| v.and_then(serde_json::Value::as_str))
+                    .collect::<Vec<_>>().join(" ").to_ascii_lowercase();
+                if detail.contains("whitelist") || detail.contains("allowlist") || detail.contains("not in") || detail.contains("ip") {
+                    return Err("tnb_whitelist_required");
+                }
+                return Err("tnb_auth_required");
+            }
+            if code != 0 { return Err("tnb_invalid_response"); }
+        }
+    }
+    let kind = if request.kind == "http" { ProxyKind::Http } else { ProxyKind::Socks5 };
+    let lines: Vec<&str> = body.trim_start_matches('\u{feff}').lines().map(str::trim).filter(|l| !l.is_empty()).collect();
+    if lines.is_empty() { return Err("tnb_no_proxies"); }
+    if lines.len() > usize::from(request.count) { return Err("tnb_invalid_response"); }
+    let mut entries = Vec::with_capacity(lines.len());
+    for line in lines {
+        if line.len() > 4096 || line.contains('#') || line.chars().any(|c| c.is_control() || c.is_whitespace()) {
+            return Err("tnb_invalid_response");
+        }
+        // The generic importer treats an unknown scheme as userinfo. Reject
+        // explicit protocol mismatches before it can turn socks4://u:p into
+        // an HTTP username/password; :// inside a raw password stays valid.
+        if let Some((scheme, _)) = line.split_once("://") {
+            if scheme.as_bytes().first().is_some_and(|c| c.is_ascii_alphabetic())
+                && scheme.bytes().all(|c| c.is_ascii_alphanumeric() || matches!(c, b'+' | b'-' | b'.'))
+                && scheme != request.kind
+            { return Err("tnb_invalid_response"); }
+        }
+        let mut parsed = proxy::parse_bulk(line, kind.clone());
+        let Some(mut entry) = parsed.pop().filter(|_| parsed.is_empty()) else { return Err("tnb_invalid_response"); };
+        // A provider error such as "error:403" is not a host. The extraction
+        // contract returns IPs or fully-qualified hosts, never prose/comments.
+        if entry.kind != kind || entry.port == 0
+            || (!entry.host.contains('.') && !entry.host.contains(':'))
+            || Target::new(&entry.host, entry.port).is_err()
+            || entry.username.len() + entry.password.len() > 4096
+            || entry.username.chars().chain(entry.password.chars()).any(char::is_control)
+        { return Err("tnb_invalid_response"); }
+        entry.name = format!("TNBProxy {}:{}", entry.host, entry.port);
+        entry.provider_id = "tnbproxy".into();
+        entry.provider_options = std::collections::HashMap::from([("server".into(),server.into()),("plan_name".into(),request.plan_name.clone())]);
+        if request.use_proxy_credentials && entry.username.is_empty() && entry.password.is_empty() {
+            let credentials=crate::proxy_providers::tnb_credentials(false).map_err(|_|"tnb_credentials_unavailable")?;
+            if credentials.username.is_empty() || credentials.password.is_empty() {return Err("tnb_proxy_credentials_required");}
+            entry.username=credentials.username; entry.password=credentials.password;
+        }
+        // Reuses the durable notes field, which already survives edit/export/
+        // team sync. No change/clean URL is guessed and no management call runs.
+        entry.notes = format!("TNBProxy\n{}", serde_json::json!({
+            "server": server, "plan_name": request.plan_name, "sid": request.sid,
+            "ttl": request.ttl, "route": request.route,
+        }));
+        entries.push(entry);
+    }
+    Ok(entries)
+}
+
+fn request_error(error: reqwest::Error) -> &'static str {
+    if error.is_timeout() { "tnb_timeout" } else { "tnb_request_failed" }
+}
+
+async fn download(client: reqwest::Client, url: Url, host: Option<String>, json_body: Option<serde_json::Value>, auth: Option<crate::proxy_providers::Credential>) -> Result<Vec<u8>> {
+    let mut request = if let Some(body) = json_body {
+        client.post(url).json(&body).header(reqwest::header::ACCEPT, "application/json")
+    } else { client.get(url).header(reqwest::header::ACCEPT, "text/plain") };
+    if let Some(host) = host { request = request.header(reqwest::header::HOST, host); }
+    if let Some(auth)=auth { request=request.basic_auth(auth.username,Some(auth.password)); }
+    let mut response = request.send().await.map_err(request_error)?;
+    if matches!(response.status().as_u16(), 401 | 403) { return Err("tnb_auth_required"); }
+    if !response.status().is_success() { return Err("tnb_http_status"); }
+    if response.content_length().is_some_and(|n| n > MAX_BODY as u64) { return Err("tnb_response_too_large"); }
+    let mut body = Vec::new();
+    while let Some(chunk) = response.chunk().await.map_err(request_error)? {
+        if body.len().saturating_add(chunk.len()) > MAX_BODY { return Err("tnb_response_too_large"); }
+        body.extend_from_slice(&chunk);
+    }
+    Ok(body)
+}
+
+pub async fn extract(request: ExtractRequest) -> Result<Extraction> {
+    extract_with_timeout(request, TIMEOUT).await
+}
+
+async fn extract_with_timeout(request: ExtractRequest, timeout: Duration) -> Result<Extraction> {
+    let _slot = REQUESTS.try_acquire().map_err(|_| "tnb_busy")?;
+    let url = request_url(&request)?;
+    let server = origin(&url);
+    let auth=if request.use_api_credentials { let c=crate::proxy_providers::tnb_credentials(true).map_err(|_|"tnb_credentials_unavailable")?; if c.username.is_empty()||c.password.is_empty(){return Err("tnb_api_credentials_required");} Some(c) } else {None};
+    let body = fetch_on_route(url, request.route, None, timeout, auth).await?;
+    let entries = parse_response(&body, &request, &server)?;
+    Ok(Extraction { entries, route: request.route, server, requested_count: request.count })
+}
+
+async fn fetch_on_route(mut url: Url, route: Route, json_body: Option<serde_json::Value>, timeout: Duration, auth: Option<crate::proxy_providers::Credential>) -> Result<Vec<u8>> {
+    let client = reqwest::Client::builder().no_proxy()
+        .redirect(reqwest::redirect::Policy::none()).http1_only()
+        .pool_max_idle_per_host(0).connect_timeout(Duration::from_secs(8))
+        .timeout(timeout).build().map_err(|_| "tnb_request_failed")?;
+    let mut tunnel = None;
+    let fetched = tokio::time::timeout(timeout, async {
+        let mut host = None;
+        if matches!(route, Route::FirstHop) {
+            let target = Target::new(url.host_str().ok_or("tnb_invalid_request")?, url.port_or_known_default().ok_or("tnb_invalid_request")?).map_err(|_| "tnb_invalid_request")?;
+            let saved = crate::proxy_chain::saved_settings().map_err(|_| "tnb_route_failed")?;
+            let hop = saved.proxy_chain.hop_for(&saved.proxy_chain, &target).await.map_err(|_| "tnb_route_failed")?;
+            // This transparent endpoint has one fixed destination. HTTPS is
+            // verified inside the tunnel against that original host, never
+            // against localhost and never with certificate checks disabled.
+            let bound = if url.scheme() == "https" {
+                let tls = crate::proxy_chain::tls::client().map_err(|_| "tnb_route_failed")?;
+                Tunnel::bind_tls(hop, target, tls).await
+            } else { Tunnel::bind(hop, target).await }.map_err(|_| "tnb_route_failed")?;
+            host = Some(url[url::Position::BeforeHost..url::Position::AfterPort].to_owned());
+            url.set_scheme("http").map_err(|_| "tnb_invalid_request")?;
+            url.set_host(Some("127.0.0.1")).map_err(|_| "tnb_invalid_request")?;
+            url.set_port(Some(bound.addr().port())).map_err(|_| "tnb_invalid_request")?;
+            tunnel = Some(bound);
+        }
+        download(client, url, host, json_body, auth).await
+    }).await.map_err(|_| "tnb_timeout").and_then(|r| r);
+    if let Some(tunnel) = tunnel {
+        let failed = tunnel.last_error().is_some();
+        tunnel.close_and_wait().await.map_err(|_| "tnb_route_failed")?;
+        if failed && fetched.is_err() { return Err("tnb_route_failed"); }
+    }
+    fetched
+}
