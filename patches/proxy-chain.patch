+    Step 'ui-production' 'npm' @('--ignore-scripts', 'run', 'build')
+    Step 'rust-chain-list' 'cargo' @('test', '--manifest-path', 'src-tauri/Cargo.toml', '--locked', 'proxy_chain', '--', '--list')
