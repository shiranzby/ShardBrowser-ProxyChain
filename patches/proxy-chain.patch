@@ -0,0 +1,128 @@
+//! Desktop links carry only a profile ID. The UI starts through its normal guarded path.
+use anyhow::{bail, Context, Result};
+use std::sync::Mutex;
+
+static PENDING: Mutex<Vec<String>> = Mutex::new(Vec::new());
+
+fn requested_id(args: &[String]) -> Option<String> {
+    let mut found = None;
+    let mut args = args.iter().skip(1);
+    while let Some(arg) = args.next() {
+        if arg == "--profile-id" {
+            if found.is_some() { return None; }
+            let id = args.next()?;
+            if uuid::Uuid::parse_str(id).is_err() { return None; }
+            found = Some(id.clone());
+        }
+    }
+    found
+}
+
+pub fn receive(args: &[String]) {
+    if let Some(id) = requested_id(args) {
+        let mut pending = PENDING.lock().unwrap_or_else(|e| e.into_inner());
+        if !pending.contains(&id) { pending.push(id); }
+        drop(pending);
+        crate::notify_event("profile-shortcut-requested", serde_json::Value::Null);
+    }
+}
+
+#[tauri::command]
+pub fn profile_shortcut_take_pending() -> Vec<String> {
+    std::mem::take(&mut *PENDING.lock().unwrap_or_else(|e| e.into_inner()))
+}
+
+fn safe_name(name: &str) -> String {
+    let value: String = name.chars().map(|c| {
+        if c.is_control() || r#"<>:"/\|?*"#.contains(c) { '_' } else { c }
+    }).take(70).collect();
+    let value = value.trim_matches(|c| c == ' ' || c == '.');
+    if value.is_empty() { "Profile".into() } else { value.into() }
+}
+
+#[tauri::command]
+pub async fn profile_create_desktop_shortcut(profile_id: String) -> Result<String, String> {
+    create(&profile_id).await.map_err(|e| e.to_string())
+}
+
+async fn create(id: &str) -> Result<String> {
+    crate::space::ready().await;
+    if crate::team::active_team().is_some() { bail!(crate::space::PERSONAL_ONLY); }
+    uuid::Uuid::parse_str(id).context("invalid profile ID")?;
+    let name = crate::space::profile::list_all()?.into_iter()
+        .find(|profile| profile.id == id).context("Profile no longer exists")?.name;
+    let executable = std::env::current_exe()?;
+    let desktop = dirs::desktop_dir().context("Desktop directory is unavailable")?;
+    let path = desktop.join(format!("{} - ShardBrowser - {}.lnk", safe_name(&name), id));
+    #[cfg(windows)]
+    {
+        write_link(&path, &executable, id, &name)?;
+        Ok(path.display().to_string())
+    }
+    #[cfg(not(windows))]
+    { let _ = (path, executable); bail!("Desktop shortcuts are supported on Windows"); }
+}
+
+
+#[cfg(windows)]
+const WRITE_LINK_PS: &str = r#"$ErrorActionPreference='Stop'; $w=New-Object -ComObject WScript.Shell; $s=$w.CreateShortcut($env:SHARD_LINK); $s.TargetPath=$env:SHARD_EXE; $s.Arguments='--profile-id '+$env:SHARD_PROFILE; $s.WorkingDirectory=[IO.Path]::GetDirectoryName($env:SHARD_EXE); $s.Description=$env:SHARD_TITLE; $s.IconLocation=$env:SHARD_EXE+',0'; $s.Save()"#;
+
+#[cfg(windows)]
+fn write_link(path: &std::path::Path, executable: &std::path::Path, id: &str, name: &str) -> Result<()> {
+    use std::os::windows::process::CommandExt;
+    // Static script; paths and user names never become PowerShell source.
+    let output = std::process::Command::new("powershell.exe")
+        .args(["-NoLogo", "-NoProfile", "-NonInteractive", "-Command", WRITE_LINK_PS])
+        .env("SHARD_LINK", path).env("SHARD_EXE", executable)
+        .env("SHARD_PROFILE", id).env("SHARD_TITLE", format!("ShardBrowser: {}", name))
+        .creation_flags(0x08000000).output().context("create desktop shortcut")?;
+    if !output.status.success() { bail!("Windows could not create the desktop shortcut"); }
+    if !path.is_file() { bail!("Desktop shortcut was not created"); }
+    Ok(())
+}
+
+#[cfg(all(test, windows))]
+const READ_LINK_PS: &str = r#"$ErrorActionPreference='Stop'; [Console]::OutputEncoding=New-Object System.Text.UTF8Encoding($false); $w=New-Object -ComObject WScript.Shell; $s=$w.CreateShortcut($env:SHARD_LINK); @{target=$s.TargetPath; arguments=$s.Arguments; directory=$s.WorkingDirectory; description=$s.Description} | ConvertTo-Json -Compress"#;
+
