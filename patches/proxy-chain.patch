diff --git a/scripts/apply-patch.ps1 b/scripts/apply-patch.ps1
new file mode 100644
index 0000000..36beaba
--- /dev/null
+++ b/scripts/apply-patch.ps1
@@ -0,0 +1,74 @@
+[CmdletBinding()]
+param(
+    [string]$ManifestPath = (Join-Path $PSScriptRoot '../patches/manifest.json'),
+    [Parameter(Mandatory)][string]$UpstreamTag,
+    [Parameter(Mandatory)][string]$UpstreamCommit,
+    [Parameter(Mandatory)][string]$CandidatePath,
+    [Parameter(Mandatory)][string]$OutputPath,
+    # A local mirror is useful for offline conflict drills; CI uses the default.
+    [string]$SourceRepository = 'https://github.com/ProxyShard/ShardBrowser.git'
+)
+$ErrorActionPreference = 'Stop'
+Set-StrictMode -Version Latest
+function Invoke-Git([Parameter(ValueFromRemainingArguments=$true)][string[]]$Arguments) {
+    $result = & git @Arguments 2>&1
+    if ($LASTEXITCODE -ne 0) { throw "git $($Arguments[0]) failed: $($result -join "`n")" }
+    $result
+}
+$manifest = Get-Content -Raw -LiteralPath $ManifestPath | ConvertFrom-Json
+if ($manifest.schema -ne 1 -or $manifest.upstream_repository -ne 'ProxyShard/ShardBrowser' -or -not $manifest.ready) { throw 'The functional patch manifest is not ready.' }
+if ($UpstreamTag -notmatch '^v[0-9]+\.[0-9]+\.[0-9]+$' -or $UpstreamCommit -notmatch '^[0-9a-f]{40}$') { throw 'Invalid stable tag or commit.' }
+if ($manifest.base_commit -notmatch '^[0-9a-f]{40}$' -or $manifest.patch_revision -notmatch '^pc[1-9][0-9]*$' -or $manifest.patch_commit -notmatch '^[0-9a-f]{40}$') { throw 'Invalid patch provenance.' }
+if ($manifest.patch_file -ne 'proxy-chain.patch' -or $manifest.patch_sha256 -notmatch '^[0-9a-f]{64}$') { throw 'Invalid patch artifact.' }
+$patchPath = [IO.Path]::GetFullPath((Join-Path (Split-Path -Parent $ManifestPath) $manifest.patch_file))
+if ((Get-FileHash -LiteralPath $patchPath -Algorithm SHA256).Hash.ToLowerInvariant() -ne $manifest.patch_sha256) { throw 'Patch hash mismatch.' }
+$candidate = [IO.Path]::GetFullPath($CandidatePath)
+$output = [IO.Path]::GetFullPath($OutputPath)
+if ($output.TrimEnd([IO.Path]::DirectorySeparatorChar) -eq $candidate.TrimEnd([IO.Path]::DirectorySeparatorChar) -or $output.StartsWith($candidate.TrimEnd([IO.Path]::DirectorySeparatorChar) + [IO.Path]::DirectorySeparatorChar, [StringComparison]::OrdinalIgnoreCase)) { throw 'Keep build receipts outside the candidate source tree.' }
+if (Test-Path -LiteralPath $candidate) { throw 'Candidate path already exists; use a new isolated directory.' }
+New-Item -ItemType Directory -Path $candidate | Out-Null
+Invoke-Git @('init', $candidate) | Out-Null
+Invoke-Git @('-C', $candidate, 'fetch', '--no-tags', '--depth=1', $SourceRepository, "refs/tags/$UpstreamTag") | Out-Null
+$actual = [string](Invoke-Git @('-C', $candidate, 'rev-parse', 'FETCH_HEAD^{commit}'))
+if ($actual -ne $UpstreamCommit) { throw 'Fetched stable tag does not match the discovery commit.' }
+Invoke-Git @('-C', $candidate, 'checkout', '--detach', $actual) | Out-Null
+$candidateBranch = "pc-ci/$UpstreamTag-$($manifest.patch_revision)"
+Invoke-Git @('-C', $candidate, 'switch', '-c', $candidateBranch) | Out-Null
+# Three-way application requires the baseline blobs even when the new tag changed them.
+Invoke-Git @('-C', $candidate, 'fetch', '--no-tags', '--depth=1', $SourceRepository, $manifest.base_commit) | Out-Null
+$applyOutput = & git -C $candidate apply --3way --index -- $patchPath 2>&1
+$applyExit = $LASTEXITCODE
+$unmerged = @(& git -C $candidate diff --name-only --diff-filter=U)
+if ($applyExit -ne 0 -or $unmerged.Count -gt 0) {
+    # Keep the checkout and conflict paths for diagnosis. Never resolve conflicts here.
+    $failure = [ordered]@{ schema=1; result='patch_conflict'; upstream_tag=$UpstreamTag; upstream_commit=$actual; patch_sha256=$manifest.patch_sha256; conflict_files=$unmerged; details=@($applyOutput | ForEach-Object { "$_" }) }
+    $failure | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath $output -Encoding utf8
+    throw 'The patch did not apply cleanly. No tests, build, or release are allowed.'
+}
+Invoke-Git @('-C', $candidate, 'diff', '--cached', '--check') | Out-Null
+$paths = @(Invoke-Git @('-C', $candidate, 'diff', '--cached', '--name-only'))
+if ($paths.Count -eq 0) { throw 'The patch changed no files.' }
+foreach ($path in $paths) {
+    if ($path -match '(^|/)(\.git|\.github|patches|node_modules|target)(/|$)' -or $path -match '(^|/)(api\.txt|\.env[^/]*)$') { throw "Functional patch changes a forbidden path: $path" }
+}
+$oldAuthorDate = $env:GIT_AUTHOR_DATE
+$oldCommitterDate = $env:GIT_COMMITTER_DATE
+try {
+    # Identical upstream + patch must reproduce the tested commit in the build job.
+    $env:GIT_AUTHOR_DATE = '2000-01-01T00:00:00+00:00'
+    $env:GIT_COMMITTER_DATE = '2000-01-01T00:00:00+00:00'
+    Invoke-Git @('-C', $candidate, '-c', 'user.name=ProxyChain Builder', '-c', 'user.email=proxy-chain@users.noreply.github.com', '-c', 'commit.gpgsign=false', 'commit', '-m', "Apply $($manifest.patch_revision) to $UpstreamTag") | Out-Null
+} finally {
+    $env:GIT_AUTHOR_DATE = $oldAuthorDate
+    $env:GIT_COMMITTER_DATE = $oldCommitterDate
+}
+$candidateCommit = [string](Invoke-Git @('-C', $candidate, 'rev-parse', 'HEAD'))
+$tree = [string](Invoke-Git @('-C', $candidate, 'rev-parse', 'HEAD^{tree}'))
+$maintenance = [string](Invoke-Git @('-C', (Join-Path $PSScriptRoot '..'), 'rev-parse', 'HEAD'))
+$metadata = [ordered]@{
+    schema=1; result='applied'; upstream_repository=$manifest.upstream_repository; upstream_tag=$UpstreamTag; upstream_commit=$actual
+    patch_revision=$manifest.patch_revision; patch_sha256=$manifest.patch_sha256; patch_commit=$manifest.patch_commit
+    candidate_commit=$candidateCommit; candidate_branch=$candidateBranch; source_tree=$tree; maintenance_commit=$maintenance; changed_files=$paths
+}
+$metadata | ConvertTo-Json -Depth 6 | Set-Content -LiteralPath $output -Encoding utf8
+Write-Output "Patch applied: $candidateCommit ($tree)"
diff --git a/scripts/build-portable.ps1 b/scripts/build-portable.ps1
new file mode 100644
index 0000000..b9e70aa
--- /dev/null
+++ b/scripts/build-portable.ps1
@@ -0,0 +1,157 @@
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory)][string]$CandidatePath,
+    [Parameter(Mandatory)][string]$MetadataPath,
+    [string]$VerificationPath,
+    [Parameter(Mandatory)][string]$OutputDirectory,
+    # Optional post-build acceptance evidence. Missing evidence produces a candidate,
+    # never an accepted Release. No external path is read from an environment variable.
+    [string]$AcceptancePath,
+    [switch]$BuildOnly,
+    [switch]$ValidateExisting
+)
+$ErrorActionPreference = 'Stop'
+Set-StrictMode -Version Latest
+. (Join-Path $PSScriptRoot 'lib/proxy-chain-build.ps1')
+$candidate = [IO.Path]::GetFullPath($CandidatePath)
+$output = [IO.Path]::GetFullPath($OutputDirectory)
+if ($output.TrimEnd([IO.Path]::DirectorySeparatorChar) -eq $candidate.TrimEnd([IO.Path]::DirectorySeparatorChar) -or $output.StartsWith($candidate.TrimEnd([IO.Path]::DirectorySeparatorChar) + [IO.Path]::DirectorySeparatorChar, [StringComparison]::OrdinalIgnoreCase)) { throw 'Keep Portable artifacts outside the candidate source tree.' }
+New-Item -ItemType Directory -Force -Path $output | Out-Null
+if ($BuildOnly -and $AcceptancePath) { throw 'BuildOnly cannot be combined with an acceptance receipt.' }
+$meta = Get-Content -Raw -LiteralPath $MetadataPath | ConvertFrom-Json
+$verified = $null
+if (-not $BuildOnly) {
+    if ([string]::IsNullOrWhiteSpace($VerificationPath) -or -not (Test-Path -LiteralPath $VerificationPath -PathType Leaf)) { throw 'Verification receipt is required unless BuildOnly is set.' }
+    $verified = Get-Content -Raw -LiteralPath $VerificationPath | ConvertFrom-Json
+}
+if ($meta.schema -ne 1 -or $meta.result -ne 'applied' -or $meta.candidate_commit -notmatch '^[0-9a-f]{40}$' -or $meta.source_tree -notmatch '^[0-9a-f]{40}$' -or $meta.patch_sha256 -notmatch '^[0-9a-f]{64}$' -or $meta.upstream_tag -notmatch '^v[0-9]+\.[0-9]+\.[0-9]+$' -or $meta.patch_revision -notmatch '^pc[1-9][0-9]*$') { throw 'Invalid candidate provenance.' }
+if (-not $BuildOnly -and ($verified.schema -ne 1 -or $verified.kind -ne 'proxy-chain-verification' -or $verified.result -ne 'passed' -or $verified.candidate_commit -ne $meta.candidate_commit -or $verified.source_tree -ne $meta.source_tree -or $verified.patch_sha256 -ne $meta.patch_sha256)) { throw 'Verification does not cover this candidate.' }
+
+function EvidencePath([string]$Base, [string]$Relative) {
+    if ([IO.Path]::IsPathRooted($Relative) -or $Relative -match '(^|[\\/])\.\.([\\/]|$)' -or $Relative -match ':') { throw 'Evidence must use a safe relative file path.' }
+    $basePath = [IO.Path]::GetFullPath($Base).TrimEnd([IO.Path]::DirectorySeparatorChar) + [IO.Path]::DirectorySeparatorChar
+    $p = [IO.Path]::GetFullPath((Join-Path $basePath $Relative))
+    if (-not $p.StartsWith($basePath, [StringComparison]::OrdinalIgnoreCase) -or -not (Test-Path -LiteralPath $p -PathType Leaf)) { throw 'Evidence file is missing or outside its proof directory.' }
+    # Do not follow a symlink out of the proof directory.
+    $item = Get-Item -LiteralPath $p
+    while ($item.FullName.Length -ge $basePath.TrimEnd([IO.Path]::DirectorySeparatorChar).Length) {
+        if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Evidence symlinks are not accepted.' }
+        if ($item -isnot [IO.DirectoryInfo]) { $item = $item.Directory } else { $item = $item.Parent }
+        if ($null -eq $item) { break }
+    }
+    $p
+}
+function CheckFile([string]$Base, [string]$Relative, [string]$Hash) {
+    if ($Hash -notmatch '^[0-9a-f]{64}$') { throw 'Evidence hash is invalid.' }
+    $p = EvidencePath $Base $Relative
+    if ((Get-FileHash -LiteralPath $p -Algorithm SHA256).Hash.ToLowerInvariant() -ne $Hash) { throw 'Evidence file hash mismatch.' }
+}
+if (-not $BuildOnly) {
+    $required = @('pipeline-offline','npm-install','ui-kit','ui-check','ui-production','rust-chain-list','rust-chain','rust-full','playwright-install')
+    $proofBase = Split-Path -Parent ([IO.Path]::GetFullPath($VerificationPath))
+    foreach ($name in $required) {
+        $check = @($verified.checks | Where-Object { $_.id -eq $name })
+        if ($check.Count -ne 1 -or $check[0].status -ne 'passed') { throw "Missing verification gate: $name" }
+        CheckFile $proofBase $check[0].log $check[0].sha256
+    }
+    $browserChecks = @($verified.checks | Where-Object { $_.id -like 'ui-browser-*' })
+    if ($browserChecks.Count -eq 0) { throw 'Missing isolated browser verification gates.' }
+    foreach ($check in $browserChecks) {
+        if ($check.status -ne 'passed') { throw "Browser verification gate failed: $($check.id)" }
+        CheckFile $proofBase $check.log $check.sha256
+    }
+}
+$head = (& git -C $candidate rev-parse HEAD).Trim()
+if ($LASTEXITCODE -ne 0 -or $head -ne $meta.candidate_commit) { throw 'Candidate commit changed after verification.' }
+$tree = (& git -C $candidate rev-parse 'HEAD^{tree}').Trim()
+if ($LASTEXITCODE -ne 0 -or $tree -ne $meta.source_tree) { throw 'Candidate source changed after verification.' }
+Assert-ProxyChainCleanSource $candidate
+$filename = "ShardBrowser-$($meta.upstream_tag)-$($meta.patch_revision)-portable-win-x64.exe"
+$portable = Join-Path $output $filename
+$buildLog = Join-Path $output 'portable-build.log'
+if ($ValidateExisting) {
+    $previousInfo = Get-Content -Raw -LiteralPath (Join-Path $output 'build-info.json') | ConvertFrom-Json
+    if ($previousInfo.result -ne 'built' -or $previousInfo.candidate_commit -ne $head -or $previousInfo.source_tree -ne $tree -or $previousInfo.patch_sha256 -ne $meta.patch_sha256 -or $previousInfo.portable_filename -ne $filename -or $previousInfo.portable_sha256 -ne (Get-FileHash -LiteralPath $portable -Algorithm SHA256).Hash.ToLowerInvariant()) { throw 'Existing Portable binary does not match its original build receipt.' }
+}
+if (-not $ValidateExisting) {
+    if (-not $IsWindows) { throw 'Portable compilation requires a native Windows runner.' }
+    if (-not $env:LIBCLANG_PATH) {
+        $clang = @('C:/Program Files/LLVM/bin','C:/Program Files (x86)/LLVM/bin') | Where-Object { Test-Path -LiteralPath (Join-Path $_ 'libclang.dll') } | Select-Object -First 1
+        if (-not $clang) { throw 'LLVM libclang.dll is unavailable for the default automation features.' }
+        $env:LIBCLANG_PATH = $clang
+    }
+    foreach ($tool in @('node','npm','cargo','cmake','nasm','go')) {
+        if (-not (Get-Command $tool -ErrorAction SilentlyContinue)) { throw "Required native build tool is missing from PATH: $tool" }
+    }
+    Push-Location -LiteralPath $candidate
+    $oldPatchRevision = $env:SHARDBROWSER_PATCH_REVISION
+    $oldTargetDirectory = $env:CARGO_TARGET_DIR
+    $release = Get-ProxyChainReleaseDirectory $candidate $oldTargetDirectory
+    try {
+        $env:SHARDBROWSER_PATCH_REVISION = $meta.patch_revision
+        # Tauri starts Cargo in its Rust folder. Normalize to an absolute path
+        # before invoking it so a relative override has one documented meaning.
+        $env:CARGO_TARGET_DIR = Split-Path -Parent (Split-Path -Parent $release)
+        # Keep the upstream Tauri build + beforeBuildCommand, but Portable needs
+        # only the raw EXE. Do not download or run WiX/NSIS installer bundlers.
+        & npx tauri build --no-bundle --target x86_64-pc-windows-msvc 2>&1 | Tee-Object -LiteralPath $buildLog | Write-Output
+        if ($LASTEXITCODE -ne 0) { throw 'Windows Portable compilation failed.' }
+    } finally { $env:SHARDBROWSER_PATCH_REVISION = $oldPatchRevision; $env:CARGO_TARGET_DIR = $oldTargetDirectory; Pop-Location }
+    $cargo = Get-Content -Raw -LiteralPath (Join-Path $candidate 'src-tauri/Cargo.toml')
+    if ($cargo -notmatch '(?ms)^\[package\]\s*\r?\nname\s*=\s*"([A-Za-z0-9_-]+)"') { throw 'Cannot identify the upstream Cargo package.' }
+    $package = $Matches[1]
+    # The non-bundled Cargo package executable is authoritative. A product-name
+    # binary left from a prior installer build must not win over this build.
+    $raw = Join-Path $release "$package.exe"
+    if (-not (Test-Path -LiteralPath $raw -PathType Leaf)) { $raw = $null }
+    if (-not $raw) { throw 'No raw launcher binary produced; refusing to rename an installer.' }
+    Copy-Item -LiteralPath $raw -Destination $portable
+}
+if ((& git -C $candidate rev-parse HEAD).Trim() -ne $head -or $LASTEXITCODE -ne 0) { throw 'Candidate source changed while building.' }
+Assert-ProxyChainCleanSource $candidate
+if (-not (Test-Path -LiteralPath $portable -PathType Leaf)) { throw 'Portable binary is missing.' }
+$bytes = [IO.File]::OpenRead($portable)
+try { if ($bytes.ReadByte() -ne 0x4d -or $bytes.ReadByte() -ne 0x5a) { throw 'Portable artifact is not a Windows PE executable.' } } finally { $bytes.Dispose() }
+$sha = (Get-FileHash -LiteralPath $portable -Algorithm SHA256).Hash.ToLowerInvariant()
+"$sha  $filename" | Set-Content -LiteralPath (Join-Path $output "$filename.sha256") -Encoding ascii
+
+$publishReady = $false
+$acceptanceState = 'not_run'
+if ($AcceptancePath) {
+    if (-not (Test-Path -LiteralPath $AcceptancePath -PathType Leaf)) { throw 'An explicit acceptance receipt was requested but is missing.' }
+    $acceptance = Get-Content -Raw -LiteralPath $AcceptancePath | ConvertFrom-Json
+    if ($acceptance.schema -ne 1 -or $acceptance.kind -ne 'proxy-chain-engine-acceptance' -or $acceptance.candidate_commit -ne $head -or $acceptance.source_tree -ne $tree -or $acceptance.portable_sha256 -ne $sha) { throw 'Acceptance does not cover this exact Portable binary and source.' }
+    if ($acceptance.platform.os -ne 'windows' -or $acceptance.platform.major -ne 11 -or $acceptance.platform.architecture -ne 'x64' -or $acceptance.engine.sha256 -notmatch '^[0-9a-f]{64}$' -or [string]::IsNullOrWhiteSpace($acceptance.engine.version) -or [string]::IsNullOrWhiteSpace($acceptance.engine.build)) { throw 'Acceptance engine/platform identity is incomplete.' }
+    $ids = @('engine_socks5_auth','two_layer_http','two_layer_socks5','final_exit_is_profile','fail_closed_system_down','fail_closed_system_auth','fail_closed_profile_auth','fail_closed_midstream','three_profile_isolation','listener_cleanup','quic_disabled','webrtc_no_direct_udp','dns_via_chain','profile_data_preserved','portable_upgrade_preserved','settings_compatibility','thirty_profiles_saved')
+    $base = Split-Path -Parent ([IO.Path]::GetFullPath($AcceptancePath))
+    $allPassed = $true
+    foreach ($id in $ids) {
+        $one = @($acceptance.checks | Where-Object { $_.id -eq $id })
+        if ($one.Count -ne 1 -or $one[0].status -notin @('passed','failed','not_run')) { throw "Acceptance check is missing or invalid: $id" }
+        if ($one[0].status -ne 'passed') { $allPassed = $false; continue }
+        if (@($one[0].evidence).Count -eq 0) { throw "A passed acceptance check has no evidence: $id" }
+        foreach ($file in $one[0].evidence) { CheckFile $base $file.path $file.sha256 }
+    }
+    if ($allPassed) {
+        foreach ($field in @('system_exit_ip','profile_exit_ip','observed_exit_ip')) {
+            $parsed = $null
+            if (-not [Net.IPAddress]::TryParse([string]$acceptance.route.$field, [ref]$parsed)) { throw 'Acceptance route IP is invalid.' }
+        }
+        if ($acceptance.route.observed_exit_ip -ne $acceptance.route.profile_exit_ip -or $acceptance.route.observed_exit_ip -eq $acceptance.route.system_exit_ip) { throw 'Actual exit IP does not prove the second proxy as the final exit.' }
+        $publishReady = $true
+        $acceptanceState = 'passed'
+    } else { $acceptanceState = 'incomplete' }
+}
+$info = [ordered]@{
+    schema=1; result='built'; built_at_utc=[DateTime]::UtcNow.ToString('o')
+    upstream_repository=$meta.upstream_repository; upstream_tag=$meta.upstream_tag; upstream_commit=$meta.upstream_commit
+    patch_revision=$meta.patch_revision; patch_commit=$meta.patch_commit; patch_sha256=$meta.patch_sha256
+    candidate_commit=$head; source_tree=$tree; maintenance_commit=$meta.maintenance_commit
+    portable_filename=$filename; portable_sha256=$sha; verification_sha256=$(if($BuildOnly){$null}else{(Get-FileHash -LiteralPath $VerificationPath -Algorithm SHA256).Hash.ToLowerInvariant()})
+    acceptance=$acceptanceState; publish_ready=$publishReady; artifact_kind=$(if($publishReady){'accepted_portable'}else{'candidate_portable'})
+    build_command='npx tauri build --no-bundle --target x86_64-pc-windows-msvc'; node_version=((& node --version) -join ''); rust_version=((& rustc --version) -join '')
+    run_url=$(if($env:GITHUB_RUN_ID){"https://github.com/$env:GITHUB_REPOSITORY/actions/runs/$env:GITHUB_RUN_ID"}else{$null})
+}
+if ($AcceptancePath) { $info.acceptance_receipt_sha256 = (Get-FileHash -LiteralPath $AcceptancePath -Algorithm SHA256).Hash.ToLowerInvariant(); $info.engine = $acceptance.engine }
+$info | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath (Join-Path $output 'build-info.json') -Encoding utf8
+Write-Output "$filename SHA256=$sha; acceptance=$acceptanceState; publish_ready=$publishReady"
diff --git a/scripts/check-upstream.ps1 b/scripts/check-upstream.ps1
new file mode 100644
index 0000000..3f6fb64
--- /dev/null
+++ b/scripts/check-upstream.ps1
@@ -0,0 +1,81 @@
+[CmdletBinding()]
+param(
+    [string]$ManifestPath = (Join-Path $PSScriptRoot '../patches/manifest.json'),
+    [string]$CompletedStatePath = (Join-Path $PSScriptRoot '../patches/last-success.json'),
+    [Parameter(Mandatory)][string]$OutputPath,
+    [switch]$ForceBuild,
+    # Offline fixtures are explicit; scheduled workflows never set this option.
+    [string]$FixtureDirectory
+)
+$ErrorActionPreference = 'Stop'
+Set-StrictMode -Version Latest
+
+function Api([string]$Path) {
+    $headers = @{ Accept = 'application/vnd.github+json'; 'User-Agent' = 'ShardBrowser-ProxyChain'; 'X-GitHub-Api-Version' = '2022-11-28' }
+    if ($env:GH_TOKEN) { $headers.Authorization = "Bearer $env:GH_TOKEN" }
+    try { Invoke-RestMethod -Uri "https://api.github.com/$Path" -Headers $headers -TimeoutSec 30 }
+    catch { throw "GitHub request failed for $Path; no update decision was made." }
+}
+
+$manifest = Get-Content -Raw -LiteralPath $ManifestPath | ConvertFrom-Json
+if ($manifest.schema -ne 1 -or $manifest.upstream_repository -ne 'ProxyShard/ShardBrowser') { throw 'Unsupported patch manifest.' }
+if ($manifest.patch_revision -notmatch '^pc[1-9][0-9]*$') { throw 'Invalid patch revision.' }
+if (-not $manifest.ready -or $manifest.patch_sha256 -notmatch '^[0-9a-f]{64}$') { throw 'The functional patch is not ready; finish and hash it before enabling upstream builds.' }
+$patchPath = Join-Path (Split-Path -Parent $ManifestPath) $manifest.patch_file
+if ($manifest.patch_file -ne 'proxy-chain.patch' -or -not (Test-Path -LiteralPath $patchPath -PathType Leaf)) { throw 'Missing functional patch.' }
+if ((Get-FileHash -LiteralPath $patchPath -Algorithm SHA256).Hash.ToLowerInvariant() -ne $manifest.patch_sha256) { throw 'The functional patch hash does not match the manifest.' }
+
+if ($FixtureDirectory) {
+    if (Test-Path -LiteralPath (Join-Path $FixtureDirectory 'api-error.json')) { throw 'GitHub request failed (offline service-failure fixture); no update decision was made.' }
+    $releases = @(Get-Content -Raw -LiteralPath (Join-Path $FixtureDirectory 'releases.json') | ConvertFrom-Json)
+} else {
+    $releases = @()
+    # Do not let a large prerelease history hide a stable release.
+    for ($page = 1; $page -le 100; $page++) {
+        # Invoke-RestMethod emits a JSON array as one pipeline object. Assign
+        # first, then expand it; wrapping the function call directly preserves
+        # a nested array and makes stable-release filtering reject every row.
+        $response = Api "repos/$($manifest.upstream_repository)/releases?per_page=100&page=$page"
+        $batch = @($response)
+        $releases += $batch
+        if ($batch.Count -lt 100) { break }
+        if ($page -eq 100) { throw 'Release pagination exceeded its bound; no update decision was made.' }
+    }
+}
+$stable = @($releases | Where-Object { -not $_.draft -and -not $_.prerelease -and $_.tag_name -match '^v[0-9]+\.[0-9]+\.[0-9]+$' } | Sort-Object { [version]$_.tag_name.Substring(1) } -Descending)
+if ($stable.Count -eq 0) { throw 'No formal stable release found; no update decision was made.' }
+$tag = [string]$stable[0].tag_name
+if ($FixtureDirectory) {
+    $ref = Get-Content -Raw -LiteralPath (Join-Path $FixtureDirectory 'tag-ref.json') | ConvertFrom-Json
+} else { $ref = Api "repos/$($manifest.upstream_repository)/git/ref/tags/$tag" }
+if ($ref.ref -ne "refs/tags/$tag") { throw 'GitHub returned a different tag reference.' }
+$object = $ref.object
+$depth = 0
+while ($object.type -eq 'tag') {
+    if (++$depth -gt 8 -or $object.sha -notmatch '^[0-9a-f]{40}$') { throw 'Invalid annotated tag chain.' }
+    $object = if ($FixtureDirectory) {
+        (Get-Content -Raw -LiteralPath (Join-Path $FixtureDirectory "tag-$($object.sha).json") | ConvertFrom-Json).object
+    } else { (Api "repos/$($manifest.upstream_repository)/git/tags/$($object.sha)").object }
+}
+if ($object.type -ne 'commit' -or $object.sha -notmatch '^[0-9a-f]{40}$') { throw 'Stable tag did not resolve to a commit.' }
+
+$shouldBuild = $true
+$reason = 'new upstream or patch revision'
+if (Test-Path -LiteralPath $CompletedStatePath -PathType Leaf) {
+    $previous = Get-Content -Raw -LiteralPath $CompletedStatePath | ConvertFrom-Json
+    if ($previous.schema -ne 1 -or $previous.result -ne 'success' -or $previous.portable_sha256 -notmatch '^[0-9a-f]{64}$') { throw 'Successful build state is malformed.' }
+    if ($previous.upstream_tag -eq $tag -and $previous.upstream_commit -ne $object.sha) { throw 'The upstream stable tag moved after a successful build; investigate instead of publishing automatically.' }
+    if ($previous.upstream_tag -eq $tag -and $previous.upstream_commit -eq $object.sha -and $previous.patch_sha256 -eq $manifest.patch_sha256 -and $previous.patch_revision -eq $manifest.patch_revision) {
+        $shouldBuild = $false
+        $reason = 'same upstream commit and patch already built successfully'
+    }
+}
+if ($ForceBuild) { $shouldBuild = $true; $reason = 'explicit rebuild requested' }
+$result = [ordered]@{
+    schema = 1; source = $(if ($FixtureDirectory) { 'fixture' } else { 'github' })
+    checked_at_utc = [DateTime]::UtcNow.ToString('o'); upstream_repository = $manifest.upstream_repository
+    upstream_tag = $tag; upstream_commit = $object.sha; patch_revision = $manifest.patch_revision
+    patch_sha256 = $manifest.patch_sha256; should_build = $shouldBuild; reason = $reason
+}
+$result | ConvertTo-Json -Depth 6 | Set-Content -LiteralPath $OutputPath -Encoding utf8
+Write-Output "$tag $($object.sha): $reason"
