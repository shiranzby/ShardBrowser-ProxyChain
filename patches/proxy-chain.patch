+        fn stop<'a>(&'a self, id: &'a str) -> BoxFuture<'a, Result<()>> {
+            Box::pin(async move {
+                self.event("stop", id).await?;
+                self.live.lock().unwrap().take();
+                Ok(())
+            })
+        }
+
+        fn running(&self, id: &str) -> bool {
+            self.live.lock().unwrap().as_deref() == Some(id)
+        }
+    }
