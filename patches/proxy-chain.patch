+        .with_context(|| format!("{} is not a library entry", path.display()))?;
+    if entry.builtin {
+        anyhow::bail!("builtin fingerprint cannot store runtime observations");
+    }
+    for (field, value) in observations {
+        if !FIELDS.contains(&field.as_str()) {
