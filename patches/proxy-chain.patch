diff --git a/src-tauri/src/tnbproxy.rs b/src-tauri/src/tnbproxy.rs
new file mode 100644
index 0000000..93134a0
--- /dev/null
+++ b/src-tauri/src/tnbproxy.rs
@@ -0,0 +1,1157 @@
+//! TNB's IP-allowlisted extraction API. Only explicit user actions call /gen;
+//! returned entries remain previews until the existing bulk-save command runs.
+use crate::proxy_chain::{connector::Target, tunnel::Tunnel};
+use crate::space::proxy::{self, ProxyEntry, ProxyKind};
+use serde::{Deserialize, Serialize};
+use std::time::Duration;
+use tokio::sync::Semaphore;
+use url::Url;
+
+const MAX_BODY: usize = 512 * 1024;
+const TIMEOUT: Duration = Duration::from_secs(25);
+static REQUESTS: Semaphore = Semaphore::const_new(2);
+static LOCATION_REQUESTS: Semaphore = Semaphore::const_new(4);
+const LOCATIONS_SOURCE: &str = "https://server.tnbproxy.com/api/regions/list";
+
+#[derive(Clone, Copy, Deserialize, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Route {
+    Direct,
+    FirstHop,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ExtractRequest {
+    #[serde(default)]
+    pub use_api_credentials: bool,
+    #[serde(default)]
+    pub use_proxy_credentials: bool,
+    pub server: String,
+    pub plan_name: String,
+    #[serde(default)]
+    pub provider_name: Option<String>,
+    pub kind: String,
+    pub count: u16,
+    #[serde(default)]
+    pub geo: String,
+    pub ttl: u16,
+    #[serde(default)]
+    pub pre: bool,
+    pub route: Route,
+    pub pool: Option<String>,
+    pub isp: Option<String>,
+    pub asn: Option<String>,
+    pub ip: Option<String>,
+    pub sid: Option<String>,
+}
+
+#[derive(Serialize)]
+pub struct Extraction {
+    pub entries: Vec<ProxyEntry>,
+    pub route: Route,
+    pub server: String,
+    pub requested_count: u16,
+}
+
+type Result<T> = std::result::Result<T, &'static str>;
+
+fn request_url(request: &ExtractRequest) -> Result<Url> {
+    if !(1..=1000).contains(&request.count)
+        || request.ttl > 180
+        || !matches!(request.kind.as_str(), "http" | "socks5")
+        || request.plan_name.is_empty()
+        || request.plan_name.len() > 64
+        || !request
+            .plan_name
+            .bytes()
+            .all(|c| c.is_ascii_alphanumeric() || matches!(c, b'_' | b'-'))
+    {
+        return Err("tnb_invalid_request");
+    }
+    let mut url = server_url(&request.server)?;
+    url.set_path("/gen");
+    {
+        let mut query = url.query_pairs_mut();
+        query
+            .append_pair("plan_name", &request.plan_name)
+            .append_pair("count", &request.count.to_string())
+            .append_pair("format", "txt")
+            .append_pair("split", "rn")
+            .append_pair("ttl", &request.ttl.to_string());
+        for (key, value) in [
+            ("geo", Some(request.geo.as_str())),
+            ("pool", request.pool.as_deref()),
+            ("isp", request.isp.as_deref()),
+            ("asn", request.asn.as_deref()),
+            ("ip", request.ip.as_deref()),
+            ("sid", request.sid.as_deref()),
+        ] {
+            if let Some(value) = value.map(str::trim).filter(|v| !v.is_empty()) {
+                if value.len() > 256 || value.chars().any(char::is_control) {
+                    return Err("tnb_invalid_request");
+                }
+                query.append_pair(key, value);
+            }
+        }
+        if request.pre {
+            query.append_pair("pre", "pre");
+        }
+    }
+    Ok(url)
+}
+
+fn server_url(raw: &str) -> Result<Url> {
+    if raw.len() > 2048 || raw.chars().any(char::is_control) {
+        return Err("tnb_invalid_request");
+    }
+    let url = Url::parse(raw.trim()).map_err(|_| "tnb_invalid_request")?;
+    if !matches!(url.scheme(), "http" | "https")
+        || url.host_str().is_none()
+        || !url.username().is_empty()
+        || url.password().is_some()
+        || url.query().is_some()
+        || url.fragment().is_some()
+        || !matches!(url.path(), "" | "/" | "/gen")
+        || url.port() == Some(0)
+    {
+        return Err("tnb_invalid_request");
+    }
+    Ok(url)
+}
+
+fn origin(url: &Url) -> String {
+    url.origin().ascii_serialization()
+}
+
+fn parse_response(body: &[u8], request: &ExtractRequest, server: &str) -> Result<Vec<ProxyEntry>> {
+    let body = std::str::from_utf8(body).map_err(|_| "tnb_invalid_response")?;
+    // TNB may return HTTP 200 with a JSON business error. Surface the
+    // allowlist/auth failure before treating the JSON as a proxy line.
+    if let Ok(value) =
+        serde_json::from_str::<serde_json::Value>(body.trim_start_matches('\u{feff}').trim())
+    {
+        if let Some(code) = value.get("code").and_then(serde_json::Value::as_i64) {
+            if code == 401 {
+                return Err("tnb_auth_required");
+            }
+            if code == 403 {
+                let detail = [value.get("msg"), value.get("message"), value.get("error")]
+                    .into_iter()
+                    .filter_map(|v| v.and_then(serde_json::Value::as_str))
+                    .collect::<Vec<_>>()
+                    .join(" ")
+                    .to_ascii_lowercase();
+                if is_whitelist_error(&detail) {
+                    return Err("tnb_whitelist_required");
+                }
+                return Err("tnb_auth_required");
+            }
+            if code != 0 {
+                return Err("tnb_invalid_response");
+            }
+        }
+    }
+    let kind = if request.kind == "http" {
+        ProxyKind::Http
+    } else {
+        ProxyKind::Socks5
+    };
+    let lines: Vec<&str> = body
+        .trim_start_matches('\u{feff}')
+        .lines()
+        .map(str::trim)
+        .filter(|l| !l.is_empty())
+        .collect();
+    if lines.is_empty() {
+        return Err("tnb_no_proxies");
+    }
+    if lines.len() > usize::from(request.count) {
+        return Err("tnb_invalid_response");
+    }
+    let mut entries = Vec::with_capacity(lines.len());
+    for line in lines {
+        let mut entry = parse_proxy_line(line, kind.clone(), &request.kind)?;
+        let provider_name = request
+            .provider_name
+            .as_deref()
+            .unwrap_or("")
+            .trim();
+        entry.name = format!(
+            "{} {}:{}",
+            if provider_name.is_empty() { "TNBProxy" } else { provider_name },
+            entry.host,
+            entry.port
+        );
+        entry.provider_id = "tnbproxy".into();
+        let geo_parts: Vec<&str> = request.geo.split('_').filter(|part| !part.is_empty()).collect();
+        entry.provider_options = std::collections::HashMap::from([
+            ("server".into(), server.into()),
+            ("plan_name".into(), request.plan_name.clone()),
+            ("country".into(), geo_parts.first().copied().unwrap_or_default().to_ascii_uppercase()),
+            ("state".into(), geo_parts.get(1).copied().unwrap_or_default().to_string()),
+            ("city".into(), geo_parts.get(2).copied().unwrap_or_default().to_string()),
+            ("session_type".into(), if request.ttl == 0 { "rotating" } else { "sticky" }.into()),
+            ("session_minutes".into(), request.ttl.to_string()),
+        ]);
+        if request.use_proxy_credentials && entry.username.is_empty() && entry.password.is_empty() {
+            let credentials = crate::proxy_providers::tnb_credentials(false)
+                .map_err(|_| "tnb_credentials_unavailable")?;
+            if credentials.username.is_empty() || credentials.password.is_empty() {
+                return Err("tnb_proxy_credentials_required");
+            }
+            entry.username = credentials.username;
+            entry.password = credentials.password;
+        }
+        // Reuses the durable notes field, which already survives edit/export/
+        // team sync. No change/clean URL is guessed and no management call runs.
+        entry.notes = format!(
+            "TNBProxy\n{}",
+            serde_json::json!({
+                "server": server, "plan_name": request.plan_name, "sid": request.sid,
+                "ttl": request.ttl, "route": request.route,
+            })
+        );
+        entries.push(entry);
+    }
+    Ok(entries)
+}
+
+pub(crate) fn parse_proxy_line(line: &str, kind: ProxyKind, expected_scheme: &str) -> Result<ProxyEntry> {
+    if line.len() > 4096
+        || line.contains('#')
+        || line.chars().any(|c| c.is_control() || c.is_whitespace())
+    {
+        return Err("tnb_invalid_response");
+    }
+    // The generic importer treats an unknown scheme as userinfo. Reject
+    // explicit protocol mismatches before it can turn socks4://u:p into
+    // an HTTP username/password; :// inside a raw password stays valid.
+    if let Some((scheme, _)) = line.split_once("://") {
+        if scheme
+            .as_bytes()
+            .first()
+            .is_some_and(|c| c.is_ascii_alphabetic())
+            && scheme
+                .bytes()
+                .all(|c| c.is_ascii_alphanumeric() || matches!(c, b'+' | b'-' | b'.'))
+            && scheme != expected_scheme
+        {
+            return Err("tnb_invalid_response");
+        }
+    }
+    let mut parsed = proxy::parse_bulk(line, kind.clone());
+    let Some(entry) = parsed.pop().filter(|_| parsed.is_empty()) else {
+        return Err("tnb_invalid_response");
+    };
+    // A provider error such as "error:403" is not a host. The extraction
+    // contract returns IPs or fully-qualified hosts, never prose/comments.
+    if entry.kind != kind
+        || entry.port == 0
+        || (!entry.host.contains('.') && !entry.host.contains(':'))
+        || Target::new(&entry.host, entry.port).is_err()
+        || entry.username.len() + entry.password.len() > 4096
+        || entry
+            .username
+            .chars()
+            .chain(entry.password.chars())
+            .any(char::is_control)
+    {
+        return Err("tnb_invalid_response");
+    }
+    Ok(entry)
+}
+
+fn request_error(error: reqwest::Error) -> &'static str {
+    if error.is_timeout() {
+        "tnb_timeout"
+    } else {
+        "tnb_request_failed"
+    }
+}
+
+fn is_whitelist_error(detail: &str) -> bool {
+    detail.contains("whitelist")
+        || detail.contains("allowlist")
+        || detail.contains("白名单")
+        || (detail
+            .split(|c: char| !c.is_ascii_alphanumeric())
+            .any(|word| word == "ip")
+            && (detail.contains("not in") || detail.contains("not allowed")))
+}
+
+fn remote_error_from_body(status: u16, body: &[u8]) -> Option<&'static str> {
+    if !matches!(status, 401 | 403) {
+        return None;
+    }
+    let detail = std::str::from_utf8(body).ok()?.to_ascii_lowercase();
+    if is_whitelist_error(&detail) {
+        Some("tnb_whitelist_required")
+    } else {
+        Some("tnb_auth_required")
+    }
+}
+
+async fn download(
+    client: reqwest::Client,
+    url: Url,
+    host: Option<String>,
+    json_body: Option<serde_json::Value>,
+    auth: Option<crate::proxy_providers::Credential>,
+) -> Result<Vec<u8>> {
+    let mut request = if let Some(body) = json_body {
+        client
+            .post(url)
+            .json(&body)
+            .header(reqwest::header::ACCEPT, "application/json")
+    } else {
+        client
+            .get(url)
+            .header(reqwest::header::ACCEPT, "text/plain")
+    };
+    if let Some(host) = host {
+        request = request.header(reqwest::header::HOST, host);
+    }
+    if let Some(auth) = auth {
+        request = request.basic_auth(auth.username, Some(auth.password));
+    }
+    let mut response = request.send().await.map_err(request_error)?;
+    let status = response.status().as_u16();
+    if matches!(status, 401 | 403) {
+        let mut body = Vec::new();
+        while let Some(chunk) = response.chunk().await.map_err(request_error)? {
+            if body.len().saturating_add(chunk.len()) > MAX_BODY {
+                return Err("tnb_response_too_large");
+            }
+            body.extend_from_slice(&chunk);
+        }
+        return Err(remote_error_from_body(status, &body).unwrap_or("tnb_auth_required"));
+    }
+    if !response.status().is_success() {
+        return Err("tnb_http_status");
+    }
+    if response
+        .content_length()
+        .is_some_and(|n| n > MAX_BODY as u64)
+    {
+        return Err("tnb_response_too_large");
+    }
+    let mut body = Vec::new();
+    while let Some(chunk) = response.chunk().await.map_err(request_error)? {
+        if body.len().saturating_add(chunk.len()) > MAX_BODY {
+            return Err("tnb_response_too_large");
+        }
+        body.extend_from_slice(&chunk);
+    }
+    Ok(body)
+}
+
+pub async fn extract(request: ExtractRequest) -> Result<Extraction> {
+    extract_with_timeout(request, TIMEOUT).await
+}
+
+async fn extract_with_timeout(request: ExtractRequest, timeout: Duration) -> Result<Extraction> {
+    let _slot = REQUESTS.try_acquire().map_err(|_| "tnb_busy")?;
+    let url = request_url(&request)?;
+    let server = origin(&url);
+    let auth = if request.use_api_credentials {
+        let c = crate::proxy_providers::tnb_credentials(true)
+            .map_err(|_| "tnb_credentials_unavailable")?;
+        if c.username.is_empty() || c.password.is_empty() {
+            return Err("tnb_api_credentials_required");
+        }
+        Some(c)
+    } else {
+        None
+    };
+    let body = fetch_on_route(url, request.route, None, timeout, auth).await?;
+    let entries = parse_response(&body, &request, &server)?;
+    Ok(Extraction {
+        entries,
+        route: request.route,
+        server,
+        requested_count: request.count,
+    })
+}
+
+pub(crate) async fn fetch_proxy_list(
+    url: Url,
+    auth: Option<crate::proxy_providers::Credential>,
+) -> Result<Vec<u8>> {
+    let _slot = REQUESTS.try_acquire().map_err(|_| "tnb_busy")?;
+    fetch_on_route(url, Route::Direct, None, TIMEOUT, auth).await
+}
+
+async fn fetch_on_route(
+    mut url: Url,
+    route: Route,
+    json_body: Option<serde_json::Value>,
+    timeout: Duration,
+    auth: Option<crate::proxy_providers::Credential>,
+) -> Result<Vec<u8>> {
+    let client = reqwest::Client::builder()
+        .no_proxy()
+        .redirect(reqwest::redirect::Policy::none())
+        .http1_only()
+        .pool_max_idle_per_host(0)
+        .connect_timeout(Duration::from_secs(8))
+        .timeout(timeout)
+        .build()
+        .map_err(|_| "tnb_request_failed")?;
+    let mut tunnel = None;
+    let fetched = tokio::time::timeout(timeout, async {
+        let mut host = None;
+        if matches!(route, Route::FirstHop) {
+            let target = Target::new(
+                url.host_str().ok_or("tnb_invalid_request")?,
+                url.port_or_known_default().ok_or("tnb_invalid_request")?,
+            )
+            .map_err(|_| "tnb_invalid_request")?;
+            let saved = crate::proxy_chain::saved_settings().map_err(|_| "tnb_route_failed")?;
+            let hop = saved
+                .proxy_chain
+                .hop_for(&saved.proxy_chain, &target)
+                .await
+                .map_err(|_| "tnb_route_failed")?;
+            // This transparent endpoint has one fixed destination. HTTPS is
+            // verified inside the tunnel against that original host, never
+            // against localhost and never with certificate checks disabled.
+            let bound = if url.scheme() == "https" {
+                let tls = crate::proxy_chain::tls::client().map_err(|_| "tnb_route_failed")?;
+                Tunnel::bind_tls(hop, target, tls).await
+            } else {
+                Tunnel::bind(hop, target).await
+            }
+            .map_err(|_| "tnb_route_failed")?;
+            host = Some(url[url::Position::BeforeHost..url::Position::AfterPort].to_owned());
+            url.set_scheme("http").map_err(|_| "tnb_invalid_request")?;
+            url.set_host(Some("127.0.0.1"))
+                .map_err(|_| "tnb_invalid_request")?;
+            url.set_port(Some(bound.addr().port()))
+                .map_err(|_| "tnb_invalid_request")?;
+            tunnel = Some(bound);
+        }
+        download(client, url, host, json_body, auth).await
+    })
+    .await
+    .map_err(|_| "tnb_timeout")
+    .and_then(|r| r);
+    if let Some(tunnel) = tunnel {
+        let failed = tunnel.last_error().is_some();
+        tunnel
+            .close_and_wait()
+            .await
+            .map_err(|_| "tnb_route_failed")?;
+        if failed && fetched.is_err() {
+            return Err("tnb_route_failed");
+        }
+    }
+    fetched
+}
