+    let tunnel = Tunnel::bind(hop(listener.local_addr().unwrap(), ProxyKind::Http), target()).await.unwrap();
+    let addr = tunnel.addr();
+    let mut probe = TcpStream::connect(addr).await.unwrap();
+    let (mut pending, _) = within(listener.accept()).await.unwrap();
+    assert!(within(http_head(&mut pending)).await.starts_with(b"CONNECT "));
+    assert_eq!(tunnel.active_connections(), 1);
+
+    within(tunnel.finish_probe_flows()).await.unwrap();
+    assert_eq!(tunnel.active_connections(), 0);
+    assert!(!*tunnel.closed_signal().borrow(), "probe cleanup must keep the listener alive");
+    closed(&mut probe).await;
+    closed(&mut pending).await;
+
+    let mut browser = TcpStream::connect(addr).await.unwrap();
+    let (mut first, _) = within(listener.accept()).await.unwrap();
+    within(http_head(&mut first)).await;
+    first.write_all(b"HTTP/1.1 200 Connected\r\n\r\n").await.unwrap();
+    browser.write_all(b"after-probe").await.unwrap();
+    let mut payload = [0; 11];
+    within(first.read_exact(&mut payload)).await.unwrap();
+    assert_eq!(&payload, b"after-probe");
+    first.write_all(&payload).await.unwrap();
+    within(browser.read_exact(&mut payload)).await.unwrap();
+    assert_eq!(&payload, b"after-probe");
+    assert_eq!(tunnel.active_connections(), 1);
+    tunnel.shutdown().await;
+}
+
+#[tokio::test]
+async fn a_shared_tunnel_is_fully_closed_before_close_and_wait_returns() {
+    let second = echo().await;
+    let first = http_forward(second.addr).await;
+    let tunnel = std::sync::Arc::new(
+        Tunnel::bind(hop(first.addr, ProxyKind::Http), target())
+            .await
+            .unwrap(),
+    );
+    let addr = tunnel.addr();
+    let completed = tunnel.closed_signal();
+    let mut browser = TcpStream::connect(addr).await.unwrap();
+    roundtrip(&mut browser, b"profile-is-still-running").await;
+    let tracker_copy = tunnel.clone();
+    within(tracker_copy.close_and_wait()).await.unwrap();
+    assert!(*completed.borrow());
+    assert_eq!(tunnel.active_connections(), 0);
+    closed(&mut browser).await;
+    // An exit path and a tracker monitor may both request closure.
+    within(tunnel.close_and_wait()).await.unwrap();
+}
+
+#[tokio::test]
+async fn a_greeting_timeout_keeps_its_type_under_the_probe_context() {
+    let first = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let tunnel = Tunnel::bind(hop(first.local_addr().unwrap(), ProxyKind::Http), target()).await.unwrap();
+    let elapsed=tokio::time::timeout(Duration::from_millis(1),std::future::pending::<()>()).await.unwrap_err();
+    let cause=anyhow::Error::new(elapsed).context("the proxy accepted the connection but never greeted us");
+    assert_eq!(super::profile_failure(&tunnel,&cause).code,"proxy_chain_profile_timeout");
+    tunnel.shutdown().await;
+}
diff --git a/src-tauri/src/proxy_chain/tls.rs b/src-tauri/src/proxy_chain/tls.rs
new file mode 100644
index 0000000..eee9e3c
--- /dev/null
+++ b/src-tauri/src/proxy_chain/tls.rs
@@ -0,0 +1,53 @@
+//! TLS to the original HTTPS proxy, inside the first-hop CONNECT stream.
+//! The loopback endpoint speaks HTTP; authentication stays inside verified TLS.
+use super::{
+    connector::{self, ProxyHop, Target},
+    error::ChainError,
+};
+use std::{sync::Arc, time::Duration};
+use tokio::net::TcpStream;
+use tokio_rustls::{client::TlsStream, TlsConnector};
+
+pub(crate) fn client() -> Result<Arc<rustls::ClientConfig>, ChainError> {
+    let roots = rustls::RootCertStore::from_iter(webpki_roots::TLS_SERVER_ROOTS.iter().cloned());
+    let mut config = rustls::ClientConfig::builder_with_provider(Arc::new(
+        rustls::crypto::ring::default_provider(),
+    ))
+    .with_safe_default_protocol_versions()
+    .map_err(|_| failed())?
+    .with_root_certificates(roots)
+    .with_no_client_auth();
+    // Browser/reqwest sends HTTP/1 CONNECT over our local HTTP endpoint.
+    config.alpn_protocols = vec![b"http/1.1".to_vec()];
+    Ok(Arc::new(config))
+}
+
+fn failed() -> ChainError {
+    ChainError::new("proxy_chain_profile_tls_failed", "profile", "TLS to the HTTPS profile proxy failed. Check that this port supports TLS and its certificate matches the original proxy host. No HTTP downgrade or certificate bypass was used.")
+}
+
+pub(crate) async fn connect(
+    hop: &ProxyHop,
+    target: &Target,
+    config: Arc<rustls::ClientConfig>,
+    deadline: Duration,
+) -> Result<TlsStream<connector::Stream>, ChainError> {
+    let name =
+        rustls::pki_types::ServerName::try_from(target.host.clone()).map_err(|_| failed())?;
+    tokio::time::timeout(deadline, async {
+        let raw = connector::connect_with_timeout(hop, target, deadline).await?;
+        TlsConnector::from(config).connect(name, raw).await.map_err(|_| failed())
+    }).await.map_err(|_| ChainError::new("proxy_chain_profile_tls_timeout", "profile", "TLS to the HTTPS profile proxy timed out. The connection was closed without a direct fallback."))?
+}
+
+pub(crate) async fn connect_assigned(
+    target: &Target,
+    config: Arc<rustls::ClientConfig>,
+    deadline: Duration,
+) -> Result<TlsStream<TcpStream>, ChainError> {
+    let name = rustls::pki_types::ServerName::try_from(target.host.clone()).map_err(|_| failed())?;
+    tokio::time::timeout(deadline, async {
+        let raw = connector::connect_assigned(target, deadline).await?;
+        TlsConnector::from(config).connect(name, raw).await.map_err(|_| failed())
+    }).await.map_err(|_| ChainError::new("proxy_chain_profile_tls_timeout", "profile", "TLS to the HTTPS profile proxy timed out. No HTTP downgrade or website direct connection was attempted."))?
+}
diff --git a/src-tauri/src/proxy_chain/tunnel.rs b/src-tauri/src/proxy_chain/tunnel.rs
new file mode 100644
index 0000000..fe495c5
--- /dev/null
+++ b/src-tauri/src/proxy_chain/tunnel.rs
@@ -0,0 +1,409 @@
+//! A per-profile transparent TCP entry. It never accepts a destination from
+//! the browser: every connection goes through the first hop to one target.
+
+use super::connector::{self, ProxyHop, Target};
+use super::error::ChainError;
+use std::net::{Ipv4Addr, SocketAddr};
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+use tokio::io::{AsyncRead, AsyncReadExt, AsyncWrite, AsyncWriteExt};
+use tokio::net::{TcpListener, TcpStream};
+use tokio::sync::{mpsc, oneshot, watch, OwnedSemaphorePermit, Semaphore};
+use tokio::task::{JoinHandle, JoinSet};
+use tokio::time::Instant;
+use std::{future::Future,pin::Pin};
+
+pub(super) type SystemResolver = Arc<dyn Fn(Target)->Pin<Box<dyn Future<Output=Result<super::detect_windows::ResolvedProxy,ChainError>>+Send>>+Send+Sync>;
+
+const MAX_CONNECTIONS: usize = 64;
+const IDLE_TIMEOUT: Duration = Duration::from_secs(300);
+
+pub struct Tunnel {
+    addr: SocketAddr,
+    stop: watch::Sender<bool>,
+    finished: watch::Receiver<bool>,
+    worker: Option<JoinHandle<()>>,
+    finish_probe: mpsc::Sender<oneshot::Sender<()>>,
+    active: Arc<AtomicUsize>,
+    error: Arc<Mutex<Option<ChainError>>>,
+}
+
+impl Tunnel {
+    pub async fn bind(hop: ProxyHop, target: Target) -> Result<Self, ChainError> {
+        Self::bind_with_limits(
+            hop,
+            target,
+            connector::CONNECT_TIMEOUT,
+            IDLE_TIMEOUT,
+            MAX_CONNECTIONS,
+        )
+        .await
+    }
+
+    pub(super) async fn bind_with_limits(
+        hop: ProxyHop,
+        target: Target,
+        connect_timeout: Duration,
+        idle_timeout: Duration,
+        max_connections: usize,
+    ) -> Result<Self, ChainError> {
+        Self::bind_transport(Some(hop), target, connect_timeout, idle_timeout, max_connections, None, None).await
+    }
+
+    pub(crate) async fn bind_tls(hop: ProxyHop, target: Target, tls: Arc<rustls::ClientConfig>) -> Result<Self, ChainError> {
+        Self::bind_transport(Some(hop), target, connector::CONNECT_TIMEOUT, IDLE_TIMEOUT, MAX_CONNECTIONS, Some(tls), None).await
+    }
+
+    pub(crate) async fn bind_assigned(target: Target, tls: Option<Arc<rustls::ClientConfig>>) -> Result<Self, ChainError> {
+        Self::bind_transport(None, target, connector::CONNECT_TIMEOUT, IDLE_TIMEOUT, MAX_CONNECTIONS, tls, None).await
+    }
+
+    /// A local SOCKS5 entry resolves the Windows proxy for each browser CONNECT
+    /// destination. PAC is never frozen using a different probe destination.
+    pub(crate) async fn bind_system() -> Result<Self, ChainError> {
+        let resolver:SystemResolver=Arc::new(|target|Box::pin(async move {super::detect_windows::resolve_for(&target).await}));
+        Self::bind_system_with_resolver(resolver).await
+    }
+
+    pub(super) async fn bind_system_with_resolver(resolver:SystemResolver) -> Result<Self,ChainError> {
+        Self::bind_transport(None,Target::new("example.com",443)?,connector::CONNECT_TIMEOUT,IDLE_TIMEOUT,MAX_CONNECTIONS,None,Some(resolver)).await
+    }
+
+    async fn bind_transport(hop: Option<ProxyHop>, target: Target, connect_timeout: Duration, idle_timeout: Duration, max_connections: usize, tls: Option<Arc<rustls::ClientConfig>>, system: Option<SystemResolver>) -> Result<Self, ChainError> {
+        if let Some(hop) = &hop { connector::validate(hop, &target)?; }
+        else { Target::new(&target.host, target.port)?; }
+        if max_connections == 0 || connect_timeout.is_zero() || idle_timeout.is_zero() {
+            return Err(ChainError::new(
+                "proxy_chain_invalid_config",
+                "configuration",
+                "Tunnel limits must be greater than zero.",
+            ));
+        }
+        let listener = TcpListener::bind((Ipv4Addr::LOCALHOST, 0))
+            .await
+            .map_err(|_| {
+                ChainError::new(
+                    "proxy_chain_listen_failed",
+                    "tunnel",
+                    "Could not open the local proxy-chain listener.",
+                )
+            })?;
+        let addr = listener.local_addr().map_err(|_| {
+            ChainError::new(
+                "proxy_chain_listen_failed",
+                "tunnel",
+                "Could not read the local proxy-chain listener address.",
+            )
+        })?;
+        let (stop, mut stopping) = watch::channel(false);
+        let (finished_tx, finished) = watch::channel(false);
+        let (finish_probe, mut probe_finished) = mpsc::channel::<oneshot::Sender<()>>(1);
+        let active = Arc::new(AtomicUsize::new(0));
+        let error = Arc::new(Mutex::new(None));
+        let worker = {
+            let active = active.clone();
+            let error = error.clone();
+            tokio::spawn(async move {
+                // Declared before the resources so an abort drops the
+                // listener/JoinSet before the completion notification.
+                let _finished = Finished(finished_tx);
+                let listener = listener;
+                let quota = Arc::new(Semaphore::new(max_connections));
+                let mut flows = JoinSet::new();
+                loop {
+                    tokio::select! {
+                        biased;
+                        _ = stopping.changed() => break,
+                        request = probe_finished.recv() => {
+                            let Some(ack) = request else { break };
+                            flows.abort_all();
+                            while flows.join_next().await.is_some() {}
+                            let _ = ack.send(());
+                        },
+                        _ = flows.join_next(), if !flows.is_empty() => {},
+                        accepted = listener.accept() => {
+                            let Ok((local, _)) = accepted else {
+                                *error.lock().unwrap_or_else(|e| e.into_inner()) = Some(ChainError::new(
+                                    "proxy_chain_accept_failed", "tunnel", "The local proxy-chain listener stopped accepting connections."
+                                ));
+                                break;
+                            };
+                            // Reserve before spawning: pending handshakes count too,
+                            // and an overloaded listener never creates unbounded tasks.
+                            let Ok(permit) = quota.clone().try_acquire_owned() else { continue };
+                            let slot = FlowSlot::new(permit, active.clone());
+                            let hop = hop.clone();
+                            let target = target.clone();
+                            let error = error.clone();
+                            let tls = tls.clone();
+                            let system = system.clone();
+                            flows.spawn(async move {
+                                let _slot = slot;
+                                let result = if let Some(resolver) = system {
+                                    match system_connect(local, connect_timeout,resolver,error.clone()).await {
+                                        Ok((local, remote)) => relay(local, remote, idle_timeout).await,
+                                        Err(_) => return, // system_connect publishes before closing local.
+                                    }
+                                } else {
+                                    // Keep local outside the dialing future: its EOF must
+                                    // never reach a probe before the typed route error.
+                                    let remote: Result<connector::Stream, ChainError> = async {
+                                        if let Some(tls) = tls {
+                                            if let Some(hop) = &hop { Ok(Box::new(super::tls::connect(hop, &target, tls, connect_timeout).await?) as connector::Stream) }
+                                            else { Ok(Box::new(super::tls::connect_assigned(&target, tls, connect_timeout).await?) as connector::Stream) }
+                                        } else if let Some(hop) = &hop {
+                                            connector::connect_with_timeout(hop, &target, connect_timeout).await
+                                        } else {
+                                            Ok(Box::new(connector::connect_assigned(&target, connect_timeout).await?) as connector::Stream)
+                                        }
+                                    }.await;
+                                    match remote {
+                                        Ok(remote) => relay(local, remote, idle_timeout).await,
+                                        Err(e) => {
+                                            *error.lock().unwrap_or_else(|e| e.into_inner()) = Some(e);
+                                            drop(local);
+                                            return;
+                                        }
+                                    }
+                                };
+                                if let Err(e) = result {
+                                    *error.lock().unwrap_or_else(|e| e.into_inner()) = Some(e);
+                                }
+                            });
+                        },
+                    }
+                }
+                // Drop the listener before waiting for cancelled flows, so no
+                // new connection can enter while shutdown is being completed.
+                drop(listener);
+                flows.abort_all();
+                while flows.join_next().await.is_some() {}
+            })
+        };
+        Ok(Self {
+            addr,
+            stop,
+            finished,
+            worker: Some(worker),
+            finish_probe,
+            active,
+            error,
+        })
+    }
+
+    pub fn addr(&self) -> SocketAddr {
+        self.addr
+    }
+
+    pub fn active_connections(&self) -> usize {
+        self.active.load(Ordering::Acquire)
+    }
+
+    pub fn last_error(&self) -> Option<ChainError> {
+        self.error.lock().unwrap_or_else(|e| e.into_inner()).clone()
+    }
+
+    /// Preparation owns all current flows. End its completed or cancelled
+    /// requests before the next check or the Engine takes this listener over.
+    pub(super) async fn finish_probe_flows(&self) -> Result<(), ChainError> {
+        let (ack, finished) = oneshot::channel();
+        self.finish_probe.send(ack).await.map_err(|_| cleanup_timeout())?;
+        finished.await.map_err(|_| cleanup_timeout())
+    }
+
+    #[cfg(test)]
+    pub(super) fn closed_signal(&self) -> watch::Receiver<bool> {
+        self.finished.clone()
+    }
+
+    /// Request shutdown without waiting. Safe in a synchronous Drop path.
+    pub fn close(&self) {
+        self.stop.send_replace(true);
+    }
+
+    /// Wait until both the listener and all flows have been released. The
+    /// tracker uses this before publishing the profile as stopped; merely
+    /// sending a cancellation would leave a short window with a live port.
+    pub async fn close_and_wait(&self) -> Result<(), ChainError> {
+        self.close();
+        if let Ok(result) = tokio::time::timeout(Duration::from_secs(2), self.wait_finished()).await
+        {
+            return result;
+        }
+        if let Some(worker) = &self.worker {
+            worker.abort();
+        }
+        tokio::time::timeout(Duration::from_secs(2), self.wait_finished())
+            .await
+            .map_err(|_| cleanup_timeout())?
+    }
+
+    async fn wait_finished(&self) -> Result<(), ChainError> {
+        let mut finished = self.finished.clone();
+        loop {
+            if *finished.borrow_and_update() {
+                if self.active_connections() == 0 {
+                    return Ok(());
+                }
+                // Aborting the owner drops its JoinSet; its flow cancellations
+                // still have to run and return their RAII reservations.
+                tokio::time::sleep(Duration::from_millis(5)).await;
+            } else if finished.changed().await.is_err() {
+                return Err(cleanup_timeout());
+            }
+        }
+    }
+
+    /// Ends listening and all established or pending connections before returning.
+    pub async fn shutdown(mut self) {
+        let _ = self.close_and_wait().await;
+        if let Some(mut worker) = self.worker.take() {
+            if tokio::time::timeout(Duration::from_secs(2), &mut worker)
+                .await
+                .is_err()
+            {
+                worker.abort();
+                let _ = worker.await;
+            }
+        }
+    }
+}
+
+pub(super) async fn system_connect(mut local: TcpStream, budget: Duration,resolver:SystemResolver,last_error:Arc<Mutex<Option<ChainError>>>) -> Result<(TcpStream, connector::Stream), ChainError> {
+    let work = async {
+        let failed = || ChainError::new("proxy_chain_local_protocol_failed", "tunnel", "The local system-route SOCKS5 request was invalid or unsupported.");
+        if local.read_u8().await.map_err(|_| failed())? != 5 { return Err(failed()); }
+        let count = local.read_u8().await.map_err(|_| failed())? as usize;
+        if count == 0 { return Err(failed()); }
+        let mut methods=vec![0;count]; local.read_exact(&mut methods).await.map_err(|_| failed())?;
+        if !methods.contains(&0) { let _=local.write_all(&[5,255]).await; return Err(failed()); }
+        local.write_all(&[5,0]).await.map_err(|_| failed())?;
+        let mut head=[0;4]; local.read_exact(&mut head).await.map_err(|_| failed())?;
+        if head[0] != 5 || head[2] != 0 { return Err(failed()); }
+        let host=match head[3] {
+            1 => { let mut v=[0;4]; local.read_exact(&mut v).await.map_err(|_| failed())?; std::net::Ipv4Addr::from(v).to_string() },
+            4 => { let mut v=[0;16]; local.read_exact(&mut v).await.map_err(|_| failed())?; std::net::Ipv6Addr::from(v).to_string() },
+            3 => { let size=local.read_u8().await.map_err(|_| failed())? as usize; if size==0{return Err(failed());} let mut v=vec![0;size];local.read_exact(&mut v).await.map_err(|_| failed())?;String::from_utf8(v).map_err(|_|failed())? },
+            _ => return Err(failed()),
+        };
+        let port=local.read_u16().await.map_err(|_|failed())?;
+        if head[1] != 1 {let _=local.write_all(&[5,7,0,1,0,0,0,0,0,0]).await;return Err(failed());}
+        let target=Target::new(host,port)?;
+        let remote=async { let resolved=resolver(target.clone()).await?; connector::connect_with_timeout(&resolved.hop,&target,budget).await }.await;
+        match remote {
+            Ok(remote) => { local.write_all(&[5,0,0,1,0,0,0,0,0,0]).await.map_err(|_|failed())?; Ok(remote) },
+            Err(error) => { *last_error.lock().unwrap_or_else(|e|e.into_inner())=Some(error.clone());let _=local.write_all(&[5,1,0,1,0,0,0,0,0,0]).await; Err(error) },
+        }
+    };
+    let result = tokio::time::timeout(budget,work).await
+        .map_err(|_|ChainError::new("system_proxy_timeout","system_proxy","The system proxy did not finish resolving or connecting in time."))
+        .and_then(|result| result);
+    match result {
+        Ok(remote) => Ok((local, remote)),
+        Err(error) => {
+            *last_error.lock().unwrap_or_else(|e|e.into_inner())=Some(error.clone());
+            Err(error)
+        }
+    }
+}
+
+fn cleanup_timeout() -> ChainError {
+    ChainError::new(
+        "proxy_chain_cleanup_timeout",
+        "tunnel",
+        "The proxy-chain tunnel has not confirmed that all local connections are closed.",
+    )
+}
+
+struct Finished(watch::Sender<bool>);
+impl Drop for Finished {
+    fn drop(&mut self) {
+        self.0.send_replace(true);
+    }
+}
+
+impl Drop for Tunnel {
+    fn drop(&mut self) {
+        self.close();
+        // Dropping a JoinHandle detaches its task. Keep cancellation explicit:
+        // aborting the owner also drops its JoinSet and aborts every flow.
+        if let Some(worker) = self.worker.take() {
+            worker.abort();
+        }
+    }
+}
+
+struct FlowSlot {
+    _permit: OwnedSemaphorePermit,
+    active: Arc<AtomicUsize>,
+}
+
+impl FlowSlot {
+    fn new(permit: OwnedSemaphorePermit, active: Arc<AtomicUsize>) -> Self {
+        active.fetch_add(1, Ordering::AcqRel);
+        Self {
+            _permit: permit,
+            active,
+        }
+    }
+}
+
+impl Drop for FlowSlot {
+    fn drop(&mut self) {
+        self.active.fetch_sub(1, Ordering::AcqRel);
+    }
+}
+
+async fn relay<S: AsyncRead + AsyncWrite + Unpin>(local: TcpStream, remote: S, idle: Duration) -> Result<(), ChainError> {
+    let last = Arc::new(Mutex::new(Instant::now()));
+    let (lr, lw) = local.into_split();
+    let (rr, rw) = tokio::io::split(remote);
+    let transfer = async {
+        tokio::try_join!(pump(lr, rw, last.clone()), pump(rr, lw, last.clone()))?;
+        Ok(())
+    };
+    tokio::select! {
+        result = transfer => result,
+        _ = idle_expired(last.clone(), idle) => Err(ChainError::new("proxy_chain_idle_timeout", "tunnel", "The proxy-chain connection closed after being idle.")),
+    }
+}
+
+async fn pump<R, W>(
+    mut reader: R,
+    mut writer: W,
+    last: Arc<Mutex<Instant>>,
+) -> Result<(), ChainError>
+where
+    R: AsyncRead + Unpin,
+    W: AsyncWrite + Unpin,
+{
+    let failed = || {
+        ChainError::new(
+            "proxy_chain_stream_closed",
+            "tunnel",
+            "The proxy-chain connection was interrupted.",
+        )
+    };
+    let mut buf = [0u8; 16 * 1024];
+    loop {
+        let n = reader.read(&mut buf).await.map_err(|_| failed())?;
+        if n == 0 {
+            writer.shutdown().await.map_err(|_| failed())?;
+            return Ok(());
+        }
+        *last.lock().unwrap_or_else(|e| e.into_inner()) = Instant::now();
+        writer.write_all(&buf[..n]).await.map_err(|_| failed())?;
+        *last.lock().unwrap_or_else(|e| e.into_inner()) = Instant::now();
+    }
+}
+
+async fn idle_expired(last: Arc<Mutex<Instant>>, idle: Duration) {
+    loop {
+        let until = *last.lock().unwrap_or_else(|e| e.into_inner()) + idle;
+        tokio::time::sleep_until(until).await;
+        if last.lock().unwrap_or_else(|e| e.into_inner()).elapsed() >= idle {
+            return;
+        }
+    }
+}
diff --git a/src-tauri/src/proxy_providers.rs b/src-tauri/src/proxy_providers.rs
new file mode 100644
index 0000000..9a7cddc
--- /dev/null
+++ b/src-tauri/src/proxy_providers.rs
@@ -0,0 +1,396 @@
+//! Provider configuration is local to this Windows account. Credential pairs
+//! are protected with DPAPI; view responses never include saved passwords.
+use crate::{
+    proxy_chain::credentials,
+    space::proxy::{ProxyEntry, ProxyKind},
+    store,
+};
+use anyhow::{anyhow, Result};
+use serde::{Deserialize, Serialize};
+use std::{collections::HashMap, fs, sync::Mutex};
+static WRITE: Mutex<()> = Mutex::new(());
+#[derive(Default, Serialize, Deserialize)]
+pub struct Credential {
+    pub username: String,
+    pub password: String,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(default)]
+struct Stored {
+    relay: String,
+    username_template: String,
+    tnb_server: String,
+    tnb_plan: String,
+    tnb_kind: String,
+    account: Option<String>,
+    tnb_api: Option<String>,
+    tnb_proxy: Option<String>,
+}
+impl Default for Stored {
+    fn default() -> Self {
+        Self {
+            relay: "us.1024proxy.io:3000".into(),
+            username_template: "{username}{location}".into(),
+            tnb_server: "http://usdata.adv.tnbproxy.com:9090".into(),
+            tnb_plan: "advanced_traffic".into(),
+            tnb_kind: "http".into(),
+            account: None,
+            tnb_api: None,
+            tnb_proxy: None,
+        }
+    }
+}
+#[derive(Serialize)]
+pub struct ProviderView {
+    pub relay: String,
+    pub username: String,
+    pub username_template: String,
+    pub password_saved: bool,
+    pub tnb_server: String,
+    pub tnb_plan: String,
+    pub tnb_kind: String,
+    pub tnb_api_username: String,
+    pub tnb_api_password_saved: bool,
+    pub tnb_proxy_username: String,
+    pub tnb_proxy_password_saved: bool,
+}
+#[derive(Deserialize)]
+pub struct ProviderUpdate {
+    pub relay: String,
+    pub username: String,
+    pub username_template: String,
+    pub password: Option<String>,
+    pub tnb_server: String,
+    pub tnb_plan: String,
+    pub tnb_kind: String,
+    #[serde(default)]
+    pub tnb_api_username: String,
+    pub tnb_api_password: Option<String>,
+    #[serde(default)]
+    pub tnb_proxy_username: String,
+    pub tnb_proxy_password: Option<String>,
+}
+fn path() -> Result<std::path::PathBuf> {
+    Ok(store::config_root()?.join("proxy-provider-defaults.json"))
+}
+fn load() -> Result<Stored> {
+    let path = path()?;
+    if !path.exists() {
+        return Ok(Stored::default());
+    }
+    serde_json::from_slice(&fs::read(path)?).map_err(|_| anyhow!("provider_defaults_unreadable"))
+}
+fn decode(raw: Option<&str>) -> Result<Credential> {
+    match raw {
+        None => Ok(Credential::default()),
+        Some(raw) => {
+            let text = credentials::unprotect(raw)
+                .map_err(|_| anyhow!("provider_credentials_unavailable"))?;
+            serde_json::from_str(&text).map_err(|_| anyhow!("provider_credentials_unavailable"))
+        }
+    }
+}
+fn view(v: Stored) -> Result<ProviderView> {
+    let a = decode(v.account.as_deref())?;
+    let api = decode(v.tnb_api.as_deref())?;
+    let proxy = decode(v.tnb_proxy.as_deref())?;
+    Ok(ProviderView {
+        relay: v.relay,
+        username: a.username,
+        username_template: v.username_template,
+        password_saved: !a.password.is_empty(),
+        tnb_server: v.tnb_server,
+        tnb_plan: v.tnb_plan,
+        tnb_kind: v.tnb_kind,
+        tnb_api_username: api.username,
+        tnb_api_password_saved: !api.password.is_empty(),
+        tnb_proxy_username: proxy.username,
+        tnb_proxy_password_saved: !proxy.password.is_empty(),
+    })
+}
+pub fn get() -> Result<ProviderView> {
+    view(load()?)
+}
+fn valid_text(raw: &str, max: usize) -> bool {
+    raw.len() <= max && !raw.chars().any(char::is_control)
+}
+fn relay(raw: &str) -> Result<(String, u16)> {
+    let u = url::Url::parse(&format!("socks5://{}", raw.trim()))
+        .map_err(|_| anyhow!("provider_invalid_relay"))?;
+    if !u.username().is_empty()
+        || u.password().is_some()
+        || u.query().is_some()
+        || u.fragment().is_some()
+        || !matches!(u.path(), "" | "/")
+    {
+        return Err(anyhow!("provider_invalid_relay"));
+    }
+    Ok((
+        u.host_str()
+            .ok_or_else(|| anyhow!("provider_invalid_relay"))?
+            .to_owned(),
+        u.port().ok_or_else(|| anyhow!("provider_invalid_relay"))?,
+    ))
+}
+fn seal(username: String, password: Option<String>, old: Option<&str>) -> Result<Option<String>> {
+    if !valid_text(&username, 1024) {
+        return Err(anyhow!("provider_defaults_invalid"));
+    }
+    let password = match password {
+        Some(p) => p,
+        None => decode(old)?.password,
+    };
+    if !valid_text(&password, 4096) {
+        return Err(anyhow!("provider_defaults_invalid"));
+    }
+    if username.is_empty() && password.is_empty() {
+        return Ok(None);
+    }
+    let text = serde_json::to_string(&Credential { username, password })?;
+    Ok(Some(credentials::protect(&text).map_err(|_| {
+        anyhow!("provider_credentials_unavailable")
+    })?))
+}
+pub fn save(v: ProviderUpdate) -> Result<ProviderView> {
+    let _guard = WRITE
+        .lock()
+        .map_err(|_| anyhow!("provider_defaults_busy"))?;
+    relay(&v.relay)?;
+    if !valid_text(&v.username_template, 2048)
+        || !v.username_template.contains("{username}")
+        || !matches!(v.tnb_kind.as_str(), "http" | "socks5")
+    {
+        return Err(anyhow!("provider_defaults_invalid"));
+    }
+    let rest = v
+        .username_template
+        .replace("{username}", "")
+        .replace("{country}", "")
+        .replace("{state}", "")
+        .replace("{location}", "");
+    if rest.contains('{') || rest.contains('}') {
+        return Err(anyhow!("provider_defaults_invalid"));
+    }
+    let url =
+        url::Url::parse(v.tnb_server.trim()).map_err(|_| anyhow!("provider_defaults_invalid"))?;
+    if !matches!(url.scheme(), "http" | "https")
+        || url.host_str().is_none()
+        || !url.username().is_empty()
+        || url.password().is_some()
+        || url.query().is_some()
+        || url.fragment().is_some()
+        || !matches!(url.path(), "" | "/" | "/gen")
+        || v.tnb_plan.is_empty()
+        || v.tnb_plan.len() > 64
+        || !v
+            .tnb_plan
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'-'))
+    {
+        return Err(anyhow!("provider_defaults_invalid"));
+    }
+    let old = load()?;
+    let saved = Stored {
+        relay: v.relay.trim().into(),
+        username_template: v.username_template,
+        tnb_server: v.tnb_server.trim().into(),
+        tnb_plan: v.tnb_plan,
+        tnb_kind: v.tnb_kind,
+        account: seal(v.username, v.password, old.account.as_deref())?,
+        tnb_api: seal(
+            v.tnb_api_username,
+            v.tnb_api_password,
+            old.tnb_api.as_deref(),
+        )?,
+        tnb_proxy: seal(
+            v.tnb_proxy_username,
+            v.tnb_proxy_password,
+            old.tnb_proxy.as_deref(),
+        )?,
+    };
+    // Only ciphertext enters the temporary file; preserve the old file on errors.
+    let target = path()?;
+    let tmp = target.with_extension("pending");
+    fs::write(&tmp, serde_json::to_vec_pretty(&saved)?)?;
+    replace_file(&tmp, &target)?;
+    view(saved)
+}
+
+#[cfg(not(windows))]
+fn replace_file(tmp: &std::path::Path, target: &std::path::Path) -> Result<()> {
+    fs::rename(tmp, target)?;
+    Ok(())
+}
+
+#[cfg(windows)]
+fn replace_file(tmp: &std::path::Path, target: &std::path::Path) -> Result<()> {
+    use std::os::windows::ffi::OsStrExt;
+    use windows_sys::Win32::Storage::FileSystem::{MoveFileExW, MOVEFILE_REPLACE_EXISTING, MOVEFILE_WRITE_THROUGH};
+    let from: Vec<u16> = tmp.as_os_str().encode_wide().chain(std::iter::once(0)).collect();
+    let to: Vec<u16> = target.as_os_str().encode_wide().chain(std::iter::once(0)).collect();
+    let ok = unsafe { MoveFileExW(from.as_ptr(), to.as_ptr(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) };
+    if ok == 0 {
+        let error = std::io::Error::last_os_error();
+        let _ = fs::remove_file(tmp);
+        return Err(error.into());
+    }
+    Ok(())
+}
+/// Separate authentication domains. Neither is inferred from the other.
+pub fn tnb_credentials(api: bool) -> Result<Credential> {
+    let v = load()?;
+    decode(if api {
+        v.tnb_api.as_deref()
+    } else {
+        v.tnb_proxy.as_deref()
+    })
+}
+#[derive(Deserialize)]
+pub struct GenerateRequest {
+    #[serde(default)]
+    pub country: String,
+    #[serde(default)]
+    pub state: String,
+}
+pub fn generate(v: GenerateRequest) -> Result<ProxyEntry> {
+    let c = load()?;
+    let account = decode(c.account.as_deref())?;
+    if account.username.is_empty() || account.password.is_empty() {
+        return Err(anyhow!("provider_credentials_required"));
+    }
+    for value in [&v.country, &v.state] {
+        if value.len() > 128
+            || !value
+                .chars()
+                .all(|c| c.is_ascii_alphanumeric() || matches!(c, '_' | '-' | ' '))
+        {
+            return Err(anyhow!("provider_region_invalid"));
+        }
+    }
+    if (!v.country.is_empty()
+        && !c.username_template.contains("{country}")
+        && !c.username_template.contains("{location}"))
+        || (!v.state.is_empty()
+            && !c.username_template.contains("{state}")
+            && !c.username_template.contains("{location}"))
+    {
+        return Err(anyhow!("provider_region_template_required"));
+    }
+    if (!v.country.is_empty()
+        && (v.country.len() != 2 || !v.country.bytes().all(|b| b.is_ascii_alphabetic())))
+        || (!v.state.is_empty() && v.country.is_empty())
+    {
+        return Err(anyhow!("provider_region_invalid"));
+    }
+    let location = if v.country.is_empty() {
+        String::new()
+    } else {
+        format!(
+            "-region-{}{}",
+            v.country.to_ascii_uppercase(),
+            if v.state.is_empty() {
+                String::new()
+            } else {
+                format!("-st-{}", v.state)
+            }
+        )
+    };
+    let (host, port) = relay(&c.relay)?;
+    let username = c
+        .username_template
+        .replace("{username}", &account.username)
+        .replace("{country}", &v.country.to_ascii_lowercase())
+        .replace("{state}", &v.state)
+        .replace("{location}", &location);
+    Ok(ProxyEntry {
+        id: uuid::Uuid::new_v4().to_string(),
+        name: format!(
+            "1024Proxy {}",
+            if v.country.is_empty() {
+                "Global"
+            } else {
+                &v.country
+            }
+        ),
+        kind: ProxyKind::Socks5,
+        host,
+        port,
+        username,
+        password: account.password,
+        provider_id: "1024proxy".into(),
+        credential_ref: String::new(),
+        provider_options: HashMap::from([
+            ("country".into(), v.country.clone()),
+            ("state".into(), v.state),
+        ]),
+        capabilities: crate::space::proxy::ProxyCapabilities {
+            socks5: true,
+            ..Default::default()
+        },
+        country: v.country.to_ascii_uppercase(),
+        notes: String::new(),
+        proxy_chain_policy: Default::default(),
+    })
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn provider_defaults_are_non_secret_and_tnb_use_us() {
+        let v = view(Stored::default()).unwrap();
+        assert_eq!(v.tnb_server, "http://usdata.adv.tnbproxy.com:9090");
+        let json = serde_json::to_value(v).unwrap();
+        assert!(json.get("account").is_none());
+        assert_eq!(json["password_saved"], false);
+    }
+    #[test]
+    fn relay_rejects_credentials_and_missing_port() {
+        assert!(relay("u:p@example.com:3000").is_err());
+        assert!(relay("example.com").is_err());
+        assert_eq!(
+            relay("us.1024proxy.io:3000").unwrap(),
+            ("us.1024proxy.io".into(), 3000)
+        );
+    }
+    #[cfg(windows)]
+    #[test]
+    fn provider_defaults_encrypt_separate_credentials_and_restore_after_edit() {
+        let _root = store::test_root("provider-defaults");
+        let update = |password| ProviderUpdate {
+            relay: "us.1024proxy.io:3000".into(),
+            username: "synthetic-user".into(),
+            username_template: "{username}-country-{country}".into(),
+            password,
+            tnb_server: "http://usdata.adv.tnbproxy.com:9090".into(),
+            tnb_plan: "advanced_traffic".into(),
+            tnb_kind: "socks5".into(),
+            tnb_api_username: "extract-user".into(),
+            tnb_api_password: Some("extract-secret".into()),
+            tnb_proxy_username: "exit-user".into(),
+            tnb_proxy_password: Some("exit-secret".into()),
+        };
+        save(update(Some("provider-secret".into()))).unwrap();
+        let body = fs::read_to_string(path().unwrap()).unwrap();
+        for s in [
+            "provider-secret",
+            "synthetic-user",
+            "extract-secret",
+            "exit-secret",
+        ] {
+            assert!(!body.contains(s));
+        }
+        assert!(save(update(None)).unwrap().password_saved);
+        let e = generate(GenerateRequest {
+            country: "EG".into(),
+            state: String::new(),
+        })
+        .unwrap();
+        assert_eq!(e.username, "synthetic-user-country-eg");
+        assert_eq!(e.password, "provider-secret");
+        assert_eq!(tnb_credentials(true).unwrap().username, "extract-user");
+        assert_eq!(tnb_credentials(false).unwrap().username, "exit-user");
+        assert!(!serde_json::to_string(&get().unwrap())
+            .unwrap()
+            .contains("secret"));
+    }
+}
