+use super::{
+    connector::{self, ProxyHop, ProxyKind, Target},
+    credentials, detect_windows,
+    error::ChainError,
+};
+use serde::{Deserialize, Deserializer, Serialize};
+use std::fmt;
+
+/// Missing means keep, null means clear. Only a newly entered string is sent.
+#[derive(Clone, Default)]
+pub enum PasswordUpdate {
+    #[default]
+    Keep,
+    Clear,
+    Replace(String),
+}
+impl PasswordUpdate {
+    fn keep(&self) -> bool {
+        matches!(self, Self::Keep)
+    }
+}
+impl fmt::Debug for PasswordUpdate {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("[redacted]")
+    }
+}
+impl<'de> Deserialize<'de> for PasswordUpdate {
+    fn deserialize<D: Deserializer<'de>>(d: D) -> Result<Self, D::Error> {
+        Ok(match Option::<String>::deserialize(d)? {
+            Some(s) if !s.is_empty() => Self::Replace(s),
+            _ => Self::Clear,
+        })
+    }
+}
+impl Serialize for PasswordUpdate {
+    fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
+        // Write-only IPC input. Neither persistence nor a response may reveal it.
+        s.serialize_none()
+    }
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(default)]
+pub struct ProxyChainSettings {
+    pub enabled: bool,
+    pub mode: String,
+    pub host: String,
+    pub port: u16,
+    pub username: String,
+    pub password_saved: bool,
+    #[serde(skip_serializing_if = "PasswordUpdate::keep")]
+    pub password: PasswordUpdate,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub protected_password: Option<String>,
+    /// Preserves a malformed chain as an error instead of defaulting to direct.
+    #[serde(skip_serializing_if = "std::ops::Not::not")]
+    pub invalid: bool,
+}
+impl Default for ProxyChainSettings {
+    fn default() -> Self {
+        Self {
+            enabled: false,
+            mode: "auto".into(),
+            host: "127.0.0.1".into(),
+            port: 7890,
+            username: String::new(),
+            password_saved: false,
+            password: PasswordUpdate::Keep,
+            protected_password: None,
+            invalid: false,
+        }
+    }
+}
+impl fmt::Debug for ProxyChainSettings {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("ProxyChainSettings")
+            .field("enabled", &self.enabled)
+            .field("mode", &self.mode)
+            .field("invalid", &self.invalid)
+            .finish_non_exhaustive()
+    }
+}
+
+pub fn deserialize<'de, D: Deserializer<'de>>(d: D) -> Result<ProxyChainSettings, D::Error> {
+    let value = serde_json::Value::deserialize(d)?;
+    Ok(
+        serde_json::from_value(value.clone()).unwrap_or_else(|_| ProxyChainSettings {
+            enabled: value
+                .get("enabled")
+                .and_then(|v| v.as_bool())
+                .unwrap_or(true),
+            invalid: true,
+            ..Default::default()
+        }),
+    )
+}
+
+impl ProxyChainSettings {
+    pub fn public(&self) -> Self {
+        Self {
+            password_saved: self.protected_password.is_some(),
+            protected_password: None,
+            password: PasswordUpdate::Keep,
+            ..self.clone()
+        }
+    }
+    pub fn apply_update(&mut self, saved: &Self) -> Result<(), ChainError> {
+        // The client never owns stored ciphertext or password_saved.
+        self.protected_password = match std::mem::take(&mut self.password) {
+            PasswordUpdate::Keep => saved.protected_password.clone(),
+            PasswordUpdate::Clear => None,
+            PasswordUpdate::Replace(p) => Some(credentials::protect(&p)?),
+        };
+        self.password_saved = self.protected_password.is_some();
+        if self.enabled {
+            self.validate()?;
+        }
+        Ok(())
+    }
+    pub fn validate(&self) -> Result<(), ChainError> {
+        if self.invalid || !matches!(self.mode.as_str(), "auto" | "http" | "socks5") {
+            return Err(ChainError::new(
+                "proxy_chain_invalid_config",
+                "configuration",
+                "The proxy-chain settings are invalid. Configure the system proxy before starting.",
+            ));
+        }
+        if self.mode != "auto" {
+            let hop = ProxyHop {
+                kind: if self.mode == "http" {
+                    ProxyKind::Http
+                } else {
+                    ProxyKind::Socks5
+                },
+                host: self.host.clone(),
+                port: self.port,
+                username: self.username.clone(),
+                password: String::new(),
+            };
+            connector::validate(&hop, &Target::new("example.com", 443)?)?;
+        }
+        Ok(())
+    }
+    pub fn hop(&self, saved: &Self) -> Result<ProxyHop, ChainError> {
+        self.validate()?;
+        if self.mode == "auto" {
+            return detect_windows::resolve();
+        }
+        let password = match &self.password {
+            PasswordUpdate::Replace(p) => p.clone(),
+            PasswordUpdate::Clear => String::new(),
+            PasswordUpdate::Keep => saved
+                .protected_password
+                .as_deref()
+                .map(credentials::unprotect)
+                .transpose()?
+                .unwrap_or_default(),
+        };
+        let hop = ProxyHop {
+            kind: if self.mode == "http" {
+                ProxyKind::Http
+            } else {
+                ProxyKind::Socks5
+            },
+            host: self.host.clone(),
+            port: self.port,
+            username: self.username.clone(),
+            password,
+        };
+        connector::validate(&hop, &Target::new("example.com", 443)?)?;
+        Ok(hop)
+    }
+
+    pub async fn resolve_for(
+        &self,
+        saved: &Self,
+        target: &Target,
+    ) -> Result<detect_windows::ResolvedProxy, ChainError> {
+        self.validate()?;
+        if self.mode == "auto" {
+            detect_windows::resolve_for(target).await
+        } else {
+            Ok(detect_windows::ResolvedProxy::manual(self.hop(saved)?))
+        }
+    }
+
+    pub async fn hop_for(&self, saved: &Self, target: &Target) -> Result<ProxyHop, ChainError> {
+        self.resolve_for(saved, target)
+            .await
+            .map(|resolved| resolved.hop)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[derive(Deserialize)]
+    struct Old {
+        #[serde(default, deserialize_with = "deserialize")]
+        proxy_chain: ProxyChainSettings,
+    }
+    #[test]
+    fn old_settings_default_off_but_malformed_enabled_stays_closed() {
+        assert!(
+            !serde_json::from_str::<Old>("{}")
+                .unwrap()
+                .proxy_chain
+                .enabled
+        );
+        let s = serde_json::from_str::<Old>(r#"{"proxy_chain":{"enabled":true,"port":"bad"}}"#)
+            .unwrap();
+        assert!(s.proxy_chain.enabled && s.proxy_chain.validate().is_err());
+        assert!(
+            serde_json::from_str::<Old>(r#"{"proxy_chain":null}"#)
+                .unwrap()
+                .proxy_chain
+                .enabled
+        );
+    }
+    #[test]
+    fn missing_and_null_password_are_distinct_and_public_is_redacted() {
+        let a: ProxyChainSettings = serde_json::from_str("{}").unwrap();
+        let b: ProxyChainSettings = serde_json::from_str(r#"{"password":null}"#).unwrap();
+        assert!(matches!(a.password, PasswordUpdate::Keep));
+        assert!(matches!(b.password, PasswordUpdate::Clear));
+        let s = ProxyChainSettings {
+            password: PasswordUpdate::Replace("synthetic-secret".into()),
+            protected_password: Some("synthetic-cipher".into()),
+            ..a
+        };
+        let public = serde_json::to_string(&s.public()).unwrap();
+        assert!(!public.contains("synthetic"));
+        assert!(!format!("{s:?}").contains("synthetic"));
+    }
+}
diff --git a/src-tauri/src/proxy_chain/connector.rs b/src-tauri/src/proxy_chain/connector.rs
new file mode 100644
index 0000000000000000000000000000000000000000..592e755dedaa570de0036666fbe1d2d8e419a88f
--- /dev/null
+++ b/src-tauri/src/proxy_chain/connector.rs
@@ -0,0 +1,380 @@
+//! Connect to one fixed destination through the system proxy. There is no
+//! direct fallback, and only the system proxy's own name is resolved here.
+
+use super::error::ChainError;
+use base64::{engine::general_purpose::STANDARD, Engine as _};
+use std::fmt;
+use std::net::IpAddr;
+use std::time::Duration;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::TcpStream;
+
+pub const CONNECT_TIMEOUT: Duration = Duration::from_secs(12);
+const MAX_HTTP_HEAD: usize = 16 * 1024;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ProxyKind {
+    Http,
+    Socks5,
+}
+
+#[derive(Clone)]
+pub struct ProxyHop {
+    pub kind: ProxyKind,
+    pub host: String,
+    pub port: u16,
+    pub username: String,
+    pub password: String,
+}
+
+impl fmt::Debug for ProxyHop {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("ProxyHop")
+            .field("kind", &self.kind)
+            .field("port", &self.port)
+            .field("credentials", &"[redacted]")
+            .finish_non_exhaustive()
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Target {
+    pub host: String,
+    pub port: u16,
+}
+
+impl Target {
+    pub fn new(host: impl Into<String>, port: u16) -> Result<Self, ChainError> {
+        Ok(Self {
+            host: normal_host(&host.into())?,
+            port: valid_port(port)?,
+        })
+    }
+
+    fn authority(&self) -> String {
+        if self.host.parse::<std::net::Ipv6Addr>().is_ok() {
+            format!("[{}]:{}", self.host, self.port)
+        } else {
+            format!("{}:{}", self.host, self.port)
+        }
+    }
+}
+
+fn bad_config(message: &'static str) -> ChainError {
+    ChainError::new("proxy_chain_invalid_config", "configuration", message)
+}
+
+fn valid_port(port: u16) -> Result<u16, ChainError> {
+    if port == 0 {
+        Err(bad_config("A proxy port must be between 1 and 65535."))
+    } else {
+        Ok(port)
+    }
+}
+
+/// Accept an IP or an IDNA hostname, not a URL, authority or command fragment.
+fn normal_host(host: &str) -> Result<String, ChainError> {
+    if host.is_empty() || host.chars().any(|c| c.is_control() || c.is_whitespace()) {
+        return Err(bad_config(
+            "A proxy host must be an IP address or hostname.",
+        ));
+    }
+    let ip = host
+        .strip_prefix('[')
+        .and_then(|s| s.strip_suffix(']'))
+        .unwrap_or(host);
+    if let Ok(ip) = ip.parse::<IpAddr>() {
+        return Ok(ip.to_string());
+    }
+    if host.chars().any(|c| ":/\\@?#%;[]=,".contains(c)) {
+        return Err(bad_config(
+            "Enter the proxy host separately from its port and credentials.",
+        ));
+    }
+    match url::Host::parse(host) {
+        Ok(url::Host::Domain(name)) if !name.is_empty() && name.len() <= 253 => Ok(name),
+        _ => Err(bad_config(
+            "A proxy host must be an IP address or hostname.",
+        )),
+    }
+}
+
+pub fn validate(hop: &ProxyHop, target: &Target) -> Result<(), ChainError> {
+    normal_host(&hop.host)?;
+    normal_host(&target.host)?;
+    valid_port(hop.port)?;
+    valid_port(target.port)?;
+    if hop
+        .username
+        .chars()
+        .chain(hop.password.chars())
+        .any(char::is_control)
+    {
+        return Err(bad_config(
+            "Proxy credentials cannot contain control characters.",
+        ));
+    }
+    if hop.username.len().saturating_add(hop.password.len()) > 4096 {
+        return Err(bad_config(
+            "Proxy credentials cannot exceed 4096 bytes in total.",
+        ));
+    }
+    if hop.kind == ProxyKind::Http && hop.username.contains(':') {
+        return Err(bad_config("An HTTP Basic username cannot contain a colon."));
+    }
+    if hop.kind == ProxyKind::Socks5 {
+        let credentials = !hop.username.is_empty() || !hop.password.is_empty();
+        if credentials
+            && (hop.username.is_empty() || hop.username.len() > 255 || hop.password.len() > 255)
+        {
+            return Err(bad_config(
+                "SOCKS5 credentials require a username and at most 255 bytes per field.",
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn io_error() -> ChainError {
+    ChainError::new(
+        "system_proxy_io_failed",
+        "system_proxy",
+        "The system proxy closed or interrupted the connection.",
+    )
+}
+
+fn protocol_error(message: &'static str) -> ChainError {
+    ChainError::new("system_proxy_protocol_error", "system_proxy", message)
+}
+
+pub async fn connect(hop: &ProxyHop, target: &Target) -> Result<TcpStream, ChainError> {
+    connect_with_timeout(hop, target, CONNECT_TIMEOUT).await
+}
+
+pub(super) async fn connect_with_timeout(
+    hop: &ProxyHop,
+    target: &Target,
+    budget: Duration,
+) -> Result<TcpStream, ChainError> {
+    validate(hop, target)?;
+    let host = normal_host(&hop.host)?;
+    let target = Target::new(target.host.clone(), target.port)?;
+    tokio::time::timeout(budget, async {
+        let mut stream = TcpStream::connect((host.as_str(), hop.port))
+            .await
+            .map_err(|_| {
+                ChainError::new(
+                    "system_proxy_connect_failed",
+                    "system_proxy",
+                    "Could not connect to the system proxy.",
+                )
+            })?;
+        let _ = stream.set_nodelay(true);
+        match hop.kind {
+            ProxyKind::Http => http_connect(&mut stream, hop, &target).await?,
+            ProxyKind::Socks5 => socks_connect(&mut stream, hop, &target).await?,
+        }
+        Ok(stream)
+    })
+    .await
+    .map_err(|_| {
+        ChainError::new(
+            "system_proxy_timeout",
+            "system_proxy",
+            "The system proxy did not finish connecting in time.",
+        )
+    })?
+}
+
+async fn http_connect(
+    stream: &mut TcpStream,
+    hop: &ProxyHop,
+    target: &Target,
+) -> Result<(), ChainError> {
+    let authority = target.authority();
+    let mut request = format!("CONNECT {authority} HTTP/1.1\r\nHost: {authority}\r\n");
+    if !hop.username.is_empty() || !hop.password.is_empty() {
+        let encoded = STANDARD.encode(format!("{}:{}", hop.username, hop.password));
+        request.push_str(&format!("Proxy-Authorization: Basic {encoded}\r\n"));
+    }
+    request.push_str("\r\n");
+    stream
+        .write_all(request.as_bytes())
+        .await
+        .map_err(|_| io_error())?;
+
+    // Read exactly the header: CONNECT's reply may share a TCP packet with
+    // the second proxy's greeting. Returning a raw TcpStream must lose none
+    // of those bytes, so a buffered read that overreads is not sufficient.
+    let mut head = Vec::with_capacity(512);
+    loop {
+        let mut byte = [0u8; 1];
+        stream.read_exact(&mut byte).await.map_err(|_| io_error())?;
+        head.push(byte[0]);
+        if head.ends_with(b"\r\n\r\n") {
+            break;
+        }
+        if head.len() >= MAX_HTTP_HEAD {
+            return Err(protocol_error(
+                "The system proxy returned an oversized HTTP header.",
+            ));
+        }
+    }
+    let mut headers = [httparse::EMPTY_HEADER; 64];
+    let mut response = httparse::Response::new(&mut headers);
+    if !matches!(response.parse(&head), Ok(httparse::Status::Complete(_)))
+        || !matches!(response.version, Some(0 | 1))
+    {
+        return Err(protocol_error(
+            "The system proxy returned an invalid HTTP CONNECT response.",
+        ));
+    }
+    match response.code {
+        Some(200) => Ok(()),
+        Some(407) => Err(ChainError::new(
+            "system_proxy_auth_failed",
+            "system_proxy",
+            "The system proxy rejected or requires authentication.",
+        )),
+        Some(status) => Err(ChainError::new(
+            "system_proxy_connect_refused",
+            "system_proxy",
+            format!("The system proxy refused CONNECT (HTTP {status})."),
+        )),
+        None => Err(protocol_error(
+            "The system proxy returned no HTTP CONNECT status.",
+        )),
+    }
+}
+
+async fn socks_connect(
+    stream: &mut TcpStream,
+    hop: &ProxyHop,
+    target: &Target,
+) -> Result<(), ChainError> {
+    let credentials = !hop.username.is_empty() || !hop.password.is_empty();
+    let greeting: &[u8] = if credentials {
+        &[5, 2, 0, 2]
+    } else {
+        &[5, 1, 0]
+    };
+    stream.write_all(greeting).await.map_err(|_| io_error())?;
+    let mut answer = [0u8; 2];
+    stream
+        .read_exact(&mut answer)
+        .await
+        .map_err(|_| io_error())?;
+    if answer[0] != 5 {
+        return Err(protocol_error("The system proxy did not answer as SOCKS5."));
+    }
+    match answer[1] {
+        0 => {}
+        2 if credentials => {
+            let mut auth = Vec::with_capacity(hop.username.len() + hop.password.len() + 3);
+            auth.extend_from_slice(&[1, hop.username.len() as u8]);
+            auth.extend_from_slice(hop.username.as_bytes());
+            auth.push(hop.password.len() as u8);
+            auth.extend_from_slice(hop.password.as_bytes());
+            stream.write_all(&auth).await.map_err(|_| io_error())?;
+            stream
+                .read_exact(&mut answer)
+                .await
+                .map_err(|_| io_error())?;
+            if answer[0] != 1 {
+                return Err(protocol_error(
+                    "The system proxy returned an invalid SOCKS5 authentication response.",
+                ));
+            }
+            if answer[1] != 0 {
+                return Err(ChainError::new(
+                    "system_proxy_auth_failed",
+                    "system_proxy",
+                    "The system proxy rejected the username or password.",
+                ));
+            }
+        }
+        2 | 255 => {
+            return Err(ChainError::new(
+                "system_proxy_auth_failed",
+                "system_proxy",
+                "The system proxy requires valid SOCKS5 credentials.",
+            ))
+        }
+        _ => {
+            return Err(protocol_error(
+                "The system proxy selected an unsupported SOCKS5 authentication method.",
+            ))
+        }
+    }
+
+    let mut request = vec![5, 1, 0];
+    match target.host.parse::<IpAddr>() {
+        Ok(IpAddr::V4(ip)) => {
+            request.push(1);
+            request.extend_from_slice(&ip.octets());
+        }
+        Ok(IpAddr::V6(ip)) => {
+            request.push(4);
+            request.extend_from_slice(&ip.octets());
+        }
+        Err(_) => {
+            request.extend_from_slice(&[3, target.host.len() as u8]);
+            request.extend_from_slice(target.host.as_bytes());
+        }
+    }
+    request.extend_from_slice(&target.port.to_be_bytes());
+    stream.write_all(&request).await.map_err(|_| io_error())?;
+
+    let mut header = [0u8; 4];
+    stream
+        .read_exact(&mut header)
+        .await
+        .map_err(|_| io_error())?;
+    if header[0] != 5 || header[2] != 0 {
+        return Err(protocol_error(
+            "The system proxy returned an invalid SOCKS5 CONNECT response.",
+        ));
+    }
+    if header[1] != 0 {
+        let reason = match header[1] {
+            1 => "general failure",
+            2 => "not allowed by its ruleset",
+            3 => "network unreachable",
+            4 => "host unreachable",
+            5 => "connection refused",
+            6 => "TTL expired",
+            7 => "CONNECT not supported",
+            8 => "address type not supported",
+            _ => "unknown reply code",
+        };
+        return Err(ChainError::new(
+            "system_proxy_connect_refused",
+            "system_proxy",
+            format!(
+                "The system proxy refused SOCKS5 CONNECT: {reason} (code {}).",
+                header[1]
+            ),
+        ));
+    }
+    let remaining = match header[3] {
+        1 => 6,
+        4 => 18,
+        3 => {
+            let n = stream.read_u8().await.map_err(|_| io_error())? as usize;
+            if n == 0 {
+                return Err(protocol_error(
+                    "The system proxy returned an empty SOCKS5 bound address.",
+                ));
+            }
+            n + 2
+        }
+        _ => {
+            return Err(protocol_error(
+                "The system proxy returned an unsupported SOCKS5 bound address.",
+            ))
+        }
+    };
+    let mut rest = vec![0u8; remaining];
+    stream.read_exact(&mut rest).await.map_err(|_| io_error())?;
+    Ok(())
+}
diff --git a/src-tauri/src/proxy_chain/credentials.rs b/src-tauri/src/proxy_chain/credentials.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2619470c5c1259edf095f746eec47db5ea73ef4c
--- /dev/null
+++ b/src-tauri/src/proxy_chain/credentials.rs
@@ -0,0 +1,81 @@
+//! Current-user DPAPI for the first hop only. Never return stored secrets to UI.
+use super::error::ChainError;
+use base64::{engine::general_purpose::STANDARD, Engine as _};
+
+fn failure() -> ChainError {
+    ChainError::new("proxy_chain_credentials_unavailable", "configuration", "System proxy credentials could not be protected or read for this Windows account. Enter them again.")
+}
+
+#[cfg(windows)]
+fn crypt(input: &[u8], protect: bool) -> Result<Vec<u8>, ChainError> {
+    use windows_sys::Win32::{
+        Foundation::LocalFree,
+        Security::Cryptography::{
+            CryptProtectData, CryptUnprotectData, CRYPTPROTECT_UI_FORBIDDEN, CRYPT_INTEGER_BLOB,
+        },
+    };
+    let input = CRYPT_INTEGER_BLOB {
+        cbData: input.len().try_into().map_err(|_| failure())?,
+        pbData: input.as_ptr() as *mut u8,
+    };
+    let mut output = CRYPT_INTEGER_BLOB {
+        cbData: 0,
+        pbData: std::ptr::null_mut(),
+    };
+    // SAFETY: input is live for the call; DPAPI owns output until LocalFree.
+    unsafe {
+        let ok = if protect {
+            CryptProtectData(
+                &input,
+                std::ptr::null(),
+                std::ptr::null(),
+                std::ptr::null(),
+                std::ptr::null(),
+                CRYPTPROTECT_UI_FORBIDDEN,
+                &mut output,
+            )
+        } else {
+            CryptUnprotectData(
+                &input,
+                std::ptr::null_mut(),
+                std::ptr::null(),
+                std::ptr::null(),
+                std::ptr::null(),
+                CRYPTPROTECT_UI_FORBIDDEN,
+                &mut output,
+            )
+        };
+        if ok == 0 {
+            return Err(failure());
+        }
+        let bytes = std::slice::from_raw_parts(output.pbData, output.cbData as usize).to_vec();
+        LocalFree(output.pbData as _);
+        Ok(bytes)
+    }
+}
+
+#[cfg(not(windows))]
+fn crypt(_: &[u8], _: bool) -> Result<Vec<u8>, ChainError> {
+    Err(failure())
+}
+
+pub fn protect(password: &str) -> Result<String, ChainError> {
+    crypt(password.as_bytes(), true).map(|b| STANDARD.encode(b))
+}
+
+pub fn unprotect(encoded: &str) -> Result<String, ChainError> {
+    let bytes = STANDARD.decode(encoded).map_err(|_| failure())?;
+    String::from_utf8(crypt(&bytes, false)?).map_err(|_| failure())
+}
+
+#[cfg(all(test, windows))]
+mod tests {
+    #[test]
+    fn current_user_round_trip_and_invalid_ciphertext() {
+        let value = "synthetic-first-hop-only";
+        let sealed = super::protect(value).unwrap();
+        assert!(!sealed.contains(value));
+        assert_eq!(super::unprotect(&sealed).unwrap(), value);
+        assert!(super::unprotect("invalid").is_err());
+    }
+}
diff --git a/src-tauri/src/proxy_chain/detect_windows.rs b/src-tauri/src/proxy_chain/detect_windows.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b53e5b910df49df61865567902df08b9ae864f10
--- /dev/null
+++ b/src-tauri/src/proxy_chain/detect_windows.rs
@@ -0,0 +1,345 @@
+use super::{
+    connector::{ProxyHop, ProxyKind, Target},
+    error::ChainError,
+};
+use serde::Serialize;
+
+#[derive(Serialize)]
+pub struct Detection {
+    pub state: &'static str,
+    pub source: &'static str,
+    pub kind: Option<&'static str>,
+    pub host: Option<String>,
+    pub port: Option<u16>,
+    pub has_bypass: bool,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub resolved_for: Option<String>,
+    pub error_code: Option<&'static str>,
+    pub error_message: Option<String>,
+}
+fn manual() -> ChainError {
+    ChainError::new("proxy_chain_manual_required", "configuration", "Windows returned an ambiguous static proxy mapping. Select manual HTTP or SOCKS5 configuration.")
+}
+
+fn parse(raw: &str) -> Result<ProxyHop, ChainError> {
+    if raw.trim().is_empty() {
+        return Err(ChainError::new(
+            "proxy_chain_system_not_configured",
+            "configuration",
+            "No static system proxy is configured. Select a manual proxy.",
+        ));
+    }
+    let mut candidates = Vec::new();
+    for item in raw.split(';').map(str::trim).filter(|s| !s.is_empty()) {
+        let value = if let Some((scheme, value)) = item.split_once('=') {
+            if !matches!(
+                scheme.trim().to_ascii_lowercase().as_str(),
+                "http" | "https"
+            ) {
+                return Err(manual());
+            }
+            value.trim()
+        } else {
+            item
+        };
+        let url = if value.contains("://") {
+            value.to_string()
+        } else {
+            format!("http://{value}")
+        };
+        let parsed = url::Url::parse(&url).map_err(|_| manual())?;
+        if !parsed.username().is_empty()
+            || parsed.password().is_some()
+            || parsed.path() != "/"
+            || parsed.query().is_some()
+            || parsed.fragment().is_some()
+        {
+            return Err(manual());
+        }
+        let kind = match parsed.scheme() {
+            "http" => ProxyKind::Http,
+            "socks5" => ProxyKind::Socks5,
+            _ => return Err(manual()),
+        };
+        let target = Target::new(
+            parsed.host_str().ok_or_else(manual)?,
+            parsed
+                .port_or_known_default()
+                .unwrap_or(if kind == ProxyKind::Socks5 { 1080 } else { 80 }),
+        )?;
+        let candidate = (kind, target.host, target.port);
+        if !candidates.contains(&candidate) {
+            candidates.push(candidate);
+        }
+    }
+    if candidates.len() != 1 {
+        return Err(manual());
+    }
+    let (kind, host, port) = candidates.pop().unwrap();
+    Ok(ProxyHop {
+        kind,
+        host,
+        port,
+        username: String::new(),
+        password: String::new(),
+    })
+}
+
+// Do not derive Debug: a PAC URL can contain a private query token.
+struct SystemSettings {
+    static_proxy: String,
+    pac_url: String,
+    auto_detect: bool,
+    has_bypass: bool,
+}
+
+pub struct ResolvedProxy {
+    pub hop: ProxyHop,
+    pub source: &'static str,
+    pub resolved_for: Option<String>,
+    pub has_bypass: bool,
+}
+
+impl ResolvedProxy {
+    pub fn manual(hop: ProxyHop) -> Self {
+        Self {
+            hop,
+            source: "manual",
+            resolved_for: None,
+            has_bypass: false,
+        }
+    }
+}
+
+fn auto_error(code: &'static str, message: &'static str) -> ChainError {
+    ChainError::new(code, "configuration", message)
+}
+
+fn authority(target: &Target) -> String {
+    if target.host.parse::<std::net::Ipv6Addr>().is_ok() {
+        format!("[{}]:{}", target.host, target.port)
+    } else {
+        format!("{}:{}", target.host, target.port)
+    }
+}
+
+impl SystemSettings {
+    fn static_proxy(&self) -> Result<Option<ResolvedProxy>, ChainError> {
+        // WinHTTP only returns lpszProxy when the user's static proxy is enabled.
+        // This feature selects an explicit first hop (as AdsPower does), rather
+        // than silently allowing PAC/bypass rules to turn that hop into DIRECT.
+        if !self.static_proxy.trim().is_empty() {
+            return Ok(Some(ResolvedProxy {
+                hop: parse(&self.static_proxy)?,
+                source: "windows_current_user_internet_settings",
+                resolved_for: None,
+                has_bypass: self.has_bypass,
+            }));
+        }
+        if self.pac_url.is_empty() && !self.auto_detect {
+            return Err(auto_error(
+                "proxy_chain_system_not_configured",
+                "No system proxy is configured. Enable a system proxy or select a manual proxy.",
+            ));
+        }
+        Ok(None)
+    }
+}
+
+#[cfg(windows)]
+fn current() -> Result<SystemSettings, ChainError> {
+    use windows_sys::Win32::{
+        Foundation::GlobalFree,
+        Networking::WinHttp::{
+            WinHttpGetIEProxyConfigForCurrentUser, WINHTTP_CURRENT_USER_IE_PROXY_CONFIG,
+        },
+    };
+    unsafe fn text(p: *mut u16) -> String {
+        if p.is_null() {
+            return String::new();
+        }
+        let mut len = 0;
+        while len < 32768 && unsafe { *p.add(len) } != 0 {
+            len += 1;
+        }
+        String::from_utf16_lossy(unsafe { std::slice::from_raw_parts(p, len) })
+    }
+    // SAFETY: API initializes the struct. Its strings are copied, then freed.
+    unsafe {
+        let mut config: WINHTTP_CURRENT_USER_IE_PROXY_CONFIG = std::mem::zeroed();
+        if WinHttpGetIEProxyConfigForCurrentUser(&mut config) == 0 {
+            return Err(ChainError::new(
+                "proxy_chain_system_detect_failed",
+                "configuration",
+                "Windows system proxy settings could not be read. Select a manual proxy.",
+            ));
+        }
+        let settings = SystemSettings {
+            static_proxy: text(config.lpszProxy),
+            has_bypass: !text(config.lpszProxyBypass).is_empty(),
+            pac_url: text(config.lpszAutoConfigUrl),
+            auto_detect: config.fAutoDetect != 0,
+        };
+        for p in [
+            config.lpszProxy,
+            config.lpszProxyBypass,
+            config.lpszAutoConfigUrl,
+        ] {
+            if !p.is_null() {
+                GlobalFree(p as _);
+            }
+        }
+        Ok(settings)
+    }
+}
+#[cfg(not(windows))]
+fn current() -> Result<SystemSettings, ChainError> {
+    Err(ChainError::new(
+        "proxy_chain_windows_required",
+        "configuration",
+        "System proxy chaining is available on Windows only.",
+    ))
+}
+
+pub fn resolve() -> Result<ProxyHop, ChainError> {
+    current()?
+        .static_proxy()?
+        .map(|resolved| resolved.hop)
+        .ok_or_else(|| {
+            auto_error(
+        "proxy_chain_auto_target_required",
+        "Windows uses automatic proxy configuration. Select a profile to resolve its proxy route.",
+    )
+        })
+}
+
+/// Resolve exactly the second proxy's CONNECT destination, not a website whose
+/// PAC route might differ. The result stays fixed for this test or Session.
+pub async fn resolve_for(target: &Target) -> Result<ResolvedProxy, ChainError> {
+    let settings = current()?;
+    if let Some(resolved) = settings.static_proxy()? {
+        return Ok(resolved);
+    }
+    #[cfg(windows)]
+    {
+        pac::resolve(settings, target).await
+    }
+    #[cfg(not(windows))]
+    {
+        let _ = target;
+        unreachable!("current returns a Windows-only error on this platform")
+    }
+}
+
+fn detection(result: Result<ResolvedProxy, ChainError>, target: Option<&Target>) -> Detection {
+    match result {
+        Ok(ResolvedProxy {
+            hop,
+            source,
+            resolved_for,
+            has_bypass,
+        }) => Detection {
+            state: "ok",
+            source,
+            kind: Some(if hop.kind == ProxyKind::Http {
+                "http"
+            } else {
+                "socks5"
+            }),
+            host: Some(hop.host),
+            port: Some(hop.port),
+            has_bypass,
+            resolved_for,
+            error_code: None,
+            error_message: None,
+        },
+        Err(e) => Detection {
+            state: if e.code == "proxy_chain_manual_required" {
+                "manual_required"
+            } else {
+                "failed"
+            },
+            source: "windows_current_user_internet_settings",
+            kind: None,
+            host: None,
+            port: None,
+            has_bypass: false,
+            resolved_for: target.map(authority),
+            error_code: Some(e.code),
+            error_message: Some(e.message),
+        },
+    }
+}
+
+pub fn detect() -> Detection {
+    detection(
+        current().and_then(|settings| {
+            settings.static_proxy()?.ok_or_else(|| {
+                auto_error(
+        "proxy_chain_auto_target_required",
+        "Windows uses automatic proxy configuration. Select a profile to resolve its proxy route.",
+    )
+            })
+        }),
+        None,
+    )
+}
+
+pub async fn detect_for(target: &Target) -> Detection {
+    detection(resolve_for(target).await, Some(target))
+}
+
+#[cfg(windows)]
+#[path = "auto_windows.rs"]
+mod pac;
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn static_mapping_is_http_but_ambiguous_socks_and_mappings_are_refused() {
+        let a = super::parse("http=127.0.0.1:7890;https=127.0.0.1:7890").unwrap();
+        assert_eq!(a.kind, super::ProxyKind::Http);
+        assert_eq!(a.port, 7890);
+        assert!(super::parse("socks=127.0.0.1:7890").is_err());
+        assert!(super::parse("http=one:80;https=two:80").is_err());
+    }
+
+    #[test]
+    fn enabled_static_proxy_is_not_blocked_by_pac_or_wpad() {
+        let settings = super::SystemSettings {
+            static_proxy: "127.0.0.1:7890".into(),
+            pac_url: "https://pac.invalid/private-token".into(),
+            auto_detect: true,
+            has_bypass: true,
+        };
+        let resolved = settings.static_proxy().unwrap().unwrap();
+        assert_eq!(resolved.hop.host, "127.0.0.1");
+        assert_eq!(resolved.hop.port, 7890);
+        assert_eq!(resolved.source, "windows_current_user_internet_settings");
+        assert!(resolved.has_bypass);
+        let dto = serde_json::to_string(&super::detection(Ok(resolved), None)).unwrap();
+        assert!(!dto.contains("private-token"));
+    }
+
+    #[test]
+    fn absent_static_configuration_requires_target_resolution_or_fails_closed() {
+        let mut settings = super::SystemSettings {
+            static_proxy: String::new(),
+            pac_url: String::new(),
+            auto_detect: true,
+            has_bypass: false,
+        };
+        assert!(settings.static_proxy().unwrap().is_none());
+        settings.auto_detect = false;
+        assert_eq!(
+            settings.static_proxy().err().unwrap().code,
+            "proxy_chain_system_not_configured"
+        );
+        settings.static_proxy = "http=one:80;https=two:80".into();
+        settings.pac_url = "https://pac.invalid/".into();
+        assert_eq!(
+            settings.static_proxy().err().unwrap().code,
+            "proxy_chain_manual_required"
+        );
+    }
+}
