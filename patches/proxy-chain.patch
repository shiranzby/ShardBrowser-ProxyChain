+    validate_field_consistency(&payload)?;
+    let digest = payload_sha256(&payload);
+    if list_all()?
+        .into_iter()
+        .any(|entry| entry.id != id && (entry.payload_sha256 == digest || entry.payload == payload))
+    {
+        anyhow::bail!("fingerprint already exists");
+    }
